---
// Mockup · Option A — landing page. One statement, three doors.
import Layout from "../../../mockups/a/Layout.astro";
import { limitStats, statesChecked, usd } from "../../../lib/stats";
const b = "/mockups/a";
---
<Layout title="Small claims court, explained" current="home">
  <section class="wrap land-hero">
    <p class="lbl land-kicker">
      <span>Fair Claim</span><span class="kick-sep" aria-hidden="true"></span><span>Small claims court, explained</span>
    </p>
    <h1 class="display-xl land-title">
      Small claims court is where people settle smaller money disputes, <span class="soft">usually without a lawyer.</span>
    </h1>
    <div class="land-meta">
      <p class="land-note">
        The most you can ask for runs from <strong>{usd(limitStats.min)}</strong> to <strong>{usd(limitStats.max)}</strong>,
        depending on the state. Here's how it works, what it costs, and what happens after a judgment.
      </p>
      <p class="lbl">50 states + DC · checked {statesChecked}</p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="doors-title">
    <h2 id="doors-title" class="sr-only">Where to start</h2>
    <div class="doors">
      <a class="door tile fill c-verm" href={`${b}/how-it-works/`}>
        <span class="door-top">
          <span class="key" aria-hidden="true">A</span>
          <span class="door-idx">01</span>
        </span>
        <span class="door-body">
          <span class="door-title">Learn how it works</span>
          <span class="door-text">Five steps from a written request to collecting, and the other routes to try first.</span>
        </span>
        <span class="door-foot"><span>Steps · Before you decide</span><span class="door-arrow" aria-hidden="true">→</span></span>
      </a>
      <a class="door tile fill c-blue" href={`${b}/state/`}>
        <span class="door-top">
          <span class="key" aria-hidden="true">B</span>
          <span class="door-idx">02</span>
        </span>
        <span class="door-body">
          <span class="door-title">Look up your state's rules</span>
          <span class="door-text">Limits, fees, serving the papers and appeals, each with its source and the date we checked it.</span>
        </span>
        <span class="door-foot"><span>51 states · 58 CA counties</span><span class="door-arrow" aria-hidden="true">→</span></span>
      </a>
      <a class="door tile fill c-violet" href={`${b}/calculator/`}>
        <span class="door-top">
          <span class="key" aria-hidden="true">C</span>
          <span class="door-idx">03</span>
        </span>
        <span class="door-body">
          <span class="door-title">Use a tool</span>
          <span class="door-text">A cost calculator, a demand-letter writer and printable checklists. Nothing you type is stored.</span>
        </span>
        <span class="door-foot"><span>Calculator · Letter · Checklists</span><span class="door-arrow" aria-hidden="true">→</span></span>
      </a>
    </div>

    <div class="land-strip">
      <p><span class="dot c-lime" aria-hidden="true"></span>Free. No ads, no accounts, no tracking.</p>
      <p><span class="dot c-amber" aria-hidden="true"></span>Neutral. It won't talk you into suing, or out of it.</p>
      <p><span class="dot c-blue" aria-hidden="true"></span>Legal information, not legal advice.</p>
    </div>
  </section>
</Layout>

<style>
  .land-hero { padding-top: clamp(72px, 11vw, 168px); padding-bottom: clamp(56px, 6vw, 96px); }
  .land-kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 40px; }
  .kick-sep { width: 28px; height: 1px; background: var(--line-2); }
  .land-title { max-width: 17.5ch; }
  .land-title .soft { color: var(--ink-3); }
  .land-meta {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: end;
    margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line);
  }
  .land-note { font-size: 20px; line-height: 1.55; color: var(--ink-2); max-width: 52ch; }
  .land-note strong { color: var(--ink); font-weight: 500; }

  .doors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .door { min-height: 460px; padding: 22px 24px 22px; gap: 40px; }
  .door-top { display: flex; justify-content: space-between; align-items: center; }
  .door-idx { font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.06em; }
  .door-body { display: flex; flex-direction: column; gap: 18px; margin-top: auto; }
  .door-title { font-family: var(--f-display); font-size: clamp(34px, 3.2vw, 50px); line-height: 1.02; letter-spacing: -0.035em; max-width: 11ch; }
  .door-text { font-size: 17px; line-height: 1.5; max-width: 34ch; }
  .door-foot {
    display: flex; justify-content: space-between; align-items: center; padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--on) 30%, transparent);
    font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .door-arrow { font-family: var(--f-body); font-size: 20px; transition: transform var(--t-med) var(--ease); }
  .door:hover .door-arrow { transform: translateX(6px); }

  .land-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); margin-top: 40px; }
  .land-strip p { display: flex; align-items: center; gap: 12px; font-size: 16px; color: var(--ink-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--t); flex: none; }

  @media (max-width: 960px) {
    .doors, .land-strip { grid-template-columns: 1fr; }
    .door { min-height: 300px; }
    .land-meta { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .land-kicker > span:not(:last-child) { display: none; }
    .door { min-height: 260px; }
    .land-strip { gap: 12px; }
  }
</style>
