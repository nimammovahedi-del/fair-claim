---
import Layout from "../../../../mockups/b/Layout.astro";
import { buildDemandLetter, formatMoney } from "../../../../lib/core/demand-letter";
import { formatLongDate } from "../../../../lib/core/deadlines";
import { letterNotes } from "../../../../lib/letter-notes";

const notes = letterNotes.ca;
const letter = buildDemandLetter({
  kind: "security_deposit",
  sender: { name: "Jordan Lee", addressLines: ["1450 Alder Street, Apt. 3", "Oakland, CA 94612"], email: "jordan.lee@example.com" },
  recipient: { name: "Sample Property Co.", addressLines: ["220 Harbor Way, Suite 400", "Oakland, CA 94607"] },
  letterDate: "2026-11-06",
  amount: 1850,
  subjectDetail: "1450 Alder Street, Apt. 3, Oakland",
  eventDate: "2026-09-30",
  facts:
    "I returned the keys and gave you my forwarding address on the day I moved out. More than 21 days have passed, and I have not received my deposit or an itemized statement of deductions.",
  responseDays: 14,
  paymentMethods: "check mailed to the address above",
  courtPhrase: "small claims court in Alameda County",
  legalNotes: [notes[0].text],
  offerToDiscuss: true,
  mentionCourt: true,
});

const kinds = [
  { k: "A", t: "A security deposit", on: true },
  { k: "B", t: "A refund from a business" },
  { k: "C", t: "An unpaid invoice" },
  { k: "D", t: "Damage to my property" },
  { k: "E", t: "Something else" },
];
const steps = ["About", "Who", "Amount", "State law", "Court"];
const notice = [
  "This is general legal information, not legal advice. It can't tell you what to do in your own case.",
  "Nothing you type is stored or sent anywhere. It stays in this browser tab and is gone when you close it.",
  "Keep it calm and factual. Threats of criminal charges or public shaming can be illegal, and they hurt you in court.",
  "Before you act, you can check with the court's self-help center, a free small claims advisor, or legal aid.",
];
---
<Layout title="Demand letter" active="tools">
  <section class="wrap hero lt-hero">
    <div class="hero-meta">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a href="/mockups/b/" data-keep-theme>Fair Claim</a><span aria-hidden="true">/</span>
        <span>Tools</span><span aria-hidden="true">/</span>
        <span aria-current="page" class="label-strong">Demand letter</span>
      </nav>
    </div>
    <div class="hero-grid">
      <h1 class="xl h-title balance">A calm letter asking to be paid.</h1>
      <div class="h-side">
        <p class="muted">Five short questions. You get a letter to print, copy or save as a PDF. Many disputes end here.</p>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="notice" role="note" aria-labelledby="notice-h">
      <span class="notice-mark" aria-hidden="true">i</span>
      <div>
        <div class="notice-top">
          <h2 id="notice-h" class="s">Before you start</h2>
          <span class="label">Read once · 30 seconds</span>
        </div>
        <ol>{notice.map((n) => <li>{n}</li>)}</ol>
        <div class="btn-row notice-actions">
          <button type="button" class="btn btn-accent">I understand, start</button>
          <a class="btn" href="/mockups/b/about/" data-keep-theme>What Fair Claim can and can't do</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap lt" aria-label="Letter builder">
    <div class="lt-flow">
      <div class="progress-row">
        <span class="label">Question 03 of 05</span>
        <span class="label">Amount</span>
      </div>
      <div class="progress" style="--n:5">
        {steps.map((_, i) => <span class={i < 2 ? "done" : i === 2 ? "now" : ""}></span>)}
      </div>

      <div class="lt-q lt-done">
        <div class="lt-q-h"><span class="label">01</span><h2 class="s">What is it about?</h2><button type="button" class="lt-edit label">Edit</button></div>
        <div class="tiles" style="--cols:5; --tile-h:104px">
          {kinds.map((k) => (
            <button type="button" class="tile" aria-pressed={k.on ? "true" : "false"}>
              <span class="tile-top"><span class="k">{k.k}</span></span>
              <span class="tile-t">{k.t}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="lt-q lt-done">
        <div class="lt-q-h"><span class="label">02</span><h2 class="s">Who is it from, and to?</h2><button type="button" class="lt-edit label">Edit</button></div>
        <div class="fields" style="--cols:2; --panel-h:86px">
          <label class="panel"><span class="panel-l">Your name</span><input value="Jordan Lee" /><span class="panel-corner check on" aria-hidden="true"></span></label>
          <label class="panel"><span class="panel-l">Their name (the legal name)</span><input value="Sample Property Co." /><span class="panel-corner check on" aria-hidden="true"></span></label>
        </div>
      </div>

      <div class="lt-q lt-now">
        <div class="lt-q-h"><span class="label lt-n">03</span><h2 class="l">How much, and by when?</h2></div>
        <div class="fields" style="--cols:2">
          <label class="panel panel-big" style="--panel-h:150px">
            <span class="panel-l">Amount you're asking for</span>
            <span class="inline"><span class="cur">$</span><input value="1,850" inputmode="decimal" /></span>
          </label>
          <label class="panel" style="--panel-h:150px">
            <span class="panel-l">Date you moved out</span>
            <input value="September 30, 2026" />
            <span class="cite" style="margin-top:8px">Optional · used in the first paragraph</span>
          </label>
        </div>
        <p class="lt-sub">Give them</p>
        <div class="tiles" style="--cols:3; --tile-h:104px" role="radiogroup" aria-label="Deadline">
          {[10, 14, 21].map((d, i) => (
            <button type="button" class="tile" role="radio" aria-checked={d === 14 ? "true" : "false"}>
              <span class="tile-top"><span class="k">{"ABC"[i]}</span><span class="label">{d === 14 ? "Common" : ""}</span></span>
              <span class="tile-t"><span class="num lt-days">{d}</span> days</span>
            </button>
          ))}
        </div>
        <label class="panel lt-facts" style="--panel-h:150px">
          <span class="panel-l">What happened, in your own words</span>
          <textarea rows="3">I returned the keys and gave you my forwarding address on the day I moved out. More than 21 days have passed, and I have not received my deposit or an itemized statement of deductions.</textarea>
          <span class="panel-corner label">{letter.paragraphs[1]?.length ?? 0} / 800</span>
        </label>
        <div class="q-actions">
          <button type="button" class="btn btn-primary">Continue<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8h10M9 4l4 4-4 4" /></svg></button>
          <span class="label">or press Enter ↵</span>
        </div>
      </div>

      <div class="lt-q is-dim">
        <div class="lt-q-h"><span class="label">04</span><h2 class="s">Add California's deposit rules?</h2></div>
        <div class="tiles" style="--cols:2; --tile-h:150px">
          {notes.map((n, i) => (
            <button type="button" class="tile">
              <span class="tile-top"><span class="k">{"AB"[i]}</span><span class="label">{n.citation}</span></span>
              <span class="tile-d">{n.text}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="lt-q is-dim">
        <div class="lt-q-h"><span class="label">05</span><h2 class="s">Mention small claims court?</h2></div>
        <div class="tiles" style="--cols:2; --tile-h:96px">
          <button type="button" class="tile"><span class="tile-top"><span class="k">A</span></span><span class="tile-t">Say I may file if it isn't paid</span></button>
          <button type="button" class="tile"><span class="tile-top"><span class="k">B</span></span><span class="tile-t">Leave court out of it</span></button>
        </div>
      </div>
    </div>

    <aside class="lt-preview" aria-label="Letter preview">
      <div class="lt-preview-top">
        <span class="label">Preview · updates as you type</span>
        <span class="label">Letter · 1 page</span>
      </div>
      <article class="paper lt-paper">
        <div class="lt-heading">
          <div>{letter.heading.slice(0, 4).map((l) => <p>{l}</p>)}</div>
          <p class="lt-date">{formatLongDate("2026-11-06")}</p>
        </div>
        <div class="lt-to">{letter.heading.slice(6).filter(Boolean).map((l) => <p>{l}</p>)}</div>
        <p class="lt-subj">Re: {letter.subject}</p>
        <p>{letter.salutation}</p>
        {letter.paragraphs.map((p, i) => <p class:list={{ "lt-hl": i === 0 || p.startsWith("Please pay") }}>{p}</p>)}
        <div class="lt-close">{letter.closing.filter(Boolean).map((l) => <p>{l}</p>)}</div>
        <p class="lt-foot">Prepared with Fair Claim · general information, not legal advice</p>
      </article>
      <div class="lt-actions">
        <button type="button" class="btn btn-primary">Download PDF</button>
        <button type="button" class="btn">Print</button>
        <button type="button" class="btn">Copy text</button>
      </div>
      <dl class="lt-facts-mini">
        <div><dt class="label">Amount</dt><dd class="num key">{formatMoney(1850)}</dd></div>
        <div><dt class="label">Pay by</dt><dd class="num">{formatLongDate(letter.deadline)}</dd></div>
      </dl>
      <p class="cite"><a href={notes[0].url} rel="noopener">{notes[0].citation}</a><span>checked 2026-11-05</span></p>
    </aside>
  </section>
</Layout>

<style>
  .lt-hero {
    padding-bottom: clamp(40px, 4vw, 64px);
  }
  .notice-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .notice-actions {
    margin-top: 28px;
  }
  .lt {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(24px, 3vw, 56px);
    row-gap: 64px;
    margin-top: clamp(64px, 7vw, 112px);
  }
  .lt-flow {
    grid-column: 1 / span 7;
  }
  .lt-preview {
    grid-column: 8 / span 5;
    align-self: start;
    position: sticky;
    top: 100px;
  }
  @media (max-width: 1000px) {
    .lt-flow,
    .lt-preview {
      grid-column: 1 / -1;
      position: static;
    }
  }
  .lt-q {
    margin-top: clamp(48px, 5vw, 80px);
  }
  .lt-q-h {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 22px;
  }
  .lt-done .lt-q-h h2 {
    color: var(--text-2);
  }
  .lt-edit {
    margin-left: auto;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--line-3);
    text-underline-offset: 4px;
  }
  .lt-edit:hover {
    color: var(--text);
  }
  .lt-n {
    color: var(--accent-text);
  }
  .lt-now .lt-q-h h2 {
    line-height: 1.04;
  }
  .lt-sub {
    margin: 32px 0 12px;
    font-size: 15px;
    color: var(--text-2);
  }
  .lt-days {
    font-size: 34px;
    line-height: 1;
    margin-right: 4px;
  }
  .lt-facts {
    margin-top: 10px;
  }
  .q-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }
  .lt-preview-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .lt-paper {
    padding: 40px 44px 32px;
    font-size: 12.5px;
    line-height: 1.6;
  }
  .lt-paper p + p {
    margin-top: 0.9em;
  }
  .lt-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }
  .lt-heading p + p,
  .lt-to p + p,
  .lt-close p + p {
    margin-top: 0;
  }
  .lt-date {
    color: var(--paper-ink-2);
    white-space: nowrap;
  }
  .lt-to {
    margin-bottom: 18px;
  }
  .lt-subj {
    font-weight: 500;
  }
  .lt-hl {
    background-image: linear-gradient(rgba(210, 243, 76, 0.55), rgba(210, 243, 76, 0.55));
    background-size: 3px 100%;
    background-repeat: no-repeat;
    padding-left: 12px;
    margin-left: -15px;
    padding-left: 12px;
  }
  .lt-close {
    margin-top: 1.4em;
  }
  .lt-close p:last-child {
    margin-top: 1.6em !important;
  }
  .lt-foot {
    margin-top: 28px !important;
    padding-top: 12px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    font-family: var(--f-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper-ink-2);
  }
  .lt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .lt-facts-mini {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    margin: 28px 0 12px;
  }
  .lt-facts-mini > div {
    border-top: 1px solid var(--line-2);
    padding-top: 12px;
  }
  .lt-facts-mini dd {
    font-size: 28px;
    margin-top: 6px;
    line-height: 1.1;
  }
</style>
