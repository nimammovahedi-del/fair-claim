---
// Mockup Option B — shared layout. Self-contained: does not use Site.astro or global.css.
// Theme: ?theme=dark | ?theme=light (default dark). The switch updates the URL, nothing is stored.
import "@fontsource-variable/inter-tight/wght.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-mono/400.css";
import "./b.css";
import { statesChecked } from "../../lib/stats";

interface Props {
  title: string;
  active?: "learn" | "states" | "tools" | "glossary" | "about" | "";
}
const { title, active = "" } = Astro.props;
const base = "/mockups/b";
const nav = [
  { key: "learn", href: `${base}/how-it-works/`, label: "How it works" },
  { key: "states", href: `${base}/state/`, label: "State rules" },
  { key: "tools", href: `${base}/calculator/`, label: "Tools" },
  { key: "glossary", href: `${base}/glossary/`, label: "Glossary" },
  { key: "about", href: `${base}/about/`, label: "About" },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Fair Claim (Mockup B)</title>
    <script is:inline>
      (function () {
        var t = new URLSearchParams(location.search).get("theme");
        document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
      })();
    </script>
  </head>
  <body class="b">
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="bh">
      <div class="wrap bh-in">
        <a class="brand" href={`${base}/`} data-keep-theme>
          <span class="brand-mark" aria-hidden="true"></span>
          Fair Claim
        </a>
        <nav class="bh-nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} data-keep-theme aria-current={active === n.key ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="theme-switch" role="group" aria-label="Theme">
          <button type="button" data-theme-set="dark" aria-pressed="true">Dark</button>
          <button type="button" data-theme-set="light" aria-pressed="false">Light</button>
        </div>
      </div>
      <nav class="bh-tabs" aria-label="Main (compact)">
        {nav.map((n) => (
          <a href={n.href} data-keep-theme aria-current={active === n.key ? "page" : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="bf">
      <div class="wrap">
        <div class="bf-top">
          <div class="bf-statement">
            <p>Small claims court, explained plainly.</p>
            <p>
              Free, neutral information for every US state, with a source and a date beside each rule. Legal
              information, not legal advice. Nothing here recommends suing or not suing.
            </p>
          </div>
          <div class="bf-col">
            <h2>Learn</h2>
            <ul>
              <li><a data-keep-theme href={`${base}/how-it-works/`}>How it works</a></li>
              <li><a data-keep-theme href={`${base}/glossary/`}>Glossary</a></li>
              <li><a data-keep-theme href={`${base}/about/`}>What the data shows</a></li>
            </ul>
          </div>
          <div class="bf-col">
            <h2>Look up</h2>
            <ul>
              <li><a data-keep-theme href={`${base}/state/`}>California</a></li>
              <li><a data-keep-theme href={`${base}/state/`}>All 50 states + DC</a></li>
              <li><a data-keep-theme href={`${base}/checklists/`}>Checklists</a></li>
            </ul>
          </div>
          <div class="bf-col">
            <h2>Use</h2>
            <ul>
              <li><a data-keep-theme href={`${base}/calculator/`}>Cost calculator</a></li>
              <li><a data-keep-theme href={`${base}/letter/`}>Demand letter</a></li>
              <li><a data-keep-theme href={`${base}/checklists/`}>Printable checklists</a></li>
            </ul>
          </div>
        </div>
        <div class="bf-base">
          <span class="label">No ads · No tracking · Nothing you type is stored</span>
          <span class="label">Rules checked {statesChecked}</span>
        </div>
      </div>
    </footer>

    <span class="mock-tag" aria-hidden="true">Mockup · Option B</span>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        function current() {
          return root.getAttribute("data-theme") || "dark";
        }
        function sync() {
          var t = current();
          document.querySelectorAll("[data-theme-set]").forEach(function (b) {
            b.setAttribute("aria-pressed", String(b.getAttribute("data-theme-set") === t));
          });
          document.querySelectorAll("a[data-keep-theme]").forEach(function (a) {
            var u = new URL(a.getAttribute("href"), location.href);
            u.searchParams.set("theme", t);
            a.setAttribute("href", u.pathname + u.search + u.hash);
          });
        }
        document.querySelectorAll("[data-theme-set]").forEach(function (b) {
          b.addEventListener("click", function () {
            root.setAttribute("data-theme", b.getAttribute("data-theme-set"));
            var u = new URL(location.href);
            u.searchParams.set("theme", current());
            history.replaceState(null, "", u);
            sync();
          });
        });
        sync();
        // For screenshot tooling: record the full document height.
        function mark() {
          root.setAttribute("data-doc-h", String(Math.ceil(document.documentElement.scrollHeight)));
        }
        mark();
        window.addEventListener("load", mark);
        if (document.fonts) document.fonts.ready.then(mark);
      })();
    </script>
  </body>
</html>
