---
// About (Option A): mission, principles, who it's for, what the data shows (five charts), how facts are checked,
// and #not-advice (tool notices link to /about/#not-advice: keep that id).
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Term from "../../components/Term.astro";
import TileMapLimits from "../../components/TileMapLimits.astro";
import ChartLimitChanges from "../../components/ChartLimitChanges.astro";
import ChartRules from "../../components/ChartRules.astro";
import ChartCollect from "../../components/ChartCollect.astro";
import ChartPhilly from "../../components/ChartPhilly.astro";
import "../../styles/features.css";
import { denver, evidenceChecked } from "../../lib/stats";

const principles = [
  { k: "A", t: "Free", d: "No ads, no sponsors, nothing for sale, no accounts. It isn't paid for by anyone.", c: "c-cobalt" },
  { k: "B", t: "Private", d: "No analytics, no tracking cookies, no third-party scripts or fonts. What you type stays in your tab.", c: "c-tomato" },
  { k: "C", t: "Sourced and dated", d: "Every rule links to the law or the court, with the date we last checked it.", c: "c-sage" },
  { k: "D", t: "Neutral", d: "It won't talk you into suing, or out of it. Costs and the odds of being paid sit next to the steps.", c: "c-lilac" },
];
const who = [
  { t: "Tenants", d: "A landlord kept a security deposit." },
  { t: "Customers", d: "A business or contractor owes a refund or a repair." },
  { t: "Small businesses", d: "An invoice went unpaid. Some states set a lower limit for businesses." },
  { t: "Anyone weighing it up", d: "Including whether it's worth the time at all." },
];
---
<Site
  title="About"
  description="What Fair Claim is, how facts are checked, the numbers behind small claims court, and where to get free advice."
  bleed
  color="c-about"
>
  <section class="wrap page-hero">
    <Breadcrumb items={[{ label: "About" }]} />
    <h1 class="display-xl ab-title">Information about small claims court that isn't trying to <span class="soft">talk you into anything.</span></h1>
    <div class="ab-intro">
      <p class="lede">Small claims court can settle a money dispute without a lawyer. It can also cost more than it returns, and winning doesn't mean being paid.</p>
      <p class="muted">Fair Claim sets out both sides: your state's rules, the steps, the costs, the evidence on collecting, and other routes. You decide. It's an independent project, not a court, a government agency or a law firm.</p>
    </div>
  </section>

  <section class="wrap" id="mission" aria-label="Principles">
    <ul class="principles">
      {principles.map((p) => (
        <li class={`pr ${p.c}`}>
          <span class="t-top"><span class="key" aria-hidden="true">{p.k}</span><span class="t-dot" aria-hidden="true"></span></span>
          <h2 class="h3">{p.t}</h2>
          <p>{p.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" id="who" aria-labelledby="who-title">
    <div class="sec-head">
      <p class="lbl">Who it's for</p>
      <div>
        <h2 class="h2" id="who-title">People with a money dispute, on either side of it.</h2>
        <ul class="ab-who" style="margin-top:36px">
          {who.map((w) => <li><strong>{w.t}</strong><span>{w.d}</span></li>)}
        </ul>
        <p class="note-strip ab-sued">
          <span class="lbl">Been sued?</span>
          <span>A guide for defendants is planned. Until then: don't ignore the papers. Missing the hearing usually means a <Term slug="default-judgment" />.</span>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" id="data" aria-labelledby="data-title">
    <div class="sec-head">
      <p class="lbl">What the data shows</p>
      <div>
        <h2 class="h2" id="data-title">Five views of small claims in the US.</h2>
        <p class="lede">From our 50-state research and the few published studies. Evidence on collecting is thin and old, so it's shown with its limits.</p>
      </div>
    </div>

    <div class="charts">
      <TileMapLimits headingLevel={3} class="wide" />
      <ChartLimitChanges headingLevel={3} />
      <ChartRules headingLevel={3} />

      <div class="ab-paid wide" id="chart-denver" role="group" aria-labelledby="denver-title">
        <div class="chart-head">
          <p class="lbl">Getting paid · one court</p>
          <h3 class="chart-title" id="denver-title">Winning isn't the same as being paid</h3>
          <p class="chart-sub">One study of Denver's small claims court.</p>
        </div>
        <div class="stats">
          <div class="stat c-sage"><span class="s-bar"></span><p class="num">{denver.wonPct}%</p><p class="s-label">of plaintiffs who came to the hearing won</p></div>
          <div class="stat c-tomato"><span class="s-bar"></span><p class="num">{denver.collectedNothingPct}%</p><p class="s-label">of those winners never collected anything</p></div>
          <div class="stat c-sand"><span class="s-bar"></span><p class="num">{denver.dollarsPaidPct}%</p><p class="s-label">of all the money awarded was actually paid</p></div>
        </div>
        <div class="chart-foot">
          <p class="cite"><span>Source</span><a href={denver.source.url} rel="noopener">{denver.source.label}</a><span>Checked {evidenceChecked}</span></p>
          <p class="hint">{denver.caveat}</p>
        </div>
      </div>
      <ChartCollect headingLevel={3} class="wide" />

      <ChartPhilly headingLevel={3} class="wide" />
    </div>
  </section>

  <section class="wrap section" id="checking" aria-labelledby="chk-title">
    <div class="sec-head">
      <p class="lbl">How we check facts</p>
      <div class="ab-body">
        <h2 class="h3" id="chk-title">Primary sources first, and a date on everything.</h2>
        <p style="margin-top:18px">
          Every rule links to the law or the court's own site, with the date we checked it. Anything not yet confirmed is
          marked <span class="badge unverified">unverified</span>. Statistics come only from the studies we cite.
        </p>
        <p><strong>If the court tells you something different, the court is right.</strong></p>
        <p><a class="go" href="/sources/">How we check, and how often</a></p>
      </div>
    </div>
  </section>

  <section class="wrap section" id="not-advice" aria-labelledby="not-advice-title">
    <div class="sec-head">
      <p class="lbl">Information, not advice</p>
      <div>
        <h2 class="h2" id="not-advice-title">Fair Claim explains the rules. Only someone who knows your facts can tell you what to do.</h2>
        <div class="ab-def-wrap">
        <div class="ab-def">
          <div class="is-us">
            <p class="lbl">What you get here</p>
            <p class="h4">Legal information</p>
            <p>How the rules and the process work in general: the limit, which form starts a case, how long you have to appeal.</p>
          </div>
          <div>
            <p class="lbl">What you won't</p>
            <p class="h4">Legal advice</p>
            <p>Whether your claim is good, how much to ask for, what to say. Our tools do arithmetic and fill in templates; they don't judge your case.</p>
          </div>
        </div>

        <h3 class="h3 help-head">Where to get free help with your own case</h3>
        <ul class="help">
          <li>
            <div class="card card-link">
              <p class="lbl">California</p>
              <h3 class="h4"><a href="/states/ca/counties/">Free small claims advisors</a></h3>
              <p>Counties must offer free advisor help (CCP 116.260).</p>
              <span class="go">County pages</span>
            </div>
          </li>
          <li>
            <div class="card card-link">
              <p class="lbl">Every state</p>
              <h3 class="h4"><a href="/states/">Court self-help centers</a></h3>
              <p>Free help for people without lawyers. Each state page links to its official site.</p>
              <span class="go">State rules</span>
            </div>
          </li>
          <li>
            <div class="card card-link">
              <p class="lbl">Low income</p>
              <h3 class="h4"><a href="https://www.lawhelp.org/" rel="noopener">Legal aid</a></h3>
              <p>Nonprofit <Term slug="legal-aid" plain>legal aid</Term> programs, listed by state on LawHelp.org.</p>
              <span class="go">LawHelp.org</span>
            </div>
          </li>
        </ul>
        <p class="note-strip" style="margin-top:24px">
          <span class="lbl">Before you act</span>
          <span>Check the current rule with your court. Laws, fees and deadlines change.</span>
        </p>
        </div>
      </div>
    </div>
  </section>
</Site>
