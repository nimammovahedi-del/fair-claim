---
// About (Option A, round 5): an editorial page in four parts, in order of emphasis:
//   01 #paid      Winning isn't getting paid (lead story: big numbers + the collection chart)
//   02 #who       Who uses small claims (Pew, Philadelphia: debt collectors, defaults)
//   03 #checking  How we check facts (counts from the data, what's open, dated changes, upkeep, rules charts)
//   04 #mission   Why the site exists + #not-advice and free help (tool notices link to /about/#not-advice: keep that id)
// Every number keeps its source and date; unverified ones keep their badge. Numbers come from lib/stats.ts.
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Term from "../../components/Term.astro";
import TileMapLimits from "../../components/TileMapLimits.astro";
import ChartLimitChanges from "../../components/ChartLimitChanges.astro";
import ChartRules from "../../components/ChartRules.astro";
import ChartCollect from "../../components/ChartCollect.astro";
import ChartPhilly from "../../components/ChartPhilly.astro";
import "../../styles/features.css";
import {
  denver,
  evidenceChecked,
  pew2022,
  pew2021,
  statesChecked,
  countiesChecked,
  stateFacts,
  countyFacts,
  statesOpen,
  recheckRounds,
  upcomingChanges,
  upkeep,
  coreOpen,
} from "../../lib/stats";

const parts = [
  { href: "#paid", n: "01", t: "Winning isn't getting paid", c: "c-tomato" },
  { href: "#who", n: "02", t: "Who uses small claims", c: "c-cobalt" },
  { href: "#checking", n: "03", t: "How we check facts", c: "c-sage" },
  { href: "#mission", n: "04", t: "Why this site exists", c: "c-sand" },
];
const principles = [
  { k: "A", t: "Free", d: "No ads, no sponsors, nothing for sale, no accounts. It isn't paid for by anyone.", c: "c-cobalt" },
  { k: "B", t: "Private", d: "No analytics, no tracking cookies, no third-party scripts or fonts. What you type stays in your tab.", c: "c-tomato" },
  { k: "C", t: "Sourced and dated", d: "Every rule links to the law or the court, with the date we last checked it.", c: "c-sage" },
  { k: "D", t: "Neutral", d: "It won't talk you into suing, or out of it. Costs and the odds of being paid sit next to the steps.", c: "c-lilac" },
];
const who = [
  { t: "Tenants", d: "A landlord kept a security deposit." },
  { t: "Customers", d: "A business or contractor owes a refund or a repair." },
  { t: "Small businesses", d: "An invoice went unpaid. Some states set a lower limit for businesses." },
  { t: "People who were sued", d: "A guide for defendants is planned. State pages link to each court's guide." },
];
const fmtDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Site
  title="About"
  description="What the evidence shows about small claims court, who uses it, how Fair Claim checks its facts, and where to get free help."
  bleed
  color="c-about"
>
  <section class="wrap page-hero ab-hero">
    <Breadcrumb items={[{ label: "About" }]} />
    <h1 class="display ab-title">Small claims court, by the numbers we can source.</h1>
    <div class="ab-intro">
      <p class="lede">It can settle a money dispute without a lawyer. It can also cost more than it returns, and winning doesn't mean being paid.</p>
      <nav aria-label="On this page">
        <ol class="ab-index">
          {parts.map((p) => (
            <li class={p.c}>
              <a href={p.href}><span class="ab-index-n">{p.n}</span><span>{p.t}</span></a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  <!-- 01 · Lead story -->
  <section class="wrap ab-part c-tomato" id="paid" aria-labelledby="paid-title">
    <div class="ab-head is-lead">
      <p class="lbl"><span class="ab-part-n">01</span>Getting paid</p>
      <div>
        <h2 class="ab-h" id="paid-title">Winning isn't getting paid.</h2>
        <p class="lede">Courts don't track whether winners collect. The few studies that looked found that many never do.</p>
      </div>
    </div>

    <div class="ab-figs" role="group" aria-labelledby="denver-title">
      <p class="sr-only" id="denver-title">One study of Denver's small claims court</p>
      <div class="ab-fig is-hero">
        <p class="ab-fig-num">{denver.collectedNothingPct}%</p>
        <p class="ab-fig-label">of winners never collected anything</p>
      </div>
      <div class="ab-fig">
        <span class="s-bar c-sage" aria-hidden="true"></span>
        <p class="ab-fig-num">{denver.wonPct}%</p>
        <p class="ab-fig-label">of plaintiffs who came to the hearing won</p>
      </div>
      <div class="ab-fig">
        <span class="s-bar c-sand" aria-hidden="true"></span>
        <p class="ab-fig-num">{denver.dollarsPaidPct}%</p>
        <p class="ab-fig-label">of all the money awarded was actually paid</p>
      </div>
    </div>
    <div class="ab-figs-foot">
      <p class="cite"><span>One study of Denver's small claims court</span><a href={denver.source.url} rel="noopener">{denver.source.label}</a><span>Checked {evidenceChecked}</span></p>
      <p class="hint">{denver.caveat}</p>
    </div>

    <div class="ab-chart">
      <ChartCollect headingLevel={3} />
    </div>
    <p class="note-strip ab-note">
      <span class="lbl">What a judgment does</span>
      <span>It lets the winner use the court's collection tools, such as a wage garnishment or a bank levy. It doesn't make the other side pay. <a href="/steps/#collect">Step 5: collecting</a>.</span>
    </p>
  </section>

  <!-- 02 · Who uses it -->
  <section class="wrap ab-part c-cobalt" id="who" aria-labelledby="who-title">
    <div class="ab-head">
      <p class="lbl"><span class="ab-part-n">02</span>Who uses small claims</p>
      <div>
        <h2 class="ab-h" id="who-title">In one big city, most cases were debt collection, and most judgments came by default.</h2>
        <p class="lede">Pew studied {pew2022.casesTotal} cases in Philadelphia's Municipal Court, {pew2022.years}. Other courts may differ.</p>
      </div>
    </div>

    <div class="ab-figs is-two">
      <div class="ab-fig is-hero">
        <p class="ab-fig-num">{pew2022.judgmentsDefaultPct}%</p>
        <p class="ab-fig-label">of the {pew2022.judgmentsTotal} cases that reached a judgment were defaults: the person sued didn't respond or appear</p>
        <p class="cite"><a href={pew2022.source.url} rel="noopener">Pew (2022)</a><span>Checked {evidenceChecked}</span></p>
      </div>
      <div class="ab-fig">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="ab-fig-num">{pew2021.plaintiffsWithLawyersPct}%</p>
        <p class="ab-fig-label">of plaintiffs had a lawyer, against about {pew2021.defendantsWithLawyersPct}% of defendants, in the court's civil cases</p>
        <p class="cite"><a href={pew2021.source.url} rel="noopener">Pew (2021)</a><span>Checked {evidenceChecked}</span></p>
      </div>
    </div>

    <div class="ab-chart">
      <ChartPhilly headingLevel={3} tiles={false} />
    </div>
    <p class="note-strip ab-note">
      <span class="lbl">Been sued?</span>
      <span>Don't ignore the papers. Missing the hearing usually means a <Term slug="default-judgment" />. Your <a href="/states/">state's page</a> links to the court's guide.</span>
    </p>
  </section>

  <!-- 03 · How we check -->
  <section class="wrap ab-part c-sage" id="checking" aria-labelledby="chk-title">
    <div class="ab-head">
      <p class="lbl"><span class="ab-part-n">03</span>How we check facts</p>
      <div>
        <h2 class="ab-h" id="chk-title">Primary sources first, and a date on everything.</h2>
        <p class="lede">Every rule links to the law or the court's own site.</p>
      </div>
    </div>

    <div class="ab-figs is-three">
      <div class="ab-fig is-hero">
        <p class="ab-fig-num">{stateFacts.tracked}</p>
        <p class="ab-fig-label">state facts, each with a source and a date, across 50 states and DC</p>
        <p class="cite"><span>Checked {statesChecked}</span></p>
      </div>
      <div class="ab-fig">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="ab-fig-num">{countyFacts.tracked}</p>
        <p class="ab-fig-label">California county facts, across {countyFacts.rows} counties</p>
        <p class="cite"><span>Checked {countiesChecked}</span></p>
      </div>
      <div class="ab-fig">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="ab-fig-num">{recheckRounds.corrected}</p>
        <p class="ab-fig-label">values corrected, and {recheckRounds.confirmed} confirmed, in two re-check rounds</p>
        <p class="cite"><span>{recheckRounds.when}</span></p>
      </div>
    </div>
    <p class="hint ab-count-note">A fact is one filled-in field, such as a limit, fee or appeal deadline. Counted from our data files.</p>

    <div class="ab-check-grid">
      <div class="ab-col">
        <h3 class="h4">How a fact gets on the site</h3>
        <ol class="ab-rules">
          <li><span>It comes from the statute, the court's rules or the court's own site. Every source is linked.</span></li>
          <li><span>It carries the date we last checked it.</span></li>
          <li><span>Statistics come only from the studies we cite.</span></li>
        </ol>
        <p class="ab-court"><strong>If the court tells you something different, the court is right.</strong></p>
        <p><a class="go" href="/sources/">Sources and method</a></p>
      </div>
    </div>

    <details class="acc ab-more">
      <summary>Dates: {upcomingChanges.length} changes on the calendar, and the yearly upkeep<span class="pm" aria-hidden="true"></span></summary>
      <div class="acc-body">
    <div class="ab-check-grid">
      <div class="ab-col">
        <h3 class="h4">Changes already on the calendar</h3>
        <ul class="ab-dates">
          {upcomingChanges.map((c) => (
            <li>
              <span class="ab-date">{fmtDate(c.date)}</span>
              <span><a href={`/states/${c.slug}/`}>{c.state}</a>. {c.what}</span>
            </li>
          ))}
        </ul>
        <p class="cite"><span>Enacted laws; each state page has the source</span><span>Checked {statesChecked}</span></p>
      </div>
      <div class="ab-col">
        <h3 class="h4">The yearly upkeep</h3>
        <p class="ab-p">Limits and fees change by statute, usually on January 1 or July 1.</p>
        <ul class="ab-dates">
          {upkeep.map((u) => (
            <li><span class="ab-date">{u.when}</span><span>{u.what}</span></li>
          ))}
        </ul>
      </div>
    </div>
      </div>
    </details>

    <div id="data" class="ab-rules-charts">
      <h3 class="lbl ab-sub">What the checked rules show</h3>
      <div class="charts">
        <TileMapLimits headingLevel={4} class="wide" />
        <ChartLimitChanges headingLevel={4} />
        <ChartRules headingLevel={4} />
      </div>
    </div>
  </section>

  <!-- 04 · Mission, free help, not advice -->
  <section class="wrap ab-part c-sand" id="mission" aria-labelledby="mission-title">
    <div class="ab-head">
      <p class="lbl"><span class="ab-part-n">04</span>Why this site exists</p>
      <div>
        <h2 class="ab-h" id="mission-title">Information about small claims court that isn't trying to <span class="soft">talk you into anything.</span></h2>
        <p class="lede">The rules, the costs and the odds of being paid, side by side. You decide.</p>
      </div>
    </div>
    <ul class="principles">
      {principles.map((p) => (
        <li class={`pr ${p.c}`}>
          <span class="t-top"><span class="key" aria-hidden="true">{p.k}</span><span class="t-dot" aria-hidden="true"></span></span>
          <h3 class="h3">{p.t}</h3>
          <p>{p.d}</p>
        </li>
      ))}
    </ul>
    <div class="ab-for">
      <h3 class="lbl ab-sub">Who it's for</h3>
      <ul class="ab-who">
        {who.map((w) => <li><strong>{w.t}</strong><span>{w.d}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="wrap section" id="not-advice" aria-labelledby="not-advice-title">
    <div class="sec-head">
      <p class="lbl">Information, not advice</p>
      <div>
        <h2 class="h2" id="not-advice-title">Fair Claim explains the rules. Only someone who knows your facts can tell you what to do.</h2>
        <div class="ab-def-wrap">
        <div class="ab-def">
          <div class="is-us">
            <p class="lbl">What you get here</p>
            <p class="h4">Legal information</p>
            <p>How the rules and the process work in general: the limit, which form starts a case, how long you have to appeal.</p>
          </div>
          <div>
            <p class="lbl">What you won't</p>
            <p class="h4">Legal advice</p>
            <p>Whether your claim is good, how much to ask for, what to say. Our tools do arithmetic and fill in templates; they don't judge your case.</p>
          </div>
        </div>

        <h3 class="h3 help-head" id="help">Where to get free help with your own case</h3>
        <ul class="help">
          <li>
            <div class="card card-link">
              <p class="lbl">California</p>
              <h3 class="h4"><a href="/states/ca/counties/">Free small claims advisors</a></h3>
              <p>Counties must offer free advisor help (CCP 116.260).</p>
              <span class="go">County pages</span>
            </div>
          </li>
          <li>
            <div class="card card-link">
              <p class="lbl">Every state</p>
              <h3 class="h4"><a href="/states/">Court self-help centers</a></h3>
              <p>Free help for people without lawyers. Each state page links to its official site.</p>
              <span class="go">State rules</span>
            </div>
          </li>
          <li>
            <div class="card card-link">
              <p class="lbl">Low income</p>
              <h3 class="h4"><a href="https://www.lawhelp.org/" rel="noopener">Legal aid</a></h3>
              <p>Nonprofit <Term slug="legal-aid" plain>legal aid</Term> programs, listed by state on LawHelp.org.</p>
              <span class="go">LawHelp.org</span>
            </div>
          </li>
        </ul>
        </div>
      </div>
    </div>
  </section>
</Site>
