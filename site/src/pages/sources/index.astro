---
// How we check (Option A): short sections, one idea each. Anchors kept: #sources #current #collecting #not-advice.
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import "../../styles/states.css";
import { odds } from "../../lib/odds";
import { states, counties } from "../../lib/data";
---
<Site title="How we check" description="Where Fair Claim's facts come from, and how we keep them current." bleed>
  <section class="wrap sr-hero">
    <Breadcrumb items={[{ label: "How we check" }]} />
    <div class="sr-title-row">
      <h1 class="display sr-title">How we check</h1>
      <p class="lede" style="margin:0">Every rule has a source and a date.</p>
    </div>
  </section>

  <section class="wrap" aria-label="Where things stand">
    <div class="stats chk-stats">
      <div class="stat">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="num">{states.length}</p>
        <div><p class="s-label">States and DC</p><p class="s-sub">Limits, fees, appeals and more, each sourced.</p></div>
      </div>
      <div class="stat">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="num">{counties.length}</p>
        <div><p class="s-label">California counties</p><p class="s-sub">Courthouses, free advisors and self-help centers.</p></div>
      </div>
      <div class="stat">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="num word">Yearly</p>
        <div><p class="s-label">Full re-check</p><p class="s-sub">Plus any state as soon as we hear of a change.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap section" id="sources" aria-labelledby="sources-title">
    <div class="sec-head">
      <p class="lbl">Sources</p>
      <div class="prose">
        <h2 id="sources-title" class="h2">From the law or the court. Nowhere else.</h2>
        <p class="lede">A statute, a court rule, or the court's own site or forms, linked, with the date we checked.</p>
        <p class="muted">We don't use other sites' state-by-state charts: many are out of date.</p>
      </div>
    </div>
  </section>


  <section class="wrap section" id="current" aria-labelledby="current-title">
    <div class="sec-head">
      <p class="lbl">Keeping current</p>
      <div class="prose">
        <h2 id="current-title" class="h2">Laws change, usually on January 1 or July 1.</h2>
        <p class="muted">We re-check every state each year before those dates. A correction updates that page's "checked" date.</p>
      </div>
    </div>
  </section>

  <section class="wrap section" id="collecting" aria-labelledby="collect-title">
    <div class="sec-head">
      <p class="lbl">Getting paid</p>
      <div>
        <h2 id="collect-title" class="h2">What studies found about getting paid.</h2>
        <p class="lede">Courts don't track it, so there's no national number. These studies are old and local: a rough picture, not a forecast.</p>
      </div>
    </div>
    {odds.items.length === 0 ? (
      <p>Being compiled.</p>
    ) : (
      <ul class="chk-odds">
        {odds.items.map((e) => (
          <li>
            <p class="num chk-n">{e.stat}</p>
            <p class="chk-t">{e.text}</p>
            <p class="cite"><a href={e.url} rel="noopener">{e.sourceLabel}</a></p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="wrap section" id="not-advice" aria-labelledby="advice-title">
    <div class="sec-head">
      <p class="lbl">Not advice</p>
      <div class="prose">
        <h2 id="advice-title" class="h2">Information, not advice.</h2>
        <p class="lede">Fair Claim explains how small claims court works. It can't tell you whether to sue or whether you'll win.</p>
        <a class="go" href="/about/#not-advice">Where to get free help</a>
      </div>
    </div>
  </section>
</Site>

<style>
  /* Short sections: tighter rhythm than the default .section */
  .section {
    padding-top: clamp(32px, 4.4vw, 64px);
  }
  .section:not(#collecting) .sec-head {
    margin-bottom: 0;
  }
  .sec-head .muted {
    margin-top: 16px;
  }
  .sec-head .go {
    margin-top: 20px;
  }
  .chk-stats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .chk-badge {
    font-size: 0.32em;
    height: auto;
    padding: 0.35em 0.6em;
    vertical-align: 0.5em;
  }
  .chk-odds {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 24px 32px;
  }
  .chk-odds li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 18px;
    border-top: 1px solid var(--line-2);
  }
  :where(.chk-odds li > *) {
    margin: 0;
  }
  .chk-n {
    font-size: clamp(36px, 3.4vw, 52px);
    line-height: 1;
  }
  .chk-t {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  @media (max-width: 1080px) {
    .chk-stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .chk-stats .stat {
      padding-left: 0 !important;
      border-right: 0;
      border-top: 1px solid var(--line);
    }
  }
  /* Phones: compact stat rows and study list. */
  @media (max-width: 560px) {
    .chk-stats .stat {
      padding-top: 12px;
      padding-bottom: 12px;
    }
    .chk-stats .num {
      font-size: 40px;
    }
    .chk-odds {
      gap: 16px;
    }
    .chk-odds li {
      gap: 8px;
      padding-top: 12px;
    }
    .chk-n {
      font-size: 32px;
    }
    .chk-t {
      font-size: 15px;
    }
  }
</style>
