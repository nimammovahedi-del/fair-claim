---
import Layout from "../../../../mockups/b/Layout.astro";
import { steps, alternatives, hiddenCosts } from "../../../../lib/steps";

const short = ["Ask in writing", "File", "Serve", "Hearing", "Collect"];
const letters = "ABCDEF";
const costs = hiddenCosts.map((c) => {
  const i = c.indexOf(":");
  const t = c.slice(i + 1).trim();
  return { head: c.slice(0, i), text: t.charAt(0).toUpperCase() + t.slice(1) };
});
const pad = (n: number) => String(n).padStart(2, "0");
---
<Layout title="How it works" active="learn">
  <section class="wrap hero">
    <div class="hero-meta">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a href="/mockups/b/" data-keep-theme>Fair Claim</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="label-strong">How it works</span>
      </nav>
    </div>
    <div class="hero-grid">
      <h1 class="xl h-title balance">Five steps, from a letter to getting paid.</h1>
      <div class="h-side">
        <p class="muted">
          Most cases follow the same path. Each step has its own costs and its own ways to go wrong.
        </p>
        <a class="link hiw-skip" href="#before">Not sure yet? See the other options first <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="steps-h">
    <h2 id="steps-h" class="sr-only">The five steps</h2>
    <div class="progress-row">
      <span class="label">The path</span>
      <span class="label" data-step-count>Step 01 of 05</span>
    </div>
    <div class="hiw-progress" role="tablist" aria-label="Steps">
      {steps.map((s, i) => (
        <button type="button" class="hiw-seg" role="tab" aria-selected={i === 0 ? "true" : "false"} data-go={i} aria-controls={`step-${s.slug}`}>
          <span class="hiw-bar"></span>
          <span class="label">{pad(s.n)}</span>
          <span class="hiw-seg-t">{short[i]}</span>
        </button>
      ))}
    </div>

    <ol class="hiw-steps">
      {steps.map((s, i) => (
        <li class:list={["hiw-step", { open: i === 0, after: i > 0 }]} id={`step-${s.slug}`} data-step={i}>
          <button type="button" class="hiw-row" data-go={i} aria-expanded={i === 0 ? "true" : "false"}>
            <span class="hiw-n num">{pad(s.n)}</span>
            <span class="hiw-row-t">{s.title}</span>
            <span class="hiw-row-d">{s.short}</span>
            <span class="arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </span>
          </button>
          <div class="hiw-detail">
            <div class="hiw-big num key" aria-hidden="true">{pad(s.n)}</div>
            <div class="hiw-main">
              <p class="label">Step {pad(s.n)} of 05</p>
              <h3 class="l balance">{s.title}</h3>
              <p class="hiw-lede">{s.short}</p>
              <dl class="hiw-meta">
                <div><dt class="label">Time</dt><dd>{s.time}</dd></div>
                <div><dt class="label">Cost</dt><dd>{s.cost}</dd></div>
              </dl>
              <div class="prose hiw-body">{s.body.map((p) => <p>{p}</p>)}</div>
              <div class="hiw-lists">
                <div>
                  <h4 class="label label-strong">Do this</h4>
                  <ul class="hiw-do">{s.doThis.map((d) => <li><span class="check on" aria-hidden="true"></span><span>{d}</span></li>)}</ul>
                </div>
                <div>
                  <h4 class="label label-strong">Common mistakes</h4>
                  <ul class="hiw-no">{s.mistakes.map((d) => <li><span class="x" aria-hidden="true"></span><span>{d}</span></li>)}</ul>
                </div>
              </div>
              <div class="hiw-next">
                {i < steps.length - 1 ? (
                  <button type="button" class="btn" data-go={i + 1}>Next: {steps[i + 1].title}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8h10M9 4l4 4-4 4" /></svg></button>
                ) : (
                  <a class="btn" href="/mockups/b/state/" data-keep-theme>See your state's collection rules</a>
                )}
                <span class="label">General information. Your state page has the cited rules.</span>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section hiw-before" id="before" aria-labelledby="before-h">
    <div class="sec-head">
      <p class="label sec-n">Before you decide</p>
      <div class="sec-t">
        <h2 id="before-h" class="l balance">Court is one option. Here are the others.</h2>
        <p class="lede">Some are quicker and cheaper. None of them is the right answer for everyone.</p>
      </div>
    </div>
    <div class="tiles tiles-stack" style="--cols:3; --tile-h:280px">
      {alternatives.map((a, i) => (
        <article class="tile alt-tile">
          <div class="tile-top"><span class="k">{letters[i]}</span><span class="label">Option {pad(i + 1)}</span></div>
          <div>
            <h3 class="s">{a.title}</h3>
            <p class="tile-d">{a.text}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="costs">
      <div class="costs-head">
        <h3 class="m balance">What doesn't show up on a fee schedule</h3>
      </div>
      <dl class="costs-grid">
        {costs.map((c, i) => (
          <div>
            <dt><span class="label">{pad(i + 1)}</span><span class="s">{c.head}</span></dt>
            <dd class="muted">{c.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Layout>

<style>
  .hiw-skip {
    margin-top: 24px;
    font-size: var(--t-small);
  }
  .hiw-progress {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
    border: 0;
    scroll-margin-top: 110px;
  }
  .hiw-seg {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 10px;
    row-gap: 12px;
    align-items: baseline;
    text-align: left;
    background: none;
    border: 0;
    padding: 0 0 4px;
    cursor: pointer;
    color: var(--text-3);
    transition: color var(--fast) var(--ease);
  }
  .hiw-seg:hover {
    color: var(--text);
  }
  .hiw-bar {
    grid-column: 1 / -1;
    height: 3px;
    border-radius: 2px;
    background: var(--line-2);
    transition: background-color var(--med) var(--ease);
  }
  .hiw-seg.done .hiw-bar {
    background: var(--text-2);
  }
  .hiw-seg[aria-selected="true"] {
    color: var(--text);
  }
  .hiw-seg[aria-selected="true"] .hiw-bar {
    background: var(--accent);
  }
  :global([data-theme="light"]) .hiw-seg[aria-selected="true"] .hiw-bar {
    background: var(--text);
  }
  .hiw-seg-t {
    font-size: 15px;
  }
  .hiw-steps {
    margin-top: clamp(40px, 4vw, 64px);
    border-bottom: 1px solid var(--line);
  }
  .hiw-step {
    border-top: 1px solid var(--line);
  }
  .hiw-row {
    width: 100%;
    display: grid;
    grid-template-columns: 120px minmax(0, 5fr) minmax(0, 5fr) 40px;
    gap: var(--gap);
    align-items: center;
    padding: 26px 0;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    transition: opacity var(--med) var(--ease);
  }
  .hiw-row .hiw-n {
    font-size: 40px;
    line-height: 1;
    color: var(--text-3);
  }
  .hiw-row-t {
    font-family: var(--f-display);
    font-size: var(--t-s);
    letter-spacing: -0.02em;
  }
  .hiw-row-d {
    color: var(--text-2);
    font-size: 16px;
    max-width: 48ch;
  }
  .hiw-row:hover .arrow {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .hiw-step.after .hiw-row {
    opacity: var(--dim);
  }
  .hiw-step.after .hiw-row:hover {
    opacity: 0.7;
  }
  .hiw-step.open .hiw-row {
    display: none;
  }
  .hiw-detail {
    display: none;
  }
  .hiw-step.open .hiw-detail {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding: clamp(40px, 5vw, 80px) 0 clamp(48px, 6vw, 96px);
  }
  .hiw-big {
    grid-column: 1 / span 4;
    font-size: clamp(7rem, 4rem + 11vw, 17rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    align-self: start;
    position: sticky;
    top: 120px;
    justify-self: start;
  }
  .hiw-main {
    grid-column: 5 / span 8;
  }
  .hiw-main h3 {
    margin: 16px 0 18px;
    max-width: 16ch;
  }
  .hiw-lede {
    font-size: var(--t-lede);
    color: var(--text-2);
    line-height: 1.45;
    max-width: 40ch;
  }
  .hiw-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    margin: 40px 0;
    border-top: 1px solid var(--line-2);
  }
  .hiw-meta > div {
    padding-top: 14px;
  }
  .hiw-meta dd {
    margin-top: 8px;
    font-size: 17px;
    max-width: 34ch;
  }
  .hiw-body {
    color: var(--text);
  }
  .hiw-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 3vw, 48px);
    margin-top: 48px;
  }
  .hiw-lists h4 {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .hiw-lists li {
    display: grid;
    grid-template-columns: 30px 1fr;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16.5px;
    line-height: 1.5;
  }
  .hiw-lists .check {
    margin-top: 3px;
  }
  .hiw-no li {
    color: var(--text-2);
  }
  .x {
    position: relative;
    width: 18px;
    height: 18px;
    margin-top: 3px;
    border-radius: 50%;
    border: 1px solid var(--line-3);
  }
  .x::before,
  .x::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 1px;
    background: var(--text-2);
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .x::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .hiw-next {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    align-items: center;
    margin-top: 48px;
  }
  @media (max-width: 900px) {
    .hiw-row {
      grid-template-columns: 64px 1fr 40px;
    }
    .hiw-row-d {
      display: none;
    }
    .hiw-big,
    .hiw-main {
      grid-column: 1 / -1;
      position: static;
    }
    .hiw-lists,
    .hiw-meta {
      grid-template-columns: 1fr;
    }
    .hiw-seg-t {
      display: none;
    }
  }
  .alt-tile {
    cursor: default;
    padding: 22px 24px 26px;
  }
  .alt-tile h3 {
    margin-bottom: 10px;
  }
  .alt-tile .tile-d {
    font-size: 16px;
    max-width: 38ch;
  }
  .costs {
    margin-top: clamp(72px, 8vw, 128px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 32px;
  }
  .costs-head {
    grid-column: 1 / span 4;
  }
  .costs-head h3 {
    max-width: 14ch;
  }
  .costs-grid {
    grid-column: 5 / span 8;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gap);
  }
  .costs-grid > div {
    border-top: 1px solid var(--line-2);
    padding: 16px 0 36px;
  }
  .costs-grid dt {
    display: flex;
    gap: 14px;
    align-items: baseline;
    margin-bottom: 10px;
  }
  .costs-grid dd {
    font-size: 16.5px;
    max-width: 38ch;
  }
  @media (max-width: 900px) {
    .costs-head,
    .costs-grid {
      grid-column: 1 / -1;
    }
    .costs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".hiw-step"));
  const segs = Array.from(document.querySelectorAll<HTMLButtonElement>(".hiw-seg"));
  const count = document.querySelector("[data-step-count]");
  function go(i: number, scroll: boolean) {
    items.forEach((el, j) => {
      el.classList.toggle("open", j === i);
      el.classList.toggle("after", j > i);
      el.querySelector(".hiw-row")?.setAttribute("aria-expanded", String(j === i));
    });
    segs.forEach((s, j) => {
      s.setAttribute("aria-selected", String(j === i));
      s.classList.toggle("done", j < i);
    });
    if (count) count.textContent = `Step ${String(i + 1).padStart(2, "0")} of 05`;
    if (scroll) {
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelector(".hiw-progress")?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    }
  }
  document.querySelectorAll<HTMLElement>("[data-go]").forEach((b) =>
    b.addEventListener("click", () => go(Number(b.dataset.go), b.closest(".hiw-next") != null)),
  );
</script>
