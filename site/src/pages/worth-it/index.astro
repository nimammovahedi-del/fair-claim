---
// Cost calculator. The URL stays /worth-it/ for old links, but the page never says whether to sue:
// it shows what the reader's own numbers add up to, with caveats that are always visible.
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolNotice from "../../components/ToolNotice.astro";
import { states, caStatewide, money } from "../../lib/data";
import { collectPresets } from "../../lib/odds";

const allTiers = (caStatewide.fees?.filing_fee_tiers ?? []) as { applies_to: string; fee: number; citation: string }[];
const caTiers = allTiers.filter((t) => !/more than 12/i.test(t.applies_to)).map((t) => t.fee); // [≤1,500, ≤5,000, above]
const caFrequent = allTiers.find((t) => /more than 12/i.test(t.applies_to));
// Only what the calculator needs, embedded as JSON for the browser script.
const calcStates = states.map((s) => ({
  slug: s.slug,
  name: s.state,
  limitInd: s.limit_individual,
  limitBiz: s.limit_business,
  feeMin: s.filing_fee_min,
  feeMax: s.filing_fee_max,
  limitUnverified: s.unverified.some((f) => /^limit/.test(f)),
  feeUnverified: s.unverified.some((f) => /^filing_fee/.test(f)),
  checked: s.date_checked,
  // Fee by claim amount, where we have a verified schedule (California so far).
  feeTiers: s.slug === "ca" ? caTiers : null,
  tierNote:
    s.slug === "ca" && caFrequent
      ? `Set from your amount (${allTiers[0]?.citation?.replace(/\(b\)\(1\)$/, "")}). It's ${money(caFrequent.fee)} if you filed more than 12 small claims in California in the past 12 months.`
      : null,
}));

const presetValues = collectPresets.map((p) => Math.round(p.value * 100));
---
<Site
  title="Small claims cost calculator"
  description="Put the costs of a small claims case, your time and the chance of getting paid side by side. Arithmetic on your own estimates, not a prediction."
>
  <Breadcrumb items={[{ label: "Cost calculator" }]} />
  <div class="narrow">
    <p class="eyebrow">Calculator</p>
    <h1>Small claims cost calculator</h1>
    <p class="lede">
      Put the money you'd spend, your time and the chance of actually getting paid side by side. It doesn't tell you
      whether to sue. It shows what your own numbers add up to.
    </p>
    <p class="hint">
      Nothing you enter leaves this page. Not sure suing is the right route?{" "}
      <a href="/steps/#before-you-decide">Read about other options first</a>.
    </p>
  </div>

  <script type="application/json" id="calc-states" set:html={JSON.stringify(calcStates)} />

  <ToolNotice
    id="worth-it"
    target="worth-it-tool"
    toolName="the cost calculator"
    extraPoints={["The result is arithmetic on your own guesses. It can't tell you whether you'll win or get paid, or whether you should sue."]}
  />

  <div class="calc" id="worth-it-tool">
    <form id="calc" novalidate aria-describedby="calc-howto">
      <p id="calc-howto" class="hint calc-howto">
        Fill in what you know. Every box has a starting value you can change. Results update as you type.{" "}
        <a class="jump-link" href="#result-title">Skip to the results</a>
      </p>

      <fieldset>
        <legend><span class="legend-num" aria-hidden="true">1</span> Your claim</legend>
        <div class="form-grid">
          <div class="field">
            <label for="state">State</label>
            <select id="state" aria-describedby="state-hint">
              <option value="">Choose a state</option>
              {calcStates.map((s) => <option value={s.slug}>{s.name}</option>)}
            </select>
            <span class="hint" id="state-hint">Sets the court's limit and a typical filing fee.</span>
          </div>
          <div class="field">
            <label for="who">You'd be suing as</label>
            <select id="who" aria-describedby="who-hint">
              <option value="ind">An individual</option>
              <option value="biz">A business</option>
            </select>
            <span class="hint" id="who-hint">Some states set a lower limit for businesses.</span>
          </div>
          <div class="field" data-field="amountOwed">
            <label for="amount">Amount you're owed <span class="req">(required)</span></label>
            <div class="input-affix">
              <span class="affix" aria-hidden="true">$</span>
              <input id="amount" type="text" inputmode="decimal" autocomplete="off" value="2,400" required aria-required="true" aria-describedby="amount-hint" data-money />
            </div>
            <span class="hint" id="amount-hint">Only what you can back up with papers: receipts, a contract, an invoice.</span>
          </div>
          <div class="field">
            <span class="label" id="limit-label">Court limit</span>
            <output id="limit-out" class="limit-out" for="state who" aria-labelledby="limit-label">Choose a state</output>
            <span id="limit-note" class="hint"></span>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend><span class="legend-num" aria-hidden="true">2</span> Money you'd spend</legend>
        <div class="form-grid">
          <div class="field" data-field="filingFee">
            <label for="fee">Filing fee</label>
            <div class="input-affix">
              <span class="affix" aria-hidden="true">$</span>
              <input id="fee" type="text" inputmode="decimal" autocomplete="off" value="50" aria-describedby="fee-hint" data-money />
            </div>
            <span class="hint" id="fee-hint">Paid to the court when you file. Choose a state to fill it in.</span>
          </div>
          <div class="field" data-field="serviceCost">
            <label for="service">Serving the papers</label>
            <div class="input-affix">
              <span class="affix" aria-hidden="true">$</span>
              <input id="service" type="text" inputmode="decimal" autocomplete="off" value="40" aria-describedby="service-hint" data-money />
            </div>
            <span class="hint" id="service-hint">Certified mail by the clerk is often $15–30. A sheriff or process server is often $50–100.</span>
          </div>
          <div class="field" data-field="otherCosts">
            <label for="other">Other costs</label>
            <div class="input-affix">
              <span class="affix" aria-hidden="true">$</span>
              <input id="other" type="text" inputmode="decimal" autocomplete="off" value="0" aria-describedby="other-hint" data-money />
            </div>
            <span class="hint" id="other-hint">Parking, copies, postage, and later collection fees.</span>
          </div>
          <div class="field">
            <label for="recover">Fees added to the judgment if you win?</label>
            <select id="recover" aria-describedby="recover-hint">
              <option value="yes">Yes</option>
              <option value="no">No, or not sure</option>
            </select>
            <span class="hint" id="recover-hint">Judges often add filing and service fees to what the other side owes. Check your state's rules.</span>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend><span class="legend-num" aria-hidden="true">3</span> Your time</legend>
        <div class="form-grid">
          <div class="field" data-field="hours">
            <label for="hours">Hours you'd spend</label>
            <input id="hours" type="text" inputmode="decimal" autocomplete="off" value="12" aria-describedby="hours-hint" />
            <span class="hint" id="hours-hint">Preparing, getting to court, waiting, and collecting afterward.</span>
          </div>
          <div class="field" data-field="hourlyValue">
            <label for="rate">What an hour is worth to you</label>
            <div class="input-affix">
              <span class="affix" aria-hidden="true">$</span>
              <input id="rate" type="text" inputmode="decimal" autocomplete="off" value="0" aria-describedby="rate-hint" data-money />
            </div>
            <span class="hint" id="rate-hint">Leave at 0 to leave time out, or use your hourly pay if you'd lose work.</span>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend><span class="legend-num" aria-hidden="true">4</span> The odds: your own estimate</legend>
        <div class="field">
          <div class="range-row"><label for="win">Chance a judge rules for you</label><output id="win-out" for="win">75%</output></div>
          <input id="win" type="range" min="0" max="100" step="5" value="75" aria-describedby="win-hint" aria-valuetext="75 percent" />
          <span class="hint" id="win-hint">Higher with a strong paper trail (contract, photos, texts, receipts). Lower when it's your word against theirs.</span>
        </div>
        <div class="field range-gap">
          <div class="range-row"><label for="col">Chance you collect if you win</label><output id="col-out" for="col">45%</output></div>
          <input id="col" type="range" min="0" max="100" step="5" value="45" aria-describedby="col-hint" aria-valuetext="45 percent" />
          <div class="presets" role="group" aria-label="Starting points for the chance you collect">
            {collectPresets.map((p, i) => (
              <button type="button" class="chip" data-col={presetValues[i]} aria-pressed="false">{p.label}</button>
            ))}
          </div>
          <span class="hint" id="col-hint">
            The buttons are rough starting points, not research findings.{" "}
            <a href="/sources/#collecting">What studies found about getting paid</a>
          </span>
        </div>
      </fieldset>
    </form>

    <section class="result" aria-labelledby="result-title" tabindex="0">
      <h2 class="result-title" id="result-title" tabindex="-1">What the numbers show</h2>
      <p class="outcome" id="outcome">—</p>
      <p class="result-summary" id="summary"></p>

      <table class="ledger" id="ledger">
        <caption>How it adds up</caption>
        <tbody>
          <tr><th scope="row">You can claim</th><td id="r-claim">—</td></tr>
          <tr><th scope="row">Fees added if you win</th><td id="r-recover">—</td></tr>
          <tr><th scope="row">× Chance a judge rules for you</th><td id="r-win">—</td></tr>
          <tr><th scope="row">× Chance you collect</th><td id="r-col">—</td></tr>
          <tr class="subtotal"><th scope="row">Expected back</th><td id="r-back">—</td></tr>
          <tr><th scope="row">Money spent up front</th><td id="r-up">—</td></tr>
          <tr><th scope="row">Your time</th><td id="r-time">—</td></tr>
          <tr class="total"><th scope="row">Expected net</th><td id="r-net">—</td></tr>
        </tbody>
      </table>
      <p id="r-break" class="hint"></p>
      <div id="r-warn" class="stack"></div>

      <div class="caveats">
        <h3>Keep in mind</h3>
        <ul id="caveats"></ul>
      </div>
      <p class="result-links">
        <a class="link-arrow" href="/steps/#before-you-decide">Options besides going to court</a>
      </p>
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" id="calc-status"></p>
    </section>
  </div>
</Site>

<script>
  import { worthIt, fmt, checkWorthItInput, parseAmount, WORTH_IT_CAVEATS, type WorthItInput } from "../../lib/core/worth-it";

  type S = {
    slug: string; name: string; limitInd: number | null; limitBiz: number | null; feeMin: number | null; feeMax: number | null;
    limitUnverified: boolean; feeUnverified: boolean; checked: string | null; feeTiers: number[] | null; tierNote: string | null;
  };
  const data: S[] = JSON.parse(document.getElementById("calc-states")!.textContent || "[]");
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = (id: string) => $<HTMLInputElement>(id);
  const pct = (id: string) => Number(input(id).value) || 0;

  // Text inputs and the WorthItInput key each one feeds.
  const fields: [string, keyof WorthItInput][] = [
    ["amount", "amountOwed"],
    ["fee", "filingFee"],
    ["service", "serviceCost"],
    ["other", "otherCosts"],
    ["hours", "hours"],
    ["rate", "hourlyValue"],
  ];
  const touched = new Set<string>();
  const hintIds: Record<string, string> = {};
  for (const [id] of fields) hintIds[id] = input(id).getAttribute("aria-describedby") || "";

  // Caveats are the same for every result, so they are written once.
  $("caveats").replaceChildren(...WORTH_IT_CAVEATS.map((c) => Object.assign(document.createElement("li"), { textContent: c })));

  const current = () => data.find((d) => d.slug === $<HTMLSelectElement>("state").value);
  const asText = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 2 });

  function onStateChange() {
    const s = current();
    const hint = $("fee-hint");
    if (s && s.feeMin != null) {
      const top = s.feeMax ?? s.feeMin;
      input("fee").value = asText(top);
      hint.textContent =
        s.feeMin === top
          ? `${s.name}: ${fmt(s.feeMin)}.`
          : `${s.name}: ${fmt(s.feeMin)} to ${fmt(top)}. We filled in the highest; your state page explains which applies.`;
    } else {
      hint.textContent = s ? `We don't have a fee for ${s.name} yet. Ask the court clerk.` : "Paid to the court when you file. Choose a state to fill it in.";
    }
    if (s?.feeUnverified) hint.append(" ", badge());
    tierFee(s);
    update();
  }

  function badge() {
    const b = document.createElement("span");
    b.className = "badge unverified";
    b.textContent = "Unverified";
    return b;
  }

  function tierFee(s: S | undefined) {
    if (!s?.feeTiers || s.feeTiers.length < 3) return;
    const a = parseAmount(input("amount").value);
    if (a == null || Number.isNaN(a)) return;
    const fee = a <= 1500 ? s.feeTiers[0] : a <= 5000 ? s.feeTiers[1] : s.feeTiers[2];
    input("fee").value = asText(fee);
    if (s.tierNote) $("fee-hint").textContent = s.tierNote;
  }

  function readInputs() {
    const raw: Partial<Record<keyof WorthItInput, number | null>> = {};
    for (const [id, key] of fields) raw[key] = parseAmount(input(id).value);
    return raw;
  }

  function showErrors(errors: Partial<Record<keyof WorthItInput, string>>, all = false) {
    for (const [id, key] of fields) {
      const el = input(id);
      const field = el.closest<HTMLElement>(".field")!;
      const msg = errors[key];
      const show = msg && (all || touched.has(id));
      const errId = `${id}-error`;
      let p = document.getElementById(errId);
      if (show) {
        if (!p) {
          p = document.createElement("p");
          p.className = "error-text";
          p.id = errId;
          field.appendChild(p);
        }
        p.textContent = msg!;
        field.classList.add("has-error");
        el.setAttribute("aria-invalid", "true");
        el.setAttribute("aria-describedby", `${errId} ${hintIds[id]}`.trim());
      } else {
        p?.remove();
        field.classList.remove("has-error");
        el.removeAttribute("aria-invalid");
        el.setAttribute("aria-describedby", hintIds[id]);
      }
    }
  }

  let statusTimer: number | undefined;
  let ready = false; // don't announce the starting numbers on page load
  function announce(text: string) {
    // Wait until typing pauses so screen readers hear one summary, not one per keystroke.
    window.clearTimeout(statusTimer);
    if (!ready) return;
    statusTimer = window.setTimeout(() => ($("calc-status").textContent = text), 900);
  }

  function setLedger(values: Record<string, string>) {
    for (const [id, v] of Object.entries(values)) $(id).textContent = v;
  }

  function update() {
    const s = current();
    const biz = $<HTMLSelectElement>("who").value === "biz";
    const limit = s ? (biz ? s.limitBiz ?? s.limitInd : s.limitInd) : null;

    // Court limit
    $("limit-out").textContent = s ? (limit != null ? fmt(limit) : "Not confirmed yet") : "Choose a state";
    const note = $("limit-note");
    note.replaceChildren();
    if (s) {
      if (s.limitUnverified) note.append(badge(), " ");
      const a = document.createElement("a");
      a.href = `/states/${s.slug}/`;
      a.textContent = `${s.name} small claims rules`;
      note.append(a, s.checked ? ` · checked ${s.checked}` : "");
    }

    // Sliders
    for (const id of ["win", "col"]) {
      $(`${id}-out`).textContent = `${pct(id)}%`;
      input(id).setAttribute("aria-valuetext", `${pct(id)} percent`);
    }
    document.querySelectorAll<HTMLButtonElement>(".chip[data-col]").forEach((b) =>
      b.setAttribute("aria-pressed", String(Number(b.dataset.col) === pct("col"))),
    );

    // Validate
    const raw = readInputs();
    const errors = checkWorthItInput(raw);
    showErrors(errors);
    const result = $("worth-it-tool").querySelector<HTMLElement>(".result")!;
    if (Object.keys(errors).length) {
      result.classList.add("is-stale");
      $("outcome").textContent = "Check the highlighted boxes";
      $("summary").textContent = "The numbers will show here once every box has a usable value.";
      setLedger({ "r-claim": "—", "r-recover": "—", "r-win": "—", "r-col": "—", "r-back": "—", "r-up": "—", "r-time": "—", "r-net": "—" });
      $("r-break").textContent = "";
      $("r-warn").replaceChildren();
      const n = Object.keys(errors).length;
      announce(`${n} ${n === 1 ? "box needs" : "boxes need"} a fix before the numbers can update.`);
      return;
    }
    result.classList.remove("is-stale");

    const r = worthIt({
      amountOwed: raw.amountOwed ?? 0,
      limit: s ? limit : null,
      filingFee: raw.filingFee ?? 0,
      serviceCost: raw.serviceCost ?? 0,
      otherCosts: raw.otherCosts ?? 0,
      chanceWin: pct("win") / 100,
      chanceCollect: pct("col") / 100,
      costsRecoverable: $<HTMLSelectElement>("recover").value === "yes",
      hours: raw.hours ?? 0,
      hourlyValue: raw.hourlyValue ?? 0,
    });

    const costs = r.upfront + r.timeCost;
    setLedger({
      "r-claim": fmt(r.claimable),
      "r-recover": r.recoverable ? `+${fmt(r.recoverable)}` : fmt(0),
      "r-win": `${pct("win")}%`,
      "r-col": `${pct("col")}%`,
      "r-back": fmt(r.expectedBack),
      "r-up": `−${fmt(r.upfront)}`,
      "r-time": r.timeCost ? `−${fmt(r.timeCost)}` : "Not counted",
      "r-net": (r.net < 0 ? "−" : "") + fmt(Math.abs(r.net)),
    });
    $("outcome").textContent = r.outcomeLabel;
    const summary = `On average, cases with these numbers would bring back about ${fmt(r.expectedBack)}, against ${fmt(costs)} in costs${
      r.timeCost ? " and time" : ""
    }.${r.timeCost ? "" : " Your time isn't counted. Add what an hour is worth to you to include it."}`;
    $("summary").textContent = summary;

    $("r-break").textContent =
      r.breakEvenCollect == null
        ? ""
        : r.breakEvenCollect > 1
          ? "Even with a 100% chance of collecting, the costs above would be more than what you'd get back."
          : `The costs and the expected recovery are equal when the chance of collecting is about ${Math.ceil(r.breakEvenCollect * 100)}%.`;

    const w = $("r-warn");
    w.replaceChildren();
    const warnings = s ? r.warnings : r.warnings.filter((x) => !x.startsWith("We don't have"));
    for (const msg of warnings) {
      const d = document.createElement("div");
      d.className = "callout warning";
      const p = document.createElement("p");
      p.textContent = msg;
      d.appendChild(p);
      w.appendChild(d);
    }
    announce(`${r.outcomeLabel}. ${summary}${warnings.length ? ` ${warnings.length} note${warnings.length > 1 ? "s" : ""} below.` : ""}`);
  }

  // Events
  $("state").addEventListener("change", onStateChange);
  $("who").addEventListener("change", update);
  $("recover").addEventListener("change", update);
  for (const id of ["win", "col"]) input(id).addEventListener("input", update);
  document.querySelectorAll<HTMLButtonElement>(".chip[data-col]").forEach((b) =>
    b.addEventListener("click", () => {
      input("col").value = b.dataset.col!;
      update();
    }),
  );
  for (const [id] of fields) {
    const el = input(id);
    el.addEventListener("input", () => {
      if (id === "amount") tierFee(current());
      update();
    });
    // Errors appear once the reader leaves a box, then update live while they fix it.
    el.addEventListener("blur", () => {
      touched.add(id);
      const v = parseAmount(el.value);
      if (el.hasAttribute("data-money") && v != null && !Number.isNaN(v) && v >= 0) el.value = asText(v);
      update();
    });
  }
  $("calc").addEventListener("submit", (e) => {
    e.preventDefault();
    for (const [id] of fields) touched.add(id);
    update();
    const first = $("calc").querySelector<HTMLElement>("[aria-invalid='true']");
    first?.focus();
  });

  // Pre-select from ?state=xx
  const qs = new URLSearchParams(location.search).get("state");
  if (qs && data.some((d) => d.slug === qs)) $<HTMLSelectElement>("state").value = qs;
  onStateChange();
  ready = true;
</script>
