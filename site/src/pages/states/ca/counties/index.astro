---
// California counties (Option A): free help first, then a filterable table of all 58.
import Site from "../../../../layouts/Site.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import TableFilter from "../../../../components/TableFilter.astro";
import UnverifiedNote from "../../../../components/UnverifiedNote.astro";
import Term from "../../../../components/Term.astro";
import "../../../../styles/states.css";
import { counties, yesNoLabel } from "../../../../lib/data";

const uv = (c: (typeof counties)[number], prefix: string) => c.unverified.some((f) => f === prefix || f.startsWith(prefix + "."));
const withUnverified = counties.filter((c) => c.unverified.length).length;
const latest = counties.map((c) => c.date_checked).filter(Boolean).sort().at(-1);
const efileYes = counties.filter((c) => c.e_filing === "yes").length;
const advisorSrc = "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CCP&sectionNum=116.940";
---
<Site
  title="California small claims by county"
  description="Free small claims advisors, self-help centers, courthouses and online options for all 58 California counties."
  color="c-states"
  bleed
>
  <section class="wrap sr-hero">
    <Breadcrumb items={[{ href: "/states/", label: "State rules" }, { href: "/states/ca/", label: "California" }, { label: "Counties" }]} />
    <div class="sr-title-row">
      <h1 class="display sr-title is-long">California, county by county</h1>
      <div class="sr-meta">
        <p class="small muted">Rules and fees are the same statewide. Free help and courthouses differ.</p>
        <p class="cite"><span>Checked {latest}</span><a href="/states/ca/">Statewide rules</a><a href="/sources/">How we check</a></p>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="help-title">
    <div class="stats sr-stats-lite sr-stats">
      <div class="stat c-states">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="num word">Free</p>
        <div>
          <p class="s-label" id="help-title">Help from a <Term slug="small-claims-advisor" /></p>
          <p class="s-sub">Every court must offer it; very small courts may run a reduced program.</p>
        </div>
        <p class="cite"><a href={advisorSrc} rel="noopener">CCP 116.940(c)</a></p>
      </div>
      <div class="stat c-sage">
        <span class="s-bar" aria-hidden="true"></span>
        <p class="num">{efileYes}</p>
        <div><p class="s-label">of {counties.length} counties take filings online</p><p class="s-sub">From each court's website.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="table-title" style="padding-top:clamp(36px,4vw,56px)">
    <div class="sec-head">
      <p class="lbl">All counties</p>
      <div>
        <h2 id="table-title" class="h2">Find your county.</h2>
      </div>
    </div>
    <div class="tbl-tools">
      <TableFilter table="counties-table" label="Find a county" noun="counties" placeholder="Fresno" />
      <UnverifiedNote compact count={withUnverified} of="counties have an unverified detail" />
    </div>
    <div class="table-scroll">
      <table class="table-stack sr-table sr-cty" id="counties-table">
        <caption class="sr-only">Free help and court access in {counties.length} California counties</caption>
        <thead>
          <tr>
            <th scope="col">County</th>
            <th scope="col">Free advisor</th>
            <th scope="col" class="num">Courthouses</th>
            <th scope="col">File online</th>
            <th scope="col">Remote hearings</th>
          </tr>
        </thead>
        <tbody>
          {counties.map((c) => (
            <tr data-filter={c.county.toLowerCase()}>
              <th scope="row"><a href={`/states/ca/counties/${c.slug}/`}>{c.county}</a></th>
              <td data-label="Free advisor" class="adv-cell">
                {c.small_claims_advisor?.provider ?? "Not found yet"}
                {uv(c, "small_claims_advisor") && <span class="badge unverified">Unverified</span>}
              </td>
              <td class="num c-n" data-label="Courts">
                {c.small_claims_locations.length || "—"}
                {uv(c, "small_claims_locations") && <span class="badge unverified">Unverified</span>}
              </td>
              <td class="c-n" data-label="File online">
                {yesNoLabel[c.e_filing ?? ""] ?? c.e_filing ?? "—"}
                {uv(c, "e_filing") && <span class="badge unverified">Unverified</span>}
              </td>
              <td class="c-n" data-label="Remote">
                {yesNoLabel[c.remote_hearings ?? ""] ?? c.remote_hearings ?? "—"}
                {uv(c, "remote_hearings") && <span class="badge unverified">Unverified</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="callout" data-filter-empty="counties-table" hidden>No county matches that. Check the spelling, or clear the box to see all 58.</p>
  </section>
</Site>

<style>
  .tbl-tools {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 8px 24px;
    align-items: start;
  }
  .tbl-tools :global(.unverified-note) {
    margin: 0;
  }
  .adv-cell {
    max-width: 36ch;
    color: var(--ink-2);
  }
  /* Two stats here, not four */
  .stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 860px) {
    .tbl-tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .adv-cell {
      display: -webkit-box !important;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }
  }
</style>
