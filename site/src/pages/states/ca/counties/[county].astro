---
import Site from "../../../../layouts/Site.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import UnverifiedNote from "../../../../components/UnverifiedNote.astro";
import { counties, yesNoLabel, sourceLinkText, sourceTypeLabel, humanizeFields, type CountyRow } from "../../../../lib/data";

export function getStaticPaths() {
  return counties.map((c) => ({ params: { county: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: CountyRow };
const u = (prefix: string) => c.unverified.some((f) => f === prefix || f.startsWith(prefix + "."));
const adv = c.small_claims_advisor;
const shc = c.self_help_center;
// Only make a tap-to-call link when the text is a single 10-digit US number.
const telHref = (p?: string) => (p && /^\D*\d{3}\D*\d{3}\D*\d{4}\D*$/.test(p) ? `tel:+1${p.replace(/\D/g, "")}` : null);
const advTel = telHref(adv?.phone);
const shcTel = telHref(shc?.phone);
---
<Site
  title={`Small claims in ${c.county} County, California`}
  description={`Free small claims help in ${c.county} County, where cases are heard, and what you can do online.`}
>
  <Breadcrumb items={[{ href: "/states/", label: "States" }, { href: "/states/ca/", label: "California" }, { href: "/states/ca/counties/", label: "Counties" }, { label: c.county }]} />
  <div class="narrow">
    <p class="eyebrow">{c.court_name}</p>
    <h1>Small claims in {c.county} County</h1>
    <p class="lede">
      Where to get free help, where cases are heard, and what you can do online. Limits, fees and forms are the same
      everywhere in California.
    </p>
    <p class="cite"><span>checked {c.date_checked}</span></p>
  </div>

  <div class="two-col">
    <div>
      <section aria-labelledby="free-help">
        <h2 id="free-help">Free help</h2>
        <p>
          These offices can explain the forms, the steps and local practices. Small claims advisor help is free; a few
          very small courts can offer a reduced program instead. <span class="cite">Cal. Code Civ. Proc. § 116.940(c)</span>
        </p>
        <div class="grid cols-2 help-grid">
          <div class="card help-card">
            <p class="card-detail">Small claims advisor</p>
            <h3>
              {adv?.provider ?? "Not found yet"}
              {u("small_claims_advisor") && <> <span class="badge unverified">Unverified</span></>}
            </h3>
            {adv ? (
              <>
                {adv.free !== false && <p><span class="tag small">Free</span></p>}
                {adv.format && <p>{adv.format}</p>}
                <ul class="contact-list">
                  {adv.phone && <li><span class="contact-label">Phone</span> {advTel ? <a href={advTel}>{adv.phone}</a> : adv.phone}</li>}
                  {adv.email && <li><span class="contact-label">Email</span> <a href={`mailto:${adv.email}`}>{adv.email}</a></li>}
                </ul>
                {adv.url && <p><a class="link-arrow" href={adv.url} rel="noopener">{c.county} County small claims advisor website</a></p>}
                {adv.notes && <p class="hint">{adv.notes}</p>}
              </>
            ) : (
              <p>We haven't found a named advisor program yet. Ask the court's self-help center or clerk.</p>
            )}
          </div>

          <div class="card help-card">
            <p class="card-detail">Self-help center</p>
            <h3>
              {shc?.name ?? "Not found yet"}
              {u("self_help_center") && <> <span class="badge unverified">Unverified</span></>}
            </h3>
            {shc ? (
              <>
                <ul class="contact-list">
                  {shc.address && <li><span class="contact-label">Address</span> {shc.address}</li>}
                  {shc.phone && <li><span class="contact-label">Phone</span> {shcTel ? <a href={shcTel}>{shc.phone}</a> : shc.phone}</li>}
                </ul>
                {shc.url && <p><a class="link-arrow" href={shc.url} rel="noopener">{c.county} County self-help center website</a></p>}
                {shc.notes && <p class="hint">{shc.notes}</p>}
              </>
            ) : (
              <p>We haven't found it yet. The <a href="https://selfhelp.courts.ca.gov/" rel="noopener">California Courts self-help guide</a> lists every center.</p>
            )}
          </div>
        </div>
      </section>

      <UnverifiedNote count={c.unverified.length} of={c.unverified.length === 1 ? "detail on this page is unverified" : "details on this page are unverified"} />

      <section aria-labelledby="where">
        <h2 id="where">
          Where cases are heard
          {u("small_claims_locations") && <> <span class="badge unverified">Unverified</span></>}
        </h2>
        {c.small_claims_locations.length ? (
          <ul class="loc-list">
            {c.small_claims_locations.map((l) => (
              <li class="loc">
                <strong>{l.name}</strong>
                <span class="loc-address">{l.address}</span>
                {l.notes && <span class="hint">{l.notes}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p>Not found yet. The court's small claims page should list it.</p>
        )}
      </section>

      <section aria-labelledby="online">
        <h2 id="online">Online and remote options</h2>
        <dl class="facts">
          <div class="fact">
            <dt>File online {u("e_filing") && <span class="badge unverified">Unverified</span>}</dt>
            <dd>
              <div class="value">{yesNoLabel[c.e_filing ?? ""] ?? c.e_filing ?? "—"}</div>
              {c.e_filing_notes && <div class="hint">{c.e_filing_notes}</div>}
            </dd>
          </div>
          <div class="fact">
            <dt>Remote hearings {u("remote_hearings") && <span class="badge unverified">Unverified</span>}</dt>
            <dd><div class="value">{yesNoLabel[c.remote_hearings ?? ""] ?? c.remote_hearings ?? "—"}</div></dd>
          </div>
          {c.local_notes && (
            <div class="fact">
              <dt>Local details {u("local_notes") && <span class="badge unverified">Unverified</span>}</dt>
              <dd><div class="value">{c.local_notes}</div></dd>
            </div>
          )}
        </dl>
        {c.notes && <p class="hint"><strong>Research note:</strong> {c.notes}</p>}
      </section>

      <section aria-labelledby="sources">
        <h2 id="sources">Sources</h2>
        <ul class="source-list">
          {c.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">{sourceLinkText(s.url)}</a>
              {s.type && <span class="tag small">{sourceTypeLabel[s.type] ?? s.type}</span>}
              {s.what && <div class="hint">Used for: {humanizeFields(s.what)}</div>}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="aside state-aside" aria-label={`${c.county} County quick links`}>
      <div class="card tinted">
        <h2>Statewide rules</h2>
        <p>Limits, fees, forms and appeal rules are the same in every California county.</p>
        <ul class="link-list">
          <li><a href="/states/ca/">California small claims rules</a></li>
          {c.small_claims_page_url && <li><a href={c.small_claims_page_url} rel="noopener">{c.county} County court's small claims page</a></li>}
          <li><a href="/states/ca/counties/">All 58 counties</a></li>
        </ul>
      </div>
      <div class="card">
        <h2>Guides and tools</h2>
        <ul class="link-list">
          <li><a href="/steps/#before-you-decide">Options besides going to court</a></li>
          <li><a href="/steps/">How a small claims case works</a></li>
          <li><a href="/worth-it/?state=ca">Cost calculator for California</a></li>
          <li><a href="/demand-letter/">Demand-letter tool</a></li>
        </ul>
      </div>
    </aside>
  </div>
</Site>
