---
// State rules hub (Option A): a big "Which state?" with the location search (ZIP, city, county or state),
// then the table of all 50 states and DC (#all-states), which also works without JavaScript.
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import LocationSearch from "../../components/LocationSearch.astro";
import TableFilter from "../../components/TableFilter.astro";
import UnverifiedNote from "../../components/UnverifiedNote.astro";
import "../../styles/states.css";
import { states, money, feeRange, lawyersLabel, appealLabel, efileLabel, isUnverified } from "../../lib/data";
const unv = (s: (typeof states)[number], ...f: string[]) => isUnverified(s, ...f);
const shownFields = ["limit_individual", "limit_business", "filing_fee_min", "filing_fee_max", "lawyers_allowed", "appeal_who", "e_filing"];
const withUnverified = states.filter((s) => unv(s, ...shownFields)).length;
const latest = states.map((s) => s.date_checked).filter(Boolean).sort().at(-1);
---
<Site
  title="Small claims rules by state"
  description="Limits, fees, lawyers and appeal rules for small claims court in all 50 states and DC, each with a source and the date it was checked."
  color="c-states"
  bleed
>
  <section class="wrap sr-hero">
    <Breadcrumb items={[{ label: "State rules" }]} />
    <div class="pick-row">
      <div>
        <h1 class="display sr-title">Which state?</h1>
        <p class="lede pick-lede">Limits, fees and appeal rules for all 50 states and DC. Each one has a source and a date.</p>
      </div>
      <div class="pick">
        <LocationSearch label="Your ZIP code, city, county or state" stateHref="#all-states" />
      </div>
    </div>
  </section>

  <section class="wrap tbl-sec" id="all-states" aria-labelledby="table-title">
    <div class="tbl-head">
      <div class="tbl-title">
        <h2 id="table-title" class="h2">All 50 states and DC, side by side.</h2>
        <p class="tbl-lede">Open a state for the details and the sources. Where a state has more than one kind of court, this shows the main limit.</p>
      </div>
      {states.length > 0 && (
        <div class="tbl-filter">
          <TableFilter table="states-table" label="Filter" noun="rows" placeholder="Ohio or OH" />
        </div>
      )}
    </div>

    {states.length === 0 ? (
      <div class="callout warning"><p>Research data hasn't been merged yet. Run <code>scripts/build_tables.py</code>.</p></div>
    ) : (
      <>
        <p class="tbl-note">
          <span class="tbl-note-date">All checked {latest}</span>
          {withUnverified > 0 && (
            <span>
              <span class="badge unverified">Unverified</span> {withUnverified} states have a value we haven't confirmed in the law or on the court's site yet. Check with the court.{" "}
              <a href="/sources/#unverified">How we check</a>
            </span>
          )}
          <a class="tbl-note-ca" href="/states/ca/counties/">California by county</a>
        </p>
        <div class="table-scroll">
          <table class="table-stack sr-table sr-big" id="states-table">
            <caption class="sr-only">Small claims basics for all 50 states and DC</caption>
            <thead>
              <tr>
                <th scope="col">State</th>
                <th scope="col" class="num">Limit</th>
                <th scope="col" class="num">Business limit</th>
                <th scope="col">Filing fee</th>
                <th scope="col">Lawyers</th>
                <th scope="col">Who can appeal</th>
                <th scope="col">File online</th>
              </tr>
            </thead>
            <tbody>
              {states.map((s) => (
                <tr data-filter={`${s.state} ${s.abbr}`.toLowerCase()}>
                  <th scope="row">
                    <a href={`/states/${s.slug}/`}>{s.state}</a>
                    {s.slug === "ca" && <a class="row-extra" href="/states/ca/counties/">By county</a>}
                  </th>
                  <td class="num lim" data-label="Limit">
                    {money(s.limit_individual)}
                    {unv(s, "limit_individual") && <span class="badge unverified">Unverified</span>}
                  </td>
                  <td class:list={["num", { quiet: !(s.limit_business != null && s.limit_business !== s.limit_individual) }]} data-label="Business limit">
                    {s.limit_business != null && s.limit_business !== s.limit_individual ? money(s.limit_business) : "Same"}
                    {unv(s, "limit_business") && <span class="badge unverified">Unverified</span>}
                  </td>
                  <td data-label="Filing fee">
                    {feeRange(s)}
                    {unv(s, "filing_fee_min", "filing_fee_max") && <span class="badge unverified">Unverified</span>}
                  </td>
                  <td data-label="Lawyers">
                    {lawyersLabel[s.lawyers_allowed ?? ""] ?? s.lawyers_allowed ?? "—"}
                    {unv(s, "lawyers_allowed") && <span class="badge unverified">Unverified</span>}
                  </td>
                  <td data-label="Who can appeal">
                    {appealLabel[s.appeal_who ?? ""] ?? s.appeal_who ?? "—"}
                    {unv(s, "appeal_who") && <span class="badge unverified">Unverified</span>}
                  </td>
                  <td data-label="File online">
                    {efileLabel[s.e_filing ?? ""] ?? s.e_filing ?? "Not found"}
                    {unv(s, "e_filing") && <span class="badge unverified">Unverified</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="callout" data-filter-empty="states-table" hidden>No state matches that. Try the full name or the two-letter abbreviation.</p>
      </>
    )}
  </section>
</Site>

<style>
  .sr-hero {
    padding-bottom: clamp(28px, 3vw, 40px);
  }
  .pick-row {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 64px;
    align-items: end;
  }
  .pick-lede {
    margin-top: 24px;
  }
  .pick {
    padding-bottom: 6px;
  }
  /* Table head: title on the left, a compact filter on the right, on one line */
  .tbl-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
    gap: 16px 48px;
    align-items: end;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .tbl-title > * {
    margin: 0;
  }
  .tbl-lede {
    margin-top: 12px !important;
    max-width: 60ch;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .tbl-filter :global(.table-filter) {
    margin: 0;
    max-width: none;
    gap: 6px;
  }
  .tbl-filter :global(.field) {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 20px;
    border-radius: 999px;
  }
  .tbl-filter :global(.field > label) {
    margin: 0;
    padding: 0;
    font-family: var(--f-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tbl-filter :global(.field input) {
    font-family: var(--f-body);
    font-size: 18px;
    letter-spacing: 0;
  }
  /* The count stays for screen readers; on screen the table itself shows the result. */
  .tbl-filter :global(.table-filter-count) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tbl-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 24px;
    margin: 20px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .tbl-note .badge {
    margin-right: 4px;
  }
  .tbl-note a {
    color: var(--ink);
  }
  .tbl-note-date {
    font-family: var(--f-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tbl-note-ca {
    margin-left: auto;
  }
  @media (max-width: 860px) {
    .pick-row,
    .tbl-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .tbl-note-ca {
      margin-left: 0;
    }
  }
</style>
