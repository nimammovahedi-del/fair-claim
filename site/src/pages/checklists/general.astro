---
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ChecklistDoc from "../../components/ChecklistDoc.astro";
---
<Site title="Checklists: general version" description="Printable small claims checklists for any state: before you decide, demand letter, filing, serving, the hearing and collecting." bleed color="c-checklists">
  <div class="checklist-page">
    <section class="wrap page-hero">
      <Breadcrumb items={[{ href: "/tools/", label: "Tools" }, { href: "/checklists/", label: "Checklists" }, { label: "General" }]} />
      <h1 class="display">Small claims checklists</h1>
      <p class="lede">General version, for any state. <span class="no-print"><a href="/checklists/">Choose your state</a> to fill in its limit, fees and deadlines.</span></p>
    </section>
    <div class="wrap">
      <ChecklistDoc />
    </div>
  </div>
</Site>
