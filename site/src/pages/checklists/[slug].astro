---
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ChecklistDoc from "../../components/ChecklistDoc.astro";
import { states, type StateRow } from "../../lib/data";

export function getStaticPaths() {
  return states.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: StateRow };
const nUnverified = s.unverified?.length ?? 0;
---
<Site title={`Checklists: ${s.state}`} description={`Printable small claims checklists for ${s.state}, with the state's cited limit, fees, service rules and appeal deadline.`} bleed color="c-checklists">
  <div class="checklist-page">
    <section class="wrap page-hero">
      <Breadcrumb items={[{ href: "/tools/", label: "Tools" }, { href: "/checklists/", label: "Checklists" }, { label: s.state }]} />
      <h1 class="display">Checklists: {s.state}</h1>
      <p class="lede">Six short lists with {s.state}'s rules filled in. <span class="no-print">Sources are on the <a href={`/states/${s.slug}/`}>{s.state} page</a>.</span></p>
      <p class="cite" style="margin-top:20px">
        <span>Rules checked {s.date_checked}</span>
        {nUnverified > 0 && <span><span class="badge unverified">unverified</span> = not yet confirmed; check it with the court</span>}
      </p>
    </section>
    <div class="wrap">
      <ChecklistDoc state={s} />
    </div>
  </div>
</Site>
