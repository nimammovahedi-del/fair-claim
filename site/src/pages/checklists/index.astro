---
// Checklists index (Option A): 01 find your state (location search: ZIP, city, county or state goes to
// /checklists/{state}/), 02 pick a step (cards, general version). "Every state's checklists" (#all-checklists)
// links every state and works without JavaScript.
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import LocationSearch from "../../components/LocationSearch.astro";
import "../../styles/features.css";
import { states } from "../../lib/data";
import { statesChecked } from "../../lib/stats";

const lists = [
  { n: "00", id: "before", title: "Before you decide", text: "The limit, the deadline to sue, the costs, whether they could pay, other routes.", items: 8 },
  { n: "01", id: "demand", title: "Ask for payment in writing", text: "Their legal name, the amount and a deadline, sent a way you can prove.", items: 5 },
  { n: "02", id: "file", title: "File the claim", text: "The right form and court, the exact name to sue, the fee or a fee waiver.", items: 5 },
  { n: "03", id: "serve", title: "Serve the papers", text: "Allowed methods, the deadline before the hearing, proof of service.", items: 4 },
  { n: "04", id: "hearing", title: "Go to the hearing", text: "Evidence in three copies, witnesses, a short summary, postponing.", items: 7 },
  { n: "05", id: "collect", title: "Collect what you won", text: "The appeal period, asking for payment, finding assets, collection tools.", items: 6 },
];
---
<Site title="Checklists" description="Printable small claims checklists for each step, with your state's cited rules filled in." bleed color="c-checklists">
  <section class="wrap page-hero">
    <Breadcrumb items={[{ href: "/tools/", label: "Tools" }, { label: "Checklists" }]} />
    <div class="cl-top">
      <h1 class="display">Printable checklists</h1>
      <p class="lede">What to gather and do at each step. Pick a state to fill in its limit, fees and deadlines.</p>
    </div>
  </section>

  <section class="wrap cl-q" aria-labelledby="cq-state">
    <p class="cl-q-n">01 / 02</p>
    <div>
      <div class="cl-q-head">
        <h2 class="h2" id="cq-state">Which state are you in?</h2>
        <p>Opens all six lists with that state's limit, fees and deadlines filled in.</p>
      </div>
      <LocationSearch label="Your ZIP code, city, county or state" target="checklists" stateHref="#all-checklists" />
    </div>
  </section>

  <section class="wrap cl-q" aria-labelledby="cq-step">
    <p class="cl-q-n">02 / 02</p>
    <div>
      <div class="cl-q-head">
        <h2 class="h2" id="cq-step">Which step do you need?</h2>
        <p>Six lists, general version. Tick boxes on screen or print them; ticks aren't saved.</p>
      </div>
      <ul class="cl-cards">
        {lists.map((l) => (
          <li>
            <a class="clc" href={`/checklists/general/#${l.id}`}>
              <span class="clc-band" aria-hidden="true"></span>
              <span class="clc-top"><span class="clc-n" aria-hidden="true">{l.n}</span><span class="lbl">{l.items} items</span></span>
              <span class="clc-t">{l.title}</span>
              <span class="clc-d">{l.text}</span>
              <span class="clc-go"><span>General version</span><span class="door-arrow" aria-hidden="true"></span></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="cl-open">
        <a class="btn" href="/checklists/general/">Open all six</a>
        <p class="hint">Rules checked {statesChecked}. Printing leaves out the menus and adds that date at the foot.</p>
      </div>
    </div>
  </section>

  <section class="wrap cl-q" aria-labelledby="cq-all">
    <p class="cl-q-n">More</p>
    <div>
      <details class="acc" id="all-checklists">
        <summary id="cq-all">Every state's checklists</summary>
        <div class="acc-body">
          <ul class="state-links">
            {states.map((s) => <li><a href={`/checklists/${s.slug}/`}>{s.state}</a></li>)}
          </ul>
        </div>
      </details>
      <p class="note-strip cl-note">
        <span class="lbl">Please note</span>
        <span>General information, not legal advice, and not every situation is covered. Confirm deadlines and fees with your court. <a href="/about/#not-advice">Where to get free help</a>.</span>
      </p>
    </div>
  </section>
</Site>

<script>
  // "Or pick your state" links here: open the list when it's the target.
  function openList() {
    const d = document.getElementById("all-checklists") as HTMLDetailsElement | null;
    if (d && location.hash === "#all-checklists") d.open = true;
  }
  openList();
  window.addEventListener("hashchange", openList);
</script>
