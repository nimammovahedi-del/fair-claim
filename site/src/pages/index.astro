---
import Site from "../layouts/Site.astro";
import { steps } from "../lib/steps";
import { states, money } from "../lib/data";
import { odds } from "../lib/odds";
---
<Site title="Fair Claim">
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Small claims court, honestly</p>
        <h1>Should you sue? Here's the straight answer — and the steps if you do.</h1>
        <p class="lede">
          Small claims court is built for people without lawyers. Fair Claim walks you through it in five steps, shows
          your state's rules with a link to the law behind each one, and is upfront about the part most guides skip:
          getting paid after you win.
        </p>
        <form class="state-picker" action="/states/" method="get" onsubmit="event.preventDefault(); if (this.s.value) location.href='/states/' + this.s.value + '/';">
          <label class="sr-only" for="s">Your state</label>
          <select id="s" name="s">
            <option value="">Choose your state…</option>
            {states.map((s) => <option value={s.slug}>{s.state}</option>)}
          </select>
          <button class="btn" type="submit">See the rules</button>
        </form>
      </div>
      <aside class="card">
        <p class="eyebrow">The part other guides skip</p>
        <div class="stat">{odds.headline.stat}</div>
        <p>{odds.headline.text}</p>
        <p class="cite">
          {odds.headline.unverified && <span class="badge unverified">unverified</span>}
          <a href={odds.headline.url}>{odds.headline.sourceLabel}</a>
        </p>
      </aside>
    </div>
  </section>

  <h2>The five steps</h2>
  <ol class="strip">
    {steps.map((s) => (
      <li>
        <span class="n">Step {s.n}</span>
        <a class="t" href={`/steps/#${s.slug}`}>{s.title}</a>
        <span class="d">{s.short}</span>
      </li>
    ))}
  </ol>

  <div class="grid">
    <a class="card card-link" href="/worth-it/">
      <h3>Is it worth it?</h3>
      <p>Put in the amount, your state's fees, and the odds of collecting. See what you can realistically expect back.</p>
      <span class="go">Open the calculator →</span>
    </a>
    <a class="card card-link" href="/demand-letter/">
      <h3>Write a demand letter</h3>
      <p>Step one. A calm, clear letter that often gets you paid without court. Runs in your browser; we store nothing.</p>
      <span class="go">Write a letter →</span>
    </a>
    <a class="card card-link" href="/states/ca/">
      <h3>California, county by county</h3>
      <p>Courthouses, self-help centers and free small claims advisor help in all 58 counties.</p>
      <span class="go">California rules →</span>
    </a>
  </div>

  <h2>Who this is for</h2>
  <div class="grid">
    <div class="card">
      <h3>Tenants</h3>
      <p>Your landlord kept your security deposit without a fair reason. This is one of the most common small claims cases, and many states add a penalty for deposits kept in bad faith.</p>
    </div>
    <div class="card">
      <h3>Customers</h3>
      <p>A contractor took a deposit and vanished, a shop won't refund a faulty product, or a repair made things worse.</p>
    </div>
    <div class="card">
      <h3>Small businesses &amp; freelancers</h3>
      <p>A client won't pay an invoice. Note that some states set a lower limit for businesses, or limit how often a business can file.</p>
    </div>
  </div>

  <div class="callout">
    <p>
      <strong>Being sued instead?</strong> A guide for people who've been sued — most often by a debt collector — is
      planned for a later version. Until then, don't ignore the papers: missing your court date usually means losing
      automatically. Your state's court self-help page (linked on every state page) explains how to respond.
    </p>
  </div>
</Site>
