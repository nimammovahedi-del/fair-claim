---
// Landing page: one statement, a location search, three doors, the five steps at a glance,
// one key number and the limits map as a small door into State rules. Keep the text to a minimum; neutral:
// information, not encouragement to sue. The full charts live on /about/.
import Site from "../layouts/Site.astro";
import LocationSearch from "../components/LocationSearch.astro";
import TileMapLimits from "../components/TileMapLimits.astro";
import "../styles/features.css";
import { denver, evidenceChecked, upcomingRows } from "../lib/stats";
import { steps } from "../lib/steps";

const doors = [
  {
    href: "/steps/",
    c: "c-learn",
    key: "A",
    title: "Learn how it works",
    text: "Five steps, from asking to collecting.",
    foot: "Steps · Before you decide",
  },
  {
    href: "/states/",
    c: "c-states",
    key: "B",
    title: "Look up your state's rules",
    text: "Limits, fees and deadlines, each with its source.",
    foot: "50 states + DC",
  },
  {
    href: "/tools/",
    c: "c-tools",
    key: "C",
    title: "Use a tool",
    text: "Cost calculator, demand letter, checklists.",
    foot: "Nothing you type is stored",
  },
];

// One or two words per step. Anchors are the step slugs on /steps/.
const stepWords: Record<string, string> = {
  demand: "Ask in writing",
  file: "File",
  serve: "Serve",
  hearing: "Hearing",
  collect: "Collect",
};
const strip = steps.map((s) => ({ slug: s.slug, word: stepWords[s.slug] ?? s.title }));
---
<Site title="Fair Claim" bleed>
  <section class="wrap land-hero">
    <div class="land-head">
      <h1 class="display-xl land-title">Small claims, explained.</h1>
      <p class="land-reach">Rules for <strong>all 50 states and DC</strong>, each with its source.</p>
    </div>
    <div class="land-search">
      <LocationSearch label="Find your state's rules" compact />
    </div>
  </section>

  <section class="wrap" aria-labelledby="doors-title">
    <h2 id="doors-title" class="sr-only">Where to start</h2>
    <div class="doors land-doors">
      {doors.map((d, i) => (
        <a class={`tile fill door ${d.c}`} href={d.href}>
          <span class="t-top">
            <span class="key" aria-hidden="true">{d.key}</span>
            <span class="lbl door-idx" aria-hidden="true">0{i + 1}</span>
          </span>
          <span class="door-body">
            <span class="door-title">{d.title}</span>
            <span class="door-text">{d.text}</span>
          </span>
          <span class="door-foot"><span>{d.foot}</span><span class="door-arrow" aria-hidden="true"></span></span>
        </a>
      ))}
    </div>
    <p class="land-sued">
      <span class="lbl lbl-ink">Being sued?</span>
      <span>Don't ignore the papers. Your <a href="/states/">state's page</a> links to the court's guide.</span>
    </p>
  </section>

  <nav class="wrap c-learn" aria-labelledby="strip-title">
    <div class="land-steps">
    <h2 id="strip-title" class="lbl">The five steps</h2>
    <ol class="strip">
      {strip.map((s, i) => (
        <li>
          <a href={`/steps/#${s.slug}`}>
            <span class="strip-n" aria-hidden="true">{i + 1}</span>
            <span class="strip-w"><span class="sr-only">Step {i + 1}: </span>{s.word}</span>
          </a>
        </li>
      ))}
    </ol>
    </div>
  </nav>

  <section class="wrap land-glance" aria-label="At a glance">
    <div class="land-key c-tomato">
      <p class="lbl">Getting paid · one study</p>
      <p class="land-key-row">
        <span class="num land-key-num">{denver.collectedNothingPct}%</span>
        <span class="land-key-label">of winners in a study of Denver's small claims court never collected anything.</span>
      </p>
      <p class="cite"><span>Source</span><a href={denver.source.url} rel="noopener">Best et al., Fordham Urb. L.J. (1994)</a><span>Checked {evidenceChecked}</span></p>
      <a class="go" href="/about/#paid">Winning isn't getting paid</a>
    </div>
    <TileMapLimits compact headingLevel={2} id="home-limits" />
  </section>

  <section class="wrap land-soon" aria-labelledby="soon-title">
    <div class="land-soon-head">
      <h2 id="soon-title" class="lbl">Rules changing soon</h2>
      <p class="land-soon-sub">Laws already passed that take effect later. We update each state's page on the day.</p>
    </div>
    <ol class="land-soon-list">
      {upcomingRows.map((c) => {
        const d = new Date(c.effective + "T00:00:00Z");
        const when = d.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
        return (
          <li>
            <a class="land-soon-row" href={`/states/${c.slug}/`}>
              <time class="land-soon-date" datetime={c.effective}>{when}</time>
              <span class="land-soon-state">{c.state}</span>
              <span class="land-soon-kind">{c.kind}</span>
              <span class="land-soon-change"><span class="land-soon-from">{c.from}</span><span aria-hidden="true">→</span><span class="sr-only">to</span><span class="land-soon-to">{c.to}</span></span>
              <span class="land-soon-go" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
</Site>

<style>
  .land-soon {
    padding-top: var(--sp-section, 64px);
  }
  .land-soon-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-strong);
  }
  .land-soon-head h2 {
    margin: 0;
  }
  .land-soon-sub {
    margin: 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  .land-soon-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .land-soon-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1.2fr) 7rem minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    gap: 8px 24px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--t-fast, 160ms) var(--ease, ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .land-soon-row:hover {
      background: var(--panel);
    }
    .land-soon-row:hover .land-soon-go {
      transform: translateX(3px);
    }
  }
  .land-soon-row:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .land-soon-date,
  .land-soon-kind {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .land-soon-state {
    font-family: var(--f-display);
    font-size: clamp(22px, 2.2vw, 28px);
    letter-spacing: -0.02em;
  }
  .land-soon-change {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font-variant-numeric: tabular-nums;
    font-size: 18px;
  }
  .land-soon-from {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .land-soon-to {
    font-family: var(--f-display);
    font-size: clamp(22px, 2.2vw, 28px);
    letter-spacing: -0.02em;
  }
  .land-soon-go {
    justify-self: end;
    color: var(--ink-2);
    transition: transform var(--t-fast, 160ms) var(--ease, ease-out);
  }
  @media (max-width: 760px) {
    .land-soon-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
    }
    .land-soon-date { grid-column: 1; grid-row: 1; }
    .land-soon-kind { grid-column: 2; grid-row: 1; justify-self: end; }
    .land-soon-state { grid-column: 1; grid-row: 2; }
    .land-soon-change { grid-column: 2; grid-row: 2; justify-self: end; }
    .land-soon-go { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .land-soon-row, .land-soon-go { transition: none; }
  }
  .land-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 28px 48px;
    padding-top: clamp(24px, 3.6vw, 56px);
    padding-bottom: clamp(20px, 2.4vw, 32px);
  }
  .land-title {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(46px, 6.4vw, 96px);
  }
  .land-reach {
    margin: 16px 0 0;
    font-size: clamp(19px, 1.7vw, 24px);
    line-height: 1.35;
    color: var(--ink-2);
  }
  .land-reach strong {
    font-weight: 500;
    color: var(--ink);
  }
  .land-search {
    padding-bottom: 4px;
  }
  .door-idx {
    color: inherit;
  }
  /* Home doors: the same tiles as /tools/, a size down so the core of the page fits about one screen. */
  .land-doors :global(.door) {
    min-height: clamp(190px, 17vw, 250px);
    gap: 20px;
  }
  .land-doors :global(.door-title) {
    font-size: clamp(28px, 2.5vw, 40px);
  }
  .land-doors :global(.door-text) {
    font-size: 16px;
  }
  .land-sued {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin: 20px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }

  /* Five steps: numbered marks on one hairline, one or two words each. */
  .land-steps {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: 16px var(--gap);
    align-items: start;
    margin-top: clamp(22px, 2.4vw, 32px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .land-steps h2 {
    margin: 0;
    padding-top: 9px;
  }
  .strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip::before {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    top: 16px;
    height: 1px;
    background: var(--line-2);
  }
  .strip li {
    margin: 0;
  }
  .strip a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 0 8px 4px 0;
    color: var(--ink);
    text-decoration: none;
    touch-action: manipulation;
  }
  .strip-n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--ink);
    transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease), transform var(--t-press) var(--ease);
  }
  .strip-w {
    font-size: 16px;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--t-fast) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .strip a:hover .strip-n {
      background: var(--t);
      color: var(--on);
      box-shadow: none;
    }
    .strip a:hover .strip-w {
      text-decoration-color: currentColor;
    }
  }
  .strip a:active .strip-n {
    transform: scale(0.94);
  }
  .strip a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* At a glance: one key number and the limits map, each a small door. */
  .land-glance {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px;
    margin-top: clamp(22px, 2.4vw, 32px);
  }
  .land-key {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 24px 22px;
    border-radius: var(--r);
    background: var(--panel);
  }
  .land-key > * {
    margin: 0;
  }
  .land-key-row {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    margin-top: auto;
    padding-top: 12px;
  }
  .land-key-num {
    flex: none;
    font-size: clamp(64px, 7vw, 112px);
    line-height: 0.82;
    letter-spacing: -0.05em;
  }
  .land-key-num::after {
    content: "";
    display: block;
    width: 100%;
    height: 4px;
    margin-top: 14px;
    border-radius: 2px;
    background: var(--t);
  }
  .land-key-label {
    max-width: 26ch;
    padding-bottom: 18px;
    font-size: 17px;
    line-height: 1.4;
  }
  @media (max-width: 960px) {
    .land-hero,
    .land-glance,
    .land-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .strip {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .strip::before {
      right: auto;
      bottom: 16px;
      width: 1px;
      height: auto;
    }
    .strip a {
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }
    .land-key-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .land-key-label {
      padding-bottom: 0;
    }
    .land-doors :global(.door) {
      min-height: 184px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip a:active .strip-n {
      transform: none;
    }
  }
</style>
