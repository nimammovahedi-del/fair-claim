---
// Design-system gallery (Option A). Palette with contrast, theme tokens, type scale, and the components side by side
// in light and dark. Values mirror global.css sections 2–3 and docs/design-system.md; contrast is computed at build.
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import GallerySamples from "../../components/design/GallerySamples.astro";
import "../../styles/features.css";

// WCAG 2.x contrast ratio.
function lum(h: string) {
  const c = [1, 3, 5]
    .map((i) => parseInt(h.slice(i, i + 2), 16) / 255)
    .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
}
const ratio = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
  return (x + 0.05) / (y + 0.05);
};
const fmt = (n: number) => `${n.toFixed(1)}:1`;

const hues = [
  { slot: "c-tomato", name: "Tomato", token: "--c-tomato", hex: "#f2583e", on: "#111112", onName: "ink", use: "State rules" },
  { slot: "c-cobalt", name: "Cobalt", token: "--c-cobalt", hex: "#2a4bd0", on: "#ffffff", onName: "white", use: "How it works, charts" },
  { slot: "c-lilac", name: "Lilac", token: "--c-lilac", hex: "#c7b8f2", on: "#111112", onName: "ink", use: "Glossary, letter" },
  { slot: "c-sage", name: "Sage", token: "--c-sage", hex: "#a7d3b4", on: "#111112", onName: "ink", use: "Tools, calculator" },
  { slot: "c-sand", name: "Sand", token: "--c-sand", hex: "#ecd6aa", on: "#111112", onName: "ink", use: "Checklists, about" },
];

const light = {
  "--bg": "#f3f2ee", "--bg-2": "#fbfaf7", "--panel": "#e7e6e0", "--panel-hover": "#d8d7cf",
  "--ink": "#111112", "--ink-2": "#3c3c38", "--ink-3": "#55554f", "--line-strong": "#76766f",
  "--error-ink": "#b3261e", "--ok-ink": "#1f6b3a", "--fc-mark": "#2a4bd0",
} as Record<string, string>;
const dark = {
  "--bg": "#0b0b0c", "--bg-2": "#121214", "--panel": "#18181a", "--panel-hover": "#26262a",
  "--ink": "#f2f1ec", "--ink-2": "#bdbdb7", "--ink-3": "#96968f", "--line-strong": "#6a6a65",
  "--error-ink": "#ff8a78", "--ok-ink": "#8fd3a5", "--fc-mark": "#8a9ef0",
} as Record<string, string>;
const tokens = [
  { t: "--bg", use: "Page" },
  { t: "--bg-2", use: "Raised: tab panels, popovers, charts" },
  { t: "--panel", use: "Tiles, input panels, cards" },
  { t: "--panel-hover", use: "Hover on a panel" },
  { t: "--ink", use: "Text", on: "--bg", min: 4.5 },
  { t: "--ink-2", use: "Secondary text", on: "--panel", min: 4.5 },
  { t: "--ink-3", use: "Labels, hints, cites (worst case)", on: "--panel-hover", min: 4.5 },
  { t: "--line-strong", use: "Plain input borders (non-text)", on: "--panel", min: 3 },
  { t: "--error-ink", use: "Error text", on: "--panel", min: 4.5 },
  { t: "--ok-ink", use: "Success text", on: "--panel", min: 4.5 },
  { t: "--fc-mark", use: "Chart marks (non-text)", on: "--bg-2", min: 3 },
];

const type = [
  { cls: "display-xl", label: "Display XL · 48–120 · −0.045em", text: "Small claims, explained." },
  { cls: "display", label: "Display / h1 · 42–84", text: "Court words, in plain English." },
  { cls: "h2", label: "h2 · 30–52", text: "Which state are you in?" },
  { cls: "h3", label: "h3 · 23–30", text: "Serving the papers" },
  { cls: "h4", label: "h4 · 21", text: "Free small claims advisors" },
  { cls: "lede", label: "Lede · 19–23", text: "Winning doesn't mean being paid." },
  { cls: "", label: "Body · 17 / 1.65", text: "Small claims court is built for people without lawyers. The details change from state to state." },
  { cls: "small", label: "Small · 15", text: "Leave at 0 to ignore, or use your hourly pay." },
  { cls: "lbl", label: "Label · mono 12 caps", text: "Rules checked 2026-11-05" },
  { cls: "cite", label: "Cite · mono 12", text: "CCP 116.221 · checked 2026-11-05" },
];
---
<Site title="Design system" description="Fair Claim's design system: palette, type, tiles, fields, notices and charts, in light and dark." bleed>
  <section class="wrap page-hero">
    <Breadcrumb items={[{ label: "Design system" }]} />
    <h1 class="display">Design system</h1>
    <p class="lede">Multi-color tiles on a quiet page. Large regular type, one idea per section, mono labels.</p>
  </section>

  <section class="wrap section" style="padding-top:0" aria-labelledby="pal-title">
    <div class="sec-head">
      <p class="lbl">Palette</p>
      <div>
        <h2 class="h2" id="pal-title">Five hues, the same in both themes.</h2>
        <p class="lede">Two strong, three soft. Each section has a fixed one. Text on a hue is ink or white.</p>
      </div>
    </div>
    <ul class="ds-swatches">
      {hues.map((h) => (
        <li>
          <div class={`ds-sw ${h.slot}`}>
            <span class="lbl">{h.use}</span>
            <span>
              <span class="ds-sw-name">{h.name}</span>
              <span class="ds-sw-meta">
                <span>{h.token} {h.hex}</span>
                <span>Text: {h.onName} · {fmt(ratio(h.hex, h.on))}</span>
                <span>On light page {fmt(ratio(h.hex, light["--bg"]))} · dark {fmt(ratio(h.hex, dark["--bg"]))}</span>
              </span>
            </span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="tok-title">
    <div class="sec-head">
      <p class="lbl">Theme tokens</p>
      <div>
        <h2 class="h2" id="tok-title">Two themes, checked for contrast.</h2>
        <p class="lede">The theme follows the device unless the reader picks Light or Dark. Body text needs 4.5:1; borders and chart marks 3:1.</p>
      </div>
    </div>
    <div class="table-scroll">
      <table class="ds-tokens">
        <caption>Theme tokens · contrast computed with the WCAG formula</caption>
        <thead><tr><th scope="col">Token</th><th scope="col">Use</th><th scope="col">Light</th><th scope="col">Dark</th><th scope="col">Contrast (light / dark)</th></tr></thead>
        <tbody>
          {tokens.map((r) => {
            const cl = r.on ? ratio(light[r.t], light[r.on]) : 0;
            const cd = r.on ? ratio(dark[r.t], dark[r.on]) : 0;
            return (
              <tr>
                <td>{r.t}</td>
                <td>{r.use}</td>
                <td class="mono"><span class="ds-chip" style={`background:${light[r.t]}`}></span>{light[r.t]}</td>
                <td class="mono"><span class="ds-chip" style={`background:${dark[r.t]}`}></span>{dark[r.t]}</td>
                <td class="mono">
                  {r.on ? (
                    <span class={cl >= r.min! && cd >= r.min! ? "ds-pass" : "ds-fail"}>
                      {fmt(cl)} / {fmt(cd)} on {r.on} {cl >= r.min! && cd >= r.min! ? "· pass" : "· below " + r.min}
                    </span>
                  ) : "Surface"}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="type-title">
    <div class="sec-head">
      <p class="lbl">Type</p>
      <div>
        <h2 class="h2" id="type-title">Inter Tight, Geist Sans, Geist Mono.</h2>
        <p class="lede">Display at weight 400 with tight tracking. All self-hosted.</p>
      </div>
    </div>
    <ul class="ds-type">
      {type.map((t) => (
        <li><span class="lbl">{t.label}</span><p class={t.cls}>{t.text}</p></li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="comp-title">
    <div class="sec-head">
      <p class="lbl">Components</p>
      <div>
        <h2 class="h2" id="comp-title">Every piece, light and dark.</h2>
        <p class="lede">Motion is short fades and color changes only. Nothing bounces; reduced motion turns it off.</p>
      </div>
    </div>
    <div class="ds-split">
      <div class="ds-panel" data-theme="light">
        <p class="lbl">Light</p>
        <GallerySamples k="l" />
      </div>
      <div class="ds-panel" data-theme="dark">
        <p class="lbl">Dark</p>
        <GallerySamples k="d" />
      </div>
    </div>
  </section>
</Site>
