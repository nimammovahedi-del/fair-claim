---
// Demand-letter tool (Option A guided flow). Framed as one option people often try first, not as "how to get paid".
// Everything runs in the browser: nothing is stored or sent. A live "paper" preview updates as you type.
// Copy, print and PDF are blocked until the required boxes are filled in, with an error summary that links to each box.
import Site from "../../layouts/Site.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolNotice from "../../components/ToolNotice.astro";
import ToolStatePicker from "../../components/ToolStatePicker.astro";
import "../../components/ToolFlow.css";
import { states, caStatewide } from "../../lib/data";
import { letterNotes } from "../../lib/letter-notes";

// Short, neutral line printed at the bottom of the PDF and the printed letter.
const PRINT_NOTE = "Prepared with Fair Claim's free letter tool (general information, not legal advice). Review before sending.";
const letterStates = states.map((s) => ({ slug: s.slug, name: s.state, abbr: s.abbr, court: s.court_name, checked: s.date_checked }));
const preFiling = caStatewide.pre_filing_demand as { citation?: string; sources?: string[] } | undefined;

const colors = ["c-lilac", "c-tomato", "c-sage", "c-cobalt", "c-sand"];
const kinds = [
  { v: "security_deposit", label: "Security deposit", sub: "Not returned after moving out" },
  { v: "consumer_refund", label: "A refund", sub: "Product or service" },
  { v: "unpaid_invoice", label: "Unpaid invoice", sub: "Money owed to my business" },
  { v: "property_damage", label: "Damage to my property", sub: "Car, home, belongings" },
  { v: "other", label: "Something else", sub: "Any other amount owed" },
];
const days = [10, 14, 21, 30];
const keys = "ABCDEF";
const steps = ["What it's about", "State", "The details", "You", "Them", "Deadline", "Review"];
const TOTAL = steps.length;
const pad = (n: number) => String(n).padStart(2, "0");
---
<Site
  title="Demand letter"
  description="A demand letter is one option many people try before going to court. Write a calm, clear one in your browser. Nothing is stored or sent."
  bleed
  color="c-letter"
>
  <script type="application/json" id="letter-states" set:html={JSON.stringify(letterStates)} />
  <script type="application/json" id="letter-notes" set:html={JSON.stringify(letterNotes)} />

  <div class="fl dl">
    <section class="wrap page-hero dl-hero no-print">
      <Breadcrumb items={[{ href: "/tools/", label: "Tools" }, { label: "Demand letter" }]} />
      <div class="dl-top">
        <h1 class="fl-title dl-title">Write a demand letter</h1>
        <div class="dl-aside">
          <p>A written request to be paid. Many people try one before court. Sending one doesn't commit you to suing.</p>
          {preFiling?.citation && (
            <p class="cite">
              California expects you to ask before you file:{" "}
              {preFiling.sources?.[0] ? <a href={preFiling.sources[0]} rel="noopener">{preFiling.citation}</a> : preFiling.citation}
            </p>
          )}
        </div>
      </div>
    </section>

    <div class="wrap">
      <ToolNotice
        id="demand-letter"
        target="letter-tool"
        toolName="the demand-letter tool"
        points={[
          "Legal information, not legal advice. The tool fills in a plain template; it can't judge your case.",
          "Nothing you type is stored or sent. The PDF is made on your device.",
          "State-law notes come from the sources we cite. Laws change.",
          "You review the letter: check every fact, date and amount.",
          "Keep it calm. No threats (of criminal charges or public posts, for example).",
          "Unsure? Ask the court's self-help center, a free small claims advisor or legal aid.",
        ]}
      />

      <div class="fl-layout fl-split dl-layout" id="letter-tool">
        <div class="fl-main dl-flow no-print">
          <div class="dl-prog">
            <div class="progress" aria-hidden="true">
              {steps.map((_, i) => <span class={i === 0 ? "seg now" : "seg"} data-seg={i + 1}></span>)}
            </div>
            <p class="lbl" data-count>Step 1 of {TOTAL}</p>
          </div>

          <form id="letter" novalidate autocomplete="off">
            <!-- 1 · Kind -->
            <section class="fl-q" data-q="1" data-state="now" aria-labelledby="l1-t">
              <div class="fl-q-head">
                <span class="fl-q-n">{pad(1)} / {pad(TOTAL)}<span class="q-ok" aria-hidden="true"></span></span>
                <h2 class="fl-q-title" id="l1-t" tabindex="-1" data-notice-focus>What is it about?</h2>
              </div>
              <div class="fl-q-body">
                <fieldset class="fl-group" data-keys data-auto>
                  <legend class="sr-only">What is it about?</legend>
                  <div class="tiles fl-tiles-3">
                    {kinds.map((k, i) => (
                      <label class={`tile ${colors[i]}`}>
                        <input type="radio" name="kind" value={k.v} checked={i === 0} />
                        <span class="t-top"><span class="key" aria-hidden="true">{keys[i]}</span><span class="check" aria-hidden="true"></span></span>
                        <span><span class="t-label">{k.label}</span><span class="t-sub">{k.sub}</span></span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              </div>
              <div class="fl-q-foot">
                <button class="btn" type="button" data-next>Continue</button>
                <span class="hint"><span class="kbd" aria-hidden="true">↵</span> or Enter · letter keys pick</span>
              </div>
            </section>

            <!-- 2 · State -->
            <section class="fl-q" data-q="2" data-state="next" aria-labelledby="l2-t">
              <div class="fl-q-head">
                <span class="fl-q-n">{pad(2)} / {pad(TOTAL)}<span class="q-ok" aria-hidden="true"></span></span>
                <h2 class="fl-q-title" id="l2-t" tabindex="-1">Which state are you in?</h2>
                <p class="fl-q-help" id="l2-help">Optional. Adds cited state-law notes where we have them.</p>
              </div>
              <div class="fl-q-body">
                <ToolStatePicker name="st" legend="Which state are you in?" states={letterStates} featured={["ca", "tx", "ny"]} colors={colors} skipLabel="Skip" skipSub="No state notes" describedby="l2-help" auto={false} checked="" />
                <div class="dl-notes" id="notes-box">
                  <p class="fl-sub" id="notes-title" hidden>State law to mention</p>
                  <ul class="fl-toggles" id="notes-list" aria-labelledby="notes-title" hidden></ul>
                  <p class="fl-note" id="notes-none"></p>
                </div>
              </div>
              <div class="fl-q-foot">
                <button class="btn" type="button" data-next>Continue</button>
                <span class="hint"><span class="kbd" aria-hidden="true">↵</span> or Enter</span>
              </div>
            </section>

            <!-- 3 · Details -->
            <section class="fl-q" data-q="3" data-state="later" aria-labelledby="l3-t">
              <div class="fl-q-head">
                <span class="fl-q-n">{pad(3)} / {pad(TOTAL)}<span class="q-ok" aria-hidden="true"></span></span>
                <h2 class="fl-q-title" id="l3-t" tabindex="-1">The details</h2>
                <p class="fl-q-help">Short and factual. Only what you can show.</p>
              </div>
              <div class="fl-q-body">
                <div class="fields fl-fields-2 fl-pair">
                  <div class="field">
                    <label for="amount">Amount <span class="f-req">Required</span></label>
                    <div class="affix"><span aria-hidden="true">$</span><input id="amount" type="text" inputmode="decimal" enterkeyhint="next" placeholder="1,850.00" aria-required="true" /></div>
                  </div>
                  <div class="field">
                    <label for="eventDate"><span id="eventDateLabel">Move-out date</span> <span class="f-req">Optional</span></label>
                    <input id="eventDate" type="date" />
                  </div>
                  <div class="field wide">
                    <label for="detail"><span id="detailLabel">Rental address</span> <span class="f-req">Required</span></label>
                    <input id="detail" type="text" enterkeyhint="next" placeholder="123 Main St, Apt 4, Oakland, CA" aria-required="true" aria-describedby="detail-hint" />
                    <span class="f-hint" id="detail-hint">Goes in the subject line. Keep it short.</span>
                  </div>
                  <div class="field wide">
                    <label for="facts">What happened <span class="f-req">Recommended</span></label>
                    <textarea id="facts" rows="3" aria-describedby="facts-hint" placeholder="I paid a $2,000 deposit when I moved in. I left the unit clean and returned the keys on June 30. I received $150 back with no itemized list of deductions."></textarea>
                    <span class="f-hint" id="facts-hint">In your words: dates, amounts, what you did.</span>
                  </div>
                </div>
              </div>
              <div class="fl-q-foot">
                <button class="btn" type="button" data-next>Continue</button>
                <span class="hint"><span class="kbd" aria-hidden="true">↵</span> or Enter</span>
              </div>
            </section>

            <!-- 4 · You -->
            <section class="fl-q" data-q="4" data-state="later" aria-labelledby="l4-t">
              <div class="fl-q-head">
                <span class="fl-q-n">{pad(4)} / {pad(TOTAL)}<span class="q-ok" aria-hidden="true"></span></span>
                <h2 class="fl-q-title" id="l4-t" tabindex="-1">From you</h2>
                <p class="fl-q-help">Printed at the top, so they can reply.</p>
              </div>
              <div class="fl-q-body">
                <div class="fields fl-fields-2">
                  <div class="field wide">
                    <label for="sName">Your name <span class="f-req">Required</span></label>
                    <input id="sName" type="text" autocomplete="name" enterkeyhint="next" aria-required="true" />
                  </div>
                  <div class="field wide">
                    <label for="sAddr">Your mailing address <span class="f-req">Required</span></label>
                    <textarea id="sAddr" rows="2" autocomplete="street-address" aria-required="true" aria-describedby="sAddr-hint"></textarea>
                    <span class="f-hint" id="sAddr-hint">Street, then city, state and ZIP.</span>
                  </div>
                  <div class="field">
                    <label for="sPhone">Phone <span class="f-req">Optional</span></label>
                    <input id="sPhone" type="tel" autocomplete="tel" enterkeyhint="next" />
                  </div>
                  <div class="field">
                    <label for="sEmail">Email <span class="f-req">Optional</span></label>
                    <input id="sEmail" type="email" autocomplete="email" autocapitalize="none" spellcheck="false" enterkeyhint="next" />
                  </div>
                </div>
              </div>
              <div class="fl-q-foot">
                <button class="btn" type="button" data-next>Continue</button>
                <span class="hint"><span class="kbd" aria-hidden="true">↵</span> or Enter</span>
              </div>
            </section>

            <!-- 5 · Them -->
            <section class="fl-q" data-q="5" data-state="later" aria-labelledby="l5-t">
              <div class="fl-q-head">
                <span class="fl-q-n">{pad(5)} / {pad(TOTAL)}<span class="q-ok" aria-hidden="true"></span></span>
                <h2 class="fl-q-title" id="l5-t" tabindex="-1">To them</h2>
                <p class="fl-q-help">The person or business you're asking to pay.</p>
              </div>
              <div class="fl-q-body">
                <div class="fields fl-fields-2">
                  <div class="field wide">
                    <label for="rName">Their name or business name <span class="f-req">Required</span></label>
                    <input id="rName" type="text" enterkeyhint="next" aria-required="true" aria-describedby="rName-hint" />
                    <span class="f-hint" id="rName-hint">For a business, its legal name (your Secretary of State's business search shows it).</span>
                  </div>
                  <div class="field wide">
                    <label for="rAddr">Their mailing address <span class="f-req">Required</span></label>
                    <textarea id="rAddr" rows="2" aria-required="true" aria-describedby="rAddr-hint"></textarea>
                    <span class="f-hint" id="rAddr-hint">Like an envelope, one line per row.</span>
                  </div>
                </div>
              </div>
              <div class="fl-q-foot">
                <button class="btn" type="button" data-next>Continue</button>
                <span class="hint"><span class="kbd" aria-hidden="true">↵</span> or Enter</span>
              </div>
            </section>

            <!-- 6 · Deadline + wording -->
            <section class="fl-q" data-q="6" data-state="later" aria-labelledby="l6-t">
              <div class="fl-q-head">
                <span class="fl-q-n">{pad(6)} / {pad(TOTAL)}<span class="q-ok" aria-hidden="true"></span></span>
                <h2 class="fl-q-title" id="l6-t" tabindex="-1">How long will you give them?</h2>
                <p class="fl-q-help" id="l6-help">Many people allow 10 to 14 days. The date goes in the letter.</p>
              </div>
              <div class="fl-q-body">
                <fieldset class="fl-group" data-keys aria-describedby="l6-help">
                  <legend class="sr-only">Days to respond</legend>
                  <div class="tiles fl-tiles-4 dl-days">
                    {days.map((d, i) => (
                      <label class={`tile ${colors[i]}`}>
                        <input type="radio" name="days" value={d} checked={d === 14} />
                        <span class="t-top"><span class="key" aria-hidden="true">{keys[i]}</span><span class="check" aria-hidden="true"></span></span>
                        <span><span class="t-big">{d}</span><span class="t-sub" data-by={d}>days</span></span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <div class="fields fl-fields-2 dl-gap">
                  <div class="field">
                    <label for="date">Date of the letter <span class="f-req">Required</span></label>
                    <input id="date" type="date" aria-required="true" />
                  </div>
                  <div class="field">
                    <label for="pay">How they can pay <span class="f-req">Optional</span></label>
                    <input id="pay" type="text" enterkeyhint="next" placeholder="a check mailed to the address above" />
                  </div>
                </div>
                <fieldset class="fl-group dl-gap">
                  <legend>What the letter says</legend>
                  <ul class="fl-toggles">
                    <li><label class="fl-toggle"><input type="checkbox" id="offer" checked /><span class="tg" aria-hidden="true"></span><span>Offer to talk it over before the deadline</span></label></li>
                    <li><label class="fl-toggle"><input type="checkbox" id="mentionCourt" checked /><span class="tg" aria-hidden="true"></span><span>Say I may file in small claims court if it isn't resolved</span></label></li>
                  </ul>
                </fieldset>
                <div class="fields dl-gap" id="court-field">
                  <div class="field wide compact">
                    <label for="court">Court to name <span class="f-req">Optional</span></label>
                    <input id="court" type="text" enterkeyhint="done" placeholder="small claims court in Alameda County" aria-describedby="court-hint" />
                    <span class="f-hint" id="court-hint">Blank says “small claims court”.</span>
                  </div>
                </div>
              </div>
              <div class="fl-q-foot">
                <button class="btn" type="button" data-next>Review the letter</button>
                <span class="hint"><span class="kbd" aria-hidden="true">↵</span> or Enter</span>
              </div>
            </section>

            <!-- 7 · Review -->
            <section class="fl-q" data-q="7" data-state="later" aria-labelledby="l7-t">
              <div class="fl-q-head">
                <span class="fl-q-n">{pad(7)} / {pad(TOTAL)}<span class="q-ok" aria-hidden="true"></span></span>
                <h2 class="fl-q-title" id="l7-t" tabindex="-1">Read it, then save or print</h2>
                <p class="fl-q-help">It's your letter. Change anything that isn't exactly right.</p>
              </div>
              <div class="fl-q-body">
                <div class="callout error dl-errors" id="error-summary" tabindex="-1" hidden aria-labelledby="error-summary-title">
                  <p class="callout-title" id="error-summary-title"></p>
                  <ul id="error-list"></ul>
                </div>
                <p class="dl-ready" id="ready-line"></p>
                <div class="dl-actions">
                  <button class="btn" type="button" data-action="pdf">Download PDF</button>
                  <button class="btn ghost" type="button" data-action="print">Print</button>
                  <button class="btn ghost" type="button" data-action="copy">Copy text</button>
                  <button class="btn ghost dl-clear" type="button" data-action="clear">Clear everything</button>
                </div>
                <p class="fl-note dl-send"><strong>Before you send it:</strong> use a way you can prove, like certified mail, or email plus regular mail. Keep a copy. <a href="/steps/#before-you-decide">Other options</a></p>
              </div>
            </section>
          </form>
        </div>

        <aside class="dl-side" aria-labelledby="preview-title">
          <div class="dl-side-in">
            <div class="dl-bar no-print">
              <h2 class="lbl lbl-ink" id="preview-title" tabindex="-1">Preview</h2>
              <p class="lbl">Live · <mark class="dl-ph-key">[brackets]</mark> still need an answer</p>
            </div>
            <div class="dl-paper-wrap" id="paper-wrap" data-clip>
            <article class="paper dl-paper" id="preview" tabindex="0" role="region" aria-label="Letter preview">
              <div class="lp-head" id="lp-from"></div>
              <p class="lp-date" id="lp-date"></p>
              <div class="lp-to" id="lp-to"></div>
              <p class="lp-re"><span class="lp-re-k">Re:</span> <span id="lp-re"></span></p>
              <p id="lp-sal"></p>
              <div class="lp-body" id="lp-body"></div>
              <div class="lp-close"><p>Sincerely,</p><p class="lp-sig" id="lp-sig"></p></div>
              <p class="lp-foot" id="print-note">{PRINT_NOTE}</p>
            </article>
            </div>
            <button type="button" class="btn sm ghost dl-expand no-print" id="paper-toggle" aria-controls="preview" aria-expanded="false" hidden>Show the whole letter</button>
            <div class="dl-actions dl-side-actions no-print">
              <button class="btn sm" type="button" data-action="pdf">Download PDF</button>
              <button class="btn sm ghost" type="button" data-action="print">Print</button>
              <button class="btn sm ghost" type="button" data-action="copy">Copy text</button>
            </div>
            <p class="cite no-print" id="notes-cite"></p>
            <p class="sr-only" role="status" aria-live="polite" id="letter-status"></p>
          </div>
        </aside>

        <div class="fl-dock no-print" id="dock">
          <p class="d-text"><strong>Your letter</strong><span>Updates as you type</span></p>
          <a class="btn sm" href="#preview-title" id="dock-go">See the preview</a>
        </div>
      </div>
    </div>
  </div>
</Site>

<script>
  import { buildDemandLetter, formatMoney, type DisputeKind } from "../../lib/core/demand-letter";
  import { todayISO, addCalendarDays, formatLongDate } from "../../lib/core/deadlines";
  import { parseAmount } from "../../lib/core/worth-it";
  import { createFlow, initStatePicker } from "../../components/ToolFlow";

  type Note = { id: string; kinds: string[]; text: string; citation: string; url: string; unverified?: boolean };
  type St = { slug: string; name: string; abbr: string; court: string | null; checked: string | null };
  const TOTAL = 7;
  const notesByState: Record<string, Note[]> = JSON.parse(document.getElementById("letter-notes")!.textContent || "{}");
  const stateList: St[] = JSON.parse(document.getElementById("letter-states")!.textContent || "[]");
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const field = (id: string) => $<HTMLInputElement>(id);
  const val = (id: string) => field(id).value.trim();
  const lines = (id: string) => val(id).split("\n").map((l) => l.trim()).filter(Boolean);
  const checked = (id: string) => field(id).checked;
  const radio = (name: string) => document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "";
  const root = $("letter-tool");
  const form = $<HTMLFormElement>("letter");
  form.addEventListener("submit", (e) => e.preventDefault());
  let stateSlug = "";

  const labels: Record<string, [string, string, string]> = {
    security_deposit: ["Move-out date", "Rental address", "123 Main St, Apt 4, Oakland, CA"],
    consumer_refund: ["Date you paid", "What you bought or hired them for", "kitchen remodel deposit (contract dated March 2)"],
    unpaid_invoice: ["Date payment was due", "Invoice number and work done", "Invoice #1042 for website design, delivered May 1"],
    property_damage: ["Date of the damage", "What was damaged and how", "my car's rear bumper, hit in the Safeway parking lot"],
    other: ["Key date", "What this is about", "the loan of $800 I made on January 5"],
  };

  // Required boxes, where they live, and the words used in error messages.
  const required: { id: string; q: number; name: string; check?: (v: string) => string | null }[] = [
    {
      id: "amount",
      q: 3,
      name: "the amount",
      check: (v) => {
        const n = parseAmount(v);
        if (n == null) return "Enter the amount you're asking for.";
        if (Number.isNaN(n)) return "Enter the amount as a number, like 1,850.";
        if (n <= 0) return "The amount needs to be more than $0.";
        return null;
      },
    },
    { id: "detail", q: 3, name: "what it's about" },
    { id: "sName", q: 4, name: "your name" },
    { id: "sAddr", q: 4, name: "your mailing address" },
    { id: "rName", q: 5, name: "their name" },
    { id: "rAddr", q: 5, name: "their mailing address" },
    { id: "date", q: 6, name: "the date of the letter" },
  ];
  const optionalChecks: { id: string; q: number; check: (v: string) => string | null }[] = [
    { id: "sEmail", q: 4, check: (v) => (v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? "Check the email address, like name@example.com." : null) },
    { id: "eventDate", q: 3, check: () => (field("eventDate").validity.badInput ? "Enter a full date." : null) },
  ];
  const stepOf: Record<string, number> = {};
  for (const r of [...required, ...optionalChecks]) stepOf[r.id] = r.q;
  const touched = new Set<string>();
  const hintIds: Record<string, string> = {};
  for (const id of Object.keys(stepOf)) hintIds[id] = field(id).getAttribute("aria-describedby") || "";

  field("date").value = todayISO();

  // ---------------------------------------------------------------- Errors
  function errors(): Map<string, string> {
    const out = new Map<string, string>();
    for (const r of required) {
      const v = val(r.id);
      const msg = r.check ? r.check(v) : v ? null : `Enter ${r.name}.`;
      if (msg) out.set(r.id, msg);
    }
    for (const o of optionalChecks) {
      const msg = o.check(val(o.id));
      if (msg) out.set(o.id, msg);
    }
    return out;
  }

  function paintErrors(errs: Map<string, string>) {
    for (const id of Object.keys(hintIds)) {
      const el = field(id);
      const box = el.closest<HTMLElement>(".field")!;
      const msg = errs.get(id);
      const show = msg && touched.has(id);
      const errId = `${id}-error`;
      let p = document.getElementById(errId);
      if (show) {
        if (!p) {
          p = document.createElement("p");
          p.className = "f-error";
          p.id = errId;
          box.appendChild(p);
        }
        p.textContent = msg!;
        box.classList.add("has-error");
        el.setAttribute("aria-invalid", "true");
        el.setAttribute("aria-describedby", `${errId} ${hintIds[id]}`.trim());
      } else {
        p?.remove();
        box.classList.remove("has-error");
        el.removeAttribute("aria-invalid");
        if (hintIds[id]) el.setAttribute("aria-describedby", hintIds[id]);
        else el.removeAttribute("aria-describedby");
      }
    }
    if (!$("error-summary").hidden) fillSummary(errs);
    readyLine(errs);
  }

  function fillSummary(errs: Map<string, string>) {
    const summary = $("error-summary");
    if (!errs.size) {
      summary.hidden = true;
      return;
    }
    $("error-summary-title").textContent =
      errs.size === 1 ? "1 box needs an answer before you can print, save or copy" : `${errs.size} boxes need an answer before you can print, save or copy`;
    $("error-list").replaceChildren(
      ...[...errs].map(([id, msg]) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${id}`;
        a.textContent = msg;
        a.addEventListener("click", (e) => {
          e.preventDefault();
          flow.open(stepOf[id]);
          field(id).focus();
        });
        li.appendChild(a);
        return li;
      }),
    );
    summary.hidden = false;
  }

  function readyLine(errs: Map<string, string>) {
    const n = [...errs.keys()].filter((id) => required.some((r) => r.id === id)).length;
    $("ready-line").textContent = errs.size === 0 ? "Everything needed is filled in." : n ? `${n} required ${n === 1 ? "box is" : "boxes are"} still empty or need a fix.` : "One box needs a fix.";
  }

  /** Run before print, PDF or copy. Returns true when the letter is ready. */
  function ready(): boolean {
    const errs = errors();
    for (const id of errs.keys()) touched.add(id);
    paintErrors(errs);
    fillSummary(errs);
    if (errs.size) {
      flow.goTo(TOTAL);
      $("error-summary").focus();
      return false;
    }
    return true;
  }

  // ---------------------------------------------------------------- State notes
  function selectedNotes(): string[] {
    return Array.from(document.querySelectorAll<HTMLInputElement>("#notes-list input:checked")).map((c) => c.value);
  }

  function renderNotes() {
    const kind = radio("kind");
    const st = stateList.find((s) => s.slug === stateSlug);
    const list = (notesByState[stateSlug] || []).filter((n) => n.kinds.includes(kind));
    const box = $("notes-list");
    const keep = new Set(selectedNotes());
    const had = box.childElementCount > 0;
    box.replaceChildren();
    box.hidden = list.length === 0;
    $("notes-title").hidden = list.length === 0;
    $("notes-none").textContent = !st
      ? "No state picked. The letter works without state notes."
      : list.length
        ? "Cited from the law. Turn off any you don't want in the letter."
        : `We don't have cited notes for ${st.name} and this kind of dispute yet. The letter works without them.`;
    const cites: string[] = [];
    for (const n of list) {
      const li = document.createElement("li");
      const label = document.createElement("label");
      label.className = "fl-toggle";
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = had ? keep.has(n.text) : true;
      cb.value = n.text;
      const tg = document.createElement("span");
      tg.className = "tg";
      tg.setAttribute("aria-hidden", "true");
      const span = document.createElement("span");
      span.textContent = n.text;
      label.append(cb, tg, span);
      const cite = document.createElement("p");
      cite.className = "cite dl-note-cite";
      if (n.unverified) {
        const b = document.createElement("span");
        b.className = "badge unverified";
        b.textContent = "Unverified";
        cite.append(b, " ");
      }
      const a = document.createElement("a");
      a.href = n.url;
      a.rel = "noopener";
      a.textContent = n.citation;
      cite.append(a);
      if (st?.checked) cite.append(` · checked ${st.checked}`);
      li.append(label, cite);
      box.appendChild(li);
      cites.push(n.citation);
    }
    $("notes-cite").textContent = cites.length && st ? `${st.name} notes: ${cites.join("; ")}${st.checked ? ` · checked ${st.checked}` : ""}` : "";
  }

  // ---------------------------------------------------------------- Letter
  /** Builds the letter. With `forPreview`, missing answers show as [bracketed] placeholders. */
  function current(forPreview = false) {
    const amount = parseAmount(val("amount"));
    const amountOk = amount != null && !Number.isNaN(amount) && amount > 0;
    const sAddr = lines("sAddr");
    const rAddr = lines("rAddr");
    const L = buildDemandLetter({
      kind: radio("kind") as DisputeKind,
      sender: {
        name: val("sName") || (forPreview ? "[Your name]" : ""),
        addressLines: sAddr.length || !forPreview ? sAddr : ["[Your mailing address]"],
        phone: val("sPhone"),
        email: val("sEmail"),
      },
      recipient: { name: val("rName") || (forPreview ? "[Their name]" : ""), addressLines: rAddr.length || !forPreview ? rAddr : ["[Their mailing address]"] },
      letterDate: val("date") || todayISO(),
      amount: amountOk ? amount! : 0,
      subjectDetail: val("detail") || "[what it's about]",
      eventDate: field("eventDate").value || undefined,
      facts: val("facts"),
      responseDays: Number(radio("days")) || 14,
      paymentMethods: val("pay"),
      courtPhrase: val("court"),
      legalNotes: selectedNotes(),
      offerToDiscuss: checked("offer"),
      mentionCourt: checked("mentionCourt"),
    });
    if (forPreview && !amountOk) {
      const zero = formatMoney(0);
      const swap = (s: string) => s.split(zero).join("[amount]");
      return { ...L, text: swap(L.text), paragraphs: L.paragraphs.map(swap), subject: swap(L.subject) };
    }
    return L;
  }

  /** Put text in an element, marking [placeholders] (the brackets carry the meaning; the mark is extra). */
  function put(el: HTMLElement, text: string) {
    el.replaceChildren();
    for (const part of text.split(/(\[[^\]\n]+\])/)) {
      if (/^\[[^\]]+\]$/.test(part)) {
        const m = document.createElement("mark");
        m.className = "ph";
        m.textContent = part;
        el.appendChild(m);
      } else if (part) el.appendChild(document.createTextNode(part));
    }
  }
  function putLines(el: HTMLElement, rows: string[]) {
    el.replaceChildren(
      ...rows.map((r) => {
        const p = document.createElement("p");
        put(p, r);
        return p;
      }),
    );
  }

  function render() {
    const [d, det, ph] = labels[radio("kind")] || labels.other;
    $("eventDateLabel").textContent = d;
    $("detailLabel").textContent = det;
    field("detail").placeholder = ph;
    $("court-field").hidden = !checked("mentionCourt");

    // Deadline under each day tile
    const date = val("date");
    document.querySelectorAll<HTMLElement>("[data-by]").forEach((el) => {
      const n = Number(el.dataset.by);
      el.textContent = date ? `days · by ${formatLongDate(addCalendarDays(date, n)).replace(/, \d{4}$/, "").replace(/^([A-Z][a-z]{2})[a-z]+/, "$1")}` : "days";
    });

    const L = current(true);
    // heading = sender lines, "", date, "", recipient lines
    const firstBlank = L.heading.indexOf("");
    putLines($("lp-from"), L.heading.slice(0, firstBlank));
    put($("lp-date"), L.heading[firstBlank + 1] ?? "");
    putLines($("lp-to"), L.heading.slice(firstBlank + 3));
    put($("lp-re"), L.subject);
    put($("lp-sal"), L.salutation);
    putLines($("lp-body"), L.paragraphs);
    put($("lp-sig"), L.closing[L.closing.length - 1] || "");
  }

  function status(msg: string) {
    const s = $("letter-status");
    s.textContent = "";
    window.setTimeout(() => (s.textContent = msg), 50);
  }

  async function downloadPdf() {
    if (!ready()) return;
    const { jsPDF } = await import("jspdf");
    const L = current();
    const doc = new jsPDF({ unit: "pt", format: "letter" });
    const margin = 72;
    const width = doc.internal.pageSize.getWidth() - margin * 2;
    const pageH = doc.internal.pageSize.getHeight();
    let y = margin;
    doc.setFont("times", "normal");
    doc.setFontSize(11.5);
    const lh = 15;
    const write = (text: string, opts: { bold?: boolean; gap?: number; right?: boolean } = {}) => {
      doc.setFont("times", opts.bold ? "bold" : "normal");
      const rows = text === "" ? [""] : (doc.splitTextToSize(text, width) as string[]);
      for (const r of rows) {
        if (y > pageH - margin) {
          doc.addPage();
          y = margin;
        }
        if (opts.right) doc.text(r, margin + width, y, { align: "right" });
        else doc.text(r, margin, y);
        y += lh;
      }
      y += opts.gap ?? 0;
    };
    const firstBlank = L.heading.indexOf("");
    L.heading.forEach((h, i) => write(h, { right: i < firstBlank }));
    write("");
    write(`Re: ${L.subject}`, { bold: true, gap: lh });
    write(L.salutation, { gap: 6 });
    for (const p of L.paragraphs) write(p, { gap: 8 });
    for (const c of L.closing) write(c);
    // Neutral notice line at the foot of the last page.
    const note = $("print-note").textContent?.trim();
    if (note) {
      if (y > pageH - margin - 10) doc.addPage();
      doc.setFont("helvetica", "normal");
      doc.setFontSize(8);
      doc.setTextColor(110);
      const noteRows = doc.splitTextToSize(note, width) as string[];
      doc.text(noteRows, margin, pageH - 40 - (noteRows.length - 1) * 10);
      doc.setTextColor(0);
    }
    doc.save("demand-letter.pdf");
    status("PDF created. Check your downloads.");
  }

  async function copy(btn: HTMLButtonElement) {
    if (!ready()) return;
    try {
      await navigator.clipboard.writeText(current().text + "\n\n" + ($("print-note").textContent?.trim() ?? ""));
      const was = btn.textContent;
      btn.textContent = "Copied";
      status("Letter copied. Paste it into an email or a document.");
      window.setTimeout(() => (btn.textContent = was), 2000);
    } catch {
      status("Copying didn't work in this browser. Select the letter text and copy it instead.");
    }
  }

  function clearAll() {
    if (!window.confirm("Clear every answer? This can't be undone.")) return;
    form.reset();
    field("date").value = todayISO();
    picker.set("");
    touched.clear();
    $("error-summary").hidden = true;
    paintErrors(new Map());
    renderNotes();
    render();
    status("All answers cleared.");
    flow.goTo(1, "key");
  }

  // ---------------------------------------------------------------- Flow
  const flow = createFlow({
    root,
    total: TOTAL,
    countText: (at, total) => `Step ${at} of ${total}`,
    validate(k) {
      const ids = Object.keys(stepOf).filter((id) => stepOf[id] === k);
      if (!ids.length) return null;
      const errs = errors();
      ids.forEach((id) => errs.has(id) && touched.add(id));
      paintErrors(errs);
      return root.querySelector<HTMLElement>(`[data-q="${k}"] [aria-invalid="true"]`);
    },
  });

  // ---------------------------------------------------------------- Events
  const picker = initStatePicker(root.querySelector<HTMLElement>("[data-state-picker]")!, stateList, (slug) => {
    stateSlug = slug;
    renderNotes();
    render();
  });
  form.addEventListener("input", (e) => {
    const id = (e.target as HTMLElement).id;
    if (touched.has(id)) paintErrors(errors());
    render();
  });
  form.addEventListener("change", (e) => {
    if ((e.target as HTMLInputElement).name === "kind") renderNotes();
    render();
  });
  form.addEventListener(
    "blur",
    (e) => {
      const el = e.target as HTMLInputElement;
      if (!(el.id in hintIds)) return;
      // Tidy a typed amount: "1850" → "1,850.00".
      if (el.id === "amount") {
        const n = parseAmount(el.value);
        if (n != null && !Number.isNaN(n) && n > 0) el.value = n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
      if (el.value.trim() || touched.has(el.id)) touched.add(el.id);
      paintErrors(errors());
      render();
    },
    true,
  );
  document.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((b) =>
    b.addEventListener("click", () => {
      const a = b.dataset.action;
      if (a === "pdf") downloadPdf();
      else if (a === "print") ready() && window.print();
      else if (a === "copy") copy(b);
      else if (a === "clear") clearAll();
    }),
  );
  $("dock-go").addEventListener("click", (e) => {
    e.preventDefault();
    $("preview-title").scrollIntoView({ block: "start" });
    $("preview-title").focus({ preventScroll: true });
  });
  // Phones and tablets: the preview starts as a short window onto the letter, with a button to open it fully.
  const narrow = window.matchMedia("(max-width: 1080px)");
  const toggle = $<HTMLButtonElement>("paper-toggle");
  const wrap = $("paper-wrap");
  function setClip(open: boolean) {
    wrap.toggleAttribute("data-clip", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "Show less" : "Show the whole letter";
  }
  toggle.hidden = false;
  setClip(false);
  toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    setClip(open);
    if (!open) $("preview-title").scrollIntoView({ block: "start", behavior: "auto" });
  });
  // Opening the preview from the dock shows all of it.
  $("dock-go").addEventListener("click", () => narrow.matches && setClip(true));

  // Phone dock: hide while the preview is on screen.
  new IntersectionObserver(([e]) => $("dock").toggleAttribute("data-off", e.isIntersecting)).observe($("preview"));

  // Development only (screenshots): ?demo=1 fills sample answers; ?at=N opens step N.
  const params = new URLSearchParams(location.search);
  if (import.meta.env.DEV && params.get("demo")) {
    const set = (id: string, v: string) => (field(id).value = v);
    picker.set("ca");
    set("amount", "1,850.00");
    set("eventDate", "2026-09-30");
    set("detail", "1420 Alder Street, Unit 3, Oakland");
    set("facts", "I left the unit clean and undamaged, and I returned the keys on the day I moved out. More than 21 days have passed and I have not received my deposit or an itemized statement.");
    set("sName", "Alex Rivera");
    set("sAddr", "88 Linden Avenue, Apt 2\nOakland, CA 94610");
    set("sEmail", "alex@example.com");
    set("rName", "Harbor Point Rentals LLC");
    set("rAddr", "410 Grand Avenue, Suite 5\nOakland, CA 94610");
    set("pay", "check mailed to the address above");
    set("court", "small claims court in Alameda County");
  }
  renderNotes();
  render();
  readyLine(errors());
  if (import.meta.env.DEV && params.get("at")) flow.goTo(Number(params.get("at")));
</script>

<style>
  /* A tool page: a compact header, like the calculator's rail, so the first question is on the first screen. */
