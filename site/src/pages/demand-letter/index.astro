    padding-top: clamp(20px, 3vw, 40px);
    padding-bottom: 0;
  }
  .dl-hero :global(.breadcrumb) {
    margin-bottom: 16px;
  }
  .dl-hero .dl-title {
    font-size: clamp(32px, 3.4vw, 52px);
  }
  .dl-top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px 48px;
    align-items: start;
  }
  .dl-top h1 {
    margin: 0;
  }
  .dl-aside p {
    margin: 0;
    max-width: 44ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .dl-aside .cite {
    margin-top: 8px;
    font-size: 12px;
  }
  .dl-layout {
    padding-top: clamp(24px, 3vw, 40px);
  }
  .dl-prog {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding-bottom: 8px;
  }
  .dl-prog p {
    margin: 0;
  }
  .dl-flow :global(.fl-q:first-of-type) {
    padding-top: 28px;
  }
  .dl-gap {
    margin-top: 24px;
  }
  .dl-notes {
    margin-top: 16px;
  }
  .dl-send {
    margin-top: 18px;
  }
  .dl-send strong {
    font-weight: 500;
    color: var(--ink);
  }
  .dl-notes :global(.dl-note-cite) {
    margin: -6px 0 0 52px;
    padding-bottom: 14px;
  }
  .dl-notes .fl-note:empty {
    display: none;
  }
  #court-field[hidden] {
    display: none;
  }
  .dl-errors {
    margin: 0 0 24px;
  }
  .dl-errors:focus {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .dl-errors ul {
    margin: 8px 0 0;
    padding-left: 20px;
    list-style: disc;
  }
  .dl-errors a {
    color: var(--ink);
  }
  .dl-ready {
    margin: 0 0 12px;
    font-size: 17px;
    color: var(--ink-2);
  }
  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .dl-clear {
    margin-left: auto;
  }

  /* Preview */
  .dl-side {
    min-width: 0;
  }
  .dl-side-in {
    position: sticky;
    top: calc(var(--hdr-h) + 24px);
    display: grid;
    gap: 14px;
  }
  .dl-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .dl-bar :is(h2, p) {
    margin: 0;
  }
  .dl-bar h2:focus {
    outline: none;
  }
  .dl-ph-key {
    background: transparent;
    color: inherit;
  }
  .dl-paper {
    /* A letter, so a letter face. pre-wrap keeps the line breaks people type; long words and URLs wrap. */
    font-family: Georgia, "Times New Roman", serif;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    min-height: 30rem;
    border: 1px solid var(--paper-border);
    padding: 40px 40px 32px;
    max-height: calc(100dvh - var(--hdr-h) - 150px);
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: 13.5px;
    line-height: 1.6;
  }
  .dl-paper:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .dl-paper :global(p) {
    margin: 0;
  }
  .dl-paper > * + * {
    margin-top: 12px;
  }
  .lp-head {
    text-align: right;
    color: var(--paper-ink-2);
  }
  .lp-date {
    margin-top: 20px !important;
  }
  .lp-re {
    font-weight: 500;
    margin-top: 20px !important;
  }
  .lp-re-k {
    margin-right: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper-ink-2);
  }
  .lp-body {
    display: grid;
    gap: 12px;
  }
  .lp-close {
    margin-top: 16px !important;
  }
  .lp-sig {
    margin-top: 10px !important;
    font-family: var(--f-display);
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .lp-foot {
    margin-top: 24px !important;
    padding-top: 12px;
    border-top: 1px solid var(--paper-line);
    font-family: var(--f-mono);
    font-size: 10.5px;
    color: var(--paper-ink-2);
  }
  .dl-paper :global(mark.ph) {
    padding: 0 2px;
    border-radius: 2px;
    background: var(--paper-mark);
    color: var(--paper-ink);
    box-shadow: inset 0 -1px 0 var(--paper-mark-line);
  }
  .dl-side .cite {
    margin: 0;
  }
  .dl-side .cite:empty {
    display: none;
  }
  .dl-layout > :global(.fl-dock) {
    grid-column: 1 / -1;
  }
  .dl-expand {
    display: none;
  }

  @media (max-width: 1080px) {
    .dl-top {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .dl-side-in {
      position: static;
    }
    .dl-paper {
      max-height: none;
      overflow: visible;
    }
    /* The preview starts as a window onto the letter's opening; the button opens all of it. */
    .dl-paper-wrap[data-clip] .dl-paper {
      max-height: 24rem;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
      mask-image: linear-gradient(to bottom, #000 72%, transparent);
    }
    .dl-expand {
      display: inline-flex;
      justify-self: start;
    }
    /* Step 7 already has the same buttons just above the preview. */
    .dl-side-actions {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .dl-paper {
      padding: 22px 18px;
      min-height: 0;
      font-size: 13px;
    }
    .dl-aside p {
      font-size: 15.5px;
      line-height: 1.5;
    }
    /* Days: four across, the deadline under each number. */
    .fl .tiles.dl-days {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }
    .fl .dl-days :global(.tile) {
      padding: 10px 10px 11px;
    }
    .fl .dl-days :global(.tile .t-big) {
      font-size: 34px;
    }
    .fl .dl-days :global(.tile .t-sub) {
      font-size: 12.5px;
    }
    .dl-clear {
      margin-left: 0;
    }
    .dl-actions .btn {
      flex: 1 1 calc(50% - 4px);
    }
  }

  /* Print: only the letter. */
  @media print {
    .dl-layout {
      display: block;
      padding: 0;
    }
    .dl-side-in {
      position: static;
      display: block;
    }
    .dl-paper,
    .dl-paper-wrap[data-clip] .dl-paper {
      max-height: none;
      overflow: visible;
      padding: 0;
      font-size: 11.5pt;
      box-shadow: none;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .dl-paper :global(mark.ph) {
      background: none;
      box-shadow: none;
    }
    .lp-head {
      color: #000;
    }
  }
</style>
