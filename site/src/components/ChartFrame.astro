---
// Frame for every "what the data shows" chart: a takeaway title, an optional subtitle, the chart itself,
// the source + checked date (with an "unverified" tag when needed) and an expandable data table.
//
// <ChartFrame id="limits-map" title="Most states cap claims at $10,000 or less" sources={[{ label, url }]}
//             checked="2026-11-05" unverified={false}>
//   <Fragment slot="legend">…</Fragment>       optional, above the chart
//   …the chart (mark it aria-hidden="true" unless it contains links)…
//   <Fragment slot="note">…</Fragment>         optional notes, folded into a "Notes" accordion under the source
//   <Fragment slot="table">…<table>…</table></Fragment>   required: the same numbers as a table
// </ChartFrame>
import "../styles/features.css";

interface SourceLink {
  label: string;
  url: string;
}
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  sources: SourceLink[];
  checked: string;
  unverified?: boolean;
  unverifiedText?: string;
  headingLevel?: 2 | 3 | 4;
  tableLabel?: string;
  kicker?: string;
  class?: string;
}
const {
  id,
  title,
  subtitle,
  sources,
  checked,
  unverified = false,
  unverifiedText = "Includes figures not yet confirmed against the original source.",
  headingLevel = 3,
  tableLabel = "The numbers as a table",
  kicker,
  class: cls,
} = Astro.props;
const hasNote = Astro.slots.has("note");
const H = (`h${headingLevel}`) as "h2" | "h3" | "h4";
---
<figure class:list={["chart", cls]} id={id} aria-labelledby={`${id}-title`}>
  <figcaption class="chart-head">
    {kicker && <p class="lbl">{kicker}</p>}
    <H class="chart-title" id={`${id}-title`}>{title}</H>
    {subtitle && <p class="chart-sub">{subtitle}</p>}
  </figcaption>
  <slot name="legend" />
  <div class="chart-body">
    <slot />
  </div>
  <div class="chart-foot">
    {unverified && (
      <p class="chart-flag"><span class="badge unverified">unverified</span><span>{unverifiedText}</span></p>
    )}
    <p class="cite">
      <span>Source</span>
      {sources.map((s) => (
        <a href={s.url} rel={s.url.startsWith("http") ? "noopener" : undefined}>{s.label}</a>
      ))}
      <span>Checked {checked}</span>
    </p>
  </div>
  <div class="chart-more">
    {hasNote && (
      <details class="acc">
        <summary>Notes on these numbers</summary>
        <div class="acc-body"><slot name="note" /></div>
      </details>
    )}
    <details class="acc">
      <summary>{tableLabel}</summary>
      <div class="acc-body">
        <div class="table-scroll">
          <slot name="table" />
        </div>
      </div>
    </details>
  </div>
</figure>
