---
// "Display settings" dialog: Light / Dark / System. Opened by any element with
// [data-open-display-settings]. The choice is saved in localStorage ("fc-theme") and applied
// immediately; the inline script in Site.astro applies it before paint on the next page.
const options = [
  { value: "light", label: "Light", hint: "Dark text on a white page. The default." },
  { value: "dark", label: "Dark", hint: "Light text on a dim gray page." },
  { value: "system", label: "System", hint: "Follows your device's setting." },
];
---
<dialog class="modal" id="display-settings" aria-labelledby="display-settings-title">
  <div class="modal-header">
    <button class="btn ghost small" type="button" data-close>
      Close
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
  <div class="modal-body">
    <h2 class="modal-title" id="display-settings-title">Display settings</h2>
    <p>Choose how Fair Claim looks on this device.</p>
    <fieldset>
      <legend class="sr-only">Theme</legend>
      <div class="choice-cards">
        {options.map((o) => (
          <label class="choice-card">
            <input type="radio" name="fc-theme" value={o.value} />
            <span class="choice-text">
              {o.label}
              <span class="hint">{o.hint}</span>
            </span>
            <svg class="choice-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              {o.value === "light" && (
                <>
                  <circle cx="20" cy="20" r="6" />
                  <path d="M20 6v4M20 30v4M6 20h4M30 20h4M10.1 10.1l2.8 2.8M27.1 27.1l2.8 2.8M10.1 29.9l2.8-2.8M27.1 12.9l2.8-2.8" stroke-linecap="round" />
                </>
              )}
              {o.value === "dark" && <path d="M27 25.5A10 10 0 0 1 16.5 9a10 10 0 1 0 10.5 16.5z" stroke-linejoin="round" />}
              {o.value === "system" && (
                <>
                  <rect x="7" y="9" width="26" height="17" rx="2" />
                  <path d="M15 31h10M20 26v5" stroke-linecap="round" />
                  <path d="M20 13a4.5 4.5 0 0 1 0 9z" fill="currentColor" stroke="none" />
                  <circle cx="20" cy="17.5" r="4.5" />
                </>
              )}
            </svg>
          </label>
        ))}
      </div>
    </fieldset>
    <p class="hint">Saved on this device only. Nothing is sent to us.</p>
  </div>
</dialog>

<script>
  const KEY = "fc-theme";
  const root = document.documentElement;
  const dialog = document.getElementById("display-settings") as HTMLDialogElement | null;
  const media = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  let opener: HTMLElement | null = null;

  function getPref(): string {
    return root.getAttribute("data-theme-pref") || "light";
  }
  function apply(pref: string) {
    const dark = pref === "dark" || (pref === "system" && !!media?.matches);
    // Switch themes in one step: pause hover/fade transitions so nothing fades at its own speed.
    root.classList.add("theme-switching");
    root.setAttribute("data-theme", dark ? "dark" : "light");
    root.setAttribute("data-theme-pref", pref);
    void root.offsetHeight;
    setTimeout(() => root.classList.remove("theme-switching"), 0);
  }
  function save(pref: string) {
    try {
      localStorage.setItem(KEY, pref);
    } catch {
      /* storage blocked: the choice still applies for this page view */
    }
  }

  if (dialog) {
    const radios = Array.from(dialog.querySelectorAll<HTMLInputElement>('input[name="fc-theme"]'));
    const sync = () => radios.forEach((r) => (r.checked = r.value === getPref()));

    document.querySelectorAll<HTMLElement>("[data-open-display-settings]").forEach((btn) =>
      btn.addEventListener("click", () => {
        opener = btn;
        sync();
        dialog.showModal();
        (radios.find((r) => r.checked) ?? radios[0])?.focus();
      }),
    );
    radios.forEach((r) =>
      r.addEventListener("change", () => {
        apply(r.value);
        save(r.value);
      }),
    );
    dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
    // Click on the backdrop closes it (settings apply instantly, so closing never loses anything).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => opener?.focus());
  }

  media?.addEventListener("change", () => {
    if (getPref() === "system") apply("system");
  });
</script>
