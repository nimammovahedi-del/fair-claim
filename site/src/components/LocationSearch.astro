---
// <LocationSearch />: slim "ZIP, city, county or state" search (checkcongress-style). One clear match goes straight
// to the page (state page, or the county page in California); several matches show a short pick list.
// Matching runs in the browser (LocationSearch.ts) on static Census files in /geo/; nothing typed is sent anywhere.
// Without JavaScript the form submits to the target's index page, which lists every state.
//
// Props (stable API — pages may rely on these):
//   label?: string          visible label above the box (default "Find your state or county")
//   compact?: boolean       tighter version for use inside cards/heroes
//   showStateLink?: bool    show the "Or pick your state" link under the box (default true)
//   target?: "states" | "checklists"   where matches go (default "states": /states/{st}/ or the CA county page;
//                           "checklists": /checklists/{st}/)
//   stateHref?: string      where "Or pick your state" points (default per target)
//   placeholder?: string
import { states, counties } from "../lib/data";

interface Props {
  label?: string;
  compact?: boolean;
  showStateLink?: boolean;
  target?: "states" | "checklists";
  stateHref?: string;
  placeholder?: string;
}
const {
  label = "Find your state or county",
  compact = false,
  showStateLink = true,
  target = "states",
  placeholder = "ZIP, city, county or state",
} = Astro.props;
const stateHref = Astro.props.stateHref ?? (target === "checklists" ? "/checklists/#all-checklists" : "/states/#all-states");
const action = target === "checklists" ? "/checklists/" : "/states/";
const names = JSON.stringify({
  s: states.map((s) => [s.slug, s.state, s.abbr]),
  c: Object.fromEntries(counties.map((c) => [c.slug, c.county])),
});
const uid = `loc-${Math.random().toString(36).slice(2, 8)}`;
---
<form
  class:list={["loc", { compact }]}
  action={action}
  method="get"
  role="search"
  data-loc
  data-target={target}
  data-state-href={stateHref}
  data-names={names}
>
  <label class="loc-label" for={uid}>{label}</label>
  <div class="loc-field">
    <div class="loc-bar">
      <input
        id={uid}
        name="q"
        type="search"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls={`${uid}-list`}
        aria-describedby={`${uid}-hint`}
        autocomplete="off"
        autocapitalize="words"
        spellcheck="false"
        enterkeyhint="search"
        placeholder={placeholder}
      />
      <button type="submit">Find</button>
    </div>
    <div class="loc-pop" data-pop hidden>
      <p class="loc-msg" data-msg hidden></p>
      <ul class="loc-list" id={`${uid}-list`} role="listbox" aria-label="Matching places" hidden></ul>
    </div>
  </div>
  <p class="sr-only" id={`${uid}-hint`}>Type a ZIP code, city, county or state. Suggestions appear below. What you type stays on this page.</p>
  <p class="sr-only" aria-live="polite" data-live></p>
  {showStateLink && <a class="loc-alt" href={stateHref}>Or pick your state</a>}
</form>

<script>
  import { initLocationSearch } from "./LocationSearch";
  document.querySelectorAll<HTMLFormElement>("form[data-loc]").forEach(initLocationSearch);
</script>

<style>
  .loc {
    --loc-h: 60px;
    position: relative;
    display: grid;
    gap: 10px;
    width: 100%;
    max-width: 40rem;
  }
  .loc.compact {
    --loc-h: 52px;
    gap: 8px;
  }
  .loc-label {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .loc-field {
    position: relative;
  }
  .loc-bar {
    display: flex;
    align-items: stretch;
    gap: 6px;
    min-height: var(--loc-h);
    padding: 5px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: var(--bg-2);
    transition: border-color var(--t-fast) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .loc-bar:hover {
      border-color: var(--ink-2);
    }
  }
  .loc-bar:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-color: var(--ink-2);
  }
  .loc .loc-bar input {
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    min-height: 44px;
    padding: 0 8px 0 18px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    font-size: 18px;
    color: var(--ink);
    outline: none;
  }
  .loc.compact .loc-bar input {
    padding-left: 14px;
    font-size: 17px;
  }
  .loc-bar input::-webkit-search-decoration,
  .loc-bar input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }
  .loc-bar button {
    flex: none;
    min-width: 44px;
    min-height: 44px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--sel-bg);
    color: var(--sel-ink);
    font-weight: 500;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    transition: transform var(--t-press) var(--ease);
  }
  .loc-bar button:active {
    transform: scale(0.97);
  }
  .loc-bar button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .loc-pop {
    position: absolute;
    z-index: 30;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--bg-2);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.14);
  }
  .loc-msg {
    margin: 0;
    padding: 12px 18px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .loc-msg:not(:last-child) {
    border-bottom: 1px solid var(--line);
  }
  .loc-msg :global(a) {
    color: var(--ink);
  }
  .loc-msg :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }
  .loc-list {
    max-height: min(22rem, 55vh);
    margin: 0;
    padding: 4px 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .loc-list :global([role="option"]) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
    min-height: 44px;
    padding: 10px 18px;
    cursor: pointer;
    touch-action: manipulation;
  }
  .loc-list :global([aria-selected="true"]) {
    background: var(--panel-2);
    box-shadow: inset 3px 0 0 var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .loc-list :global([role="option"]:hover) {
      background: var(--panel);
    }
    .loc-list :global([aria-selected="true"]:hover) {
      background: var(--panel-2);
    }
  }
  .loc-list :global(.loc-name) {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .loc-list :global(.loc-sub) {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  .loc-alt {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -6px;
    font-size: 15px;
    color: var(--ink-2);
    touch-action: manipulation;
  }
  @media (max-width: 480px) {
    .loc-bar button {
      padding: 0 18px;
    }
  }
</style>
