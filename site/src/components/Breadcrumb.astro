---
// Breadcrumb trail. The last item is the current page (no link).
// <Breadcrumb items={[{ href: "/states/", label: "States" }, { label: "California" }]} />
// "Home" is added automatically.
interface Item {
  href?: string;
  label: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const all: Item[] = [{ href: "/", label: "Home" }, ...items];
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {all.map((it, i) =>
      i === all.length - 1 || !it.href ? (
        <li aria-current={i === all.length - 1 ? "page" : undefined}>{it.label}</li>
      ) : (
        <li><a href={it.href}>{it.label}</a></li>
      ),
    )}
  </ol>
</nav>
