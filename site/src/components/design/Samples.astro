---
// Component samples for the /design/ gallery. Rendered once per theme panel; `k` keeps ids unique.
import Breadcrumb from "../Breadcrumb.astro";
interface Props {
  k: string;
}
const { k } = Astro.props;
---
<div class="ds-samples">
  <h3 class="ds-h">Buttons</h3>
  <div class="btn-group">
    <button class="btn" type="button">Primary</button>
    <button class="btn secondary" type="button">Secondary</button>
    <button class="btn tertiary" type="button">Tertiary</button>
    <button class="btn ghost" type="button">Ghost</button>
  </div>
  <div class="btn-group">
    <button class="btn small" type="button">Small</button>
    <button class="btn secondary small" type="button">Small secondary</button>
    <button class="btn" type="button" disabled>Disabled</button>
    <a class="link-arrow" href="#">Link with arrow</a>
  </div>

  <h3 class="ds-h">Breadcrumb</h3>
  <Breadcrumb items={[{ href: "#", label: "States" }, { href: "#", label: "California" }, { label: "Alameda" }]} />

  <h3 class="ds-h">Tags, badges and citations</h3>
  <ul class="tags">
    <li><span class="tag">Tenants</span></li>
    <li><a class="tag" href="#">Security deposits</a></li>
    <li><button class="tag" type="button" aria-pressed="true">Selected filter</button></li>
    <li><span class="tag small">Small tag</span></li>
  </ul>
  <p class="cluster">
    <span class="badge">Neutral</span>
    <span class="badge info">Info</span>
    <span class="badge verified">Verified</span>
    <span class="badge unverified">Unverified</span>
    <span class="badge error">Error</span>
    <span class="badge new">New</span>
  </p>
  <p>
    California limit for individuals: <strong>$12,500</strong><br />
    <span class="cite"><span class="badge unverified">unverified</span><a href="#">courts.ca.gov</a><span>CCP § 116.221</span><span>checked 2026-11-05</span></span>
  </p>

  <h3 class="ds-h">Cards</h3>
  <div class="grid cols-2 ds-cards">
    <a class="card card-link" href="#">
      <h3>Is it worth it?</h3>
      <p>Costs, time and the chance of getting paid, side by side.</p>
      <span class="go">Open the calculator</span>
    </a>
    <div class="card card-link">
      <p class="card-detail">California</p>
      <h3><a href="#">County by county</a></h3>
      <p>The title link stretches over the whole card.</p>
    </div>
    <div class="card">
      <h3>Plain card</h3>
      <p>White with a hairline border. For grouped facts.</p>
    </div>
    <div class="card tinted">
      <h3>Tinted card</h3>
      <p>Gray surface, no border. For asides.</p>
    </div>
  </div>

  <h3 class="ds-h">Callouts and highlight</h3>
  <div class="callout">
    <p class="callout-title">Default callout</p>
    <p>Neutral context with an accent bar.</p>
  </div>
  <div class="callout info"><p><strong>Recent change:</strong> the fee rose on November 1.</p></div>
  <div class="callout success"><p>Your letter is ready to print.</p></div>
  <div class="callout warning"><p>Your claim is over this state's limit.</p></div>
  <div class="callout error"><p>Enter a date in the past.</p></div>
  <div class="highlight"><p>Winning a judgment and getting paid are two different things.</p></div>

  <h3 class="ds-h">Accordion</h3>
  <div class="accordions">
    <details class="accordion" open>
      <summary>What is a statute of limitations?</summary>
      <div class="accordion-body"><p>The deadline to file a claim. It depends on the kind of claim and the state.</p></div>
    </details>
    <details class="accordion">
      <summary>Can I bring a lawyer?</summary>
      <div class="accordion-body"><p>It depends on the state. Each state page says.</p></div>
    </details>
  </div>

  <h3 class="ds-h">Form fields</h3>
  <div class="form-grid">
    <div class="field">
      <label for={`ds-amount-${k}`}>Amount you're owed ($) <span class="hint">Whole dollars are fine.</span></label>
      <input id={`ds-amount-${k}`} type="number" value="2400" />
    </div>
    <div class="field">
      <label for={`ds-state-${k}`}>State</label>
      <select id={`ds-state-${k}`}><option>California</option><option>Oregon</option></select>
    </div>
    <div class="field has-error full">
      <label for={`ds-date-${k}`}>Date it happened</label>
      <input id={`ds-date-${k}`} type="text" value="next Tuesday" aria-invalid="true" aria-describedby={`ds-date-err-${k}`} />
      <p class="error-text" id={`ds-date-err-${k}`}>Enter a date like 2026-03-14.</p>
    </div>
    <div class="field full">
      <label class="choice"><input type="checkbox" checked /> Mention the state deposit law</label>
      <label class="choice"><input type="radio" name={`ds-r-${k}`} checked /> An individual</label>
      <label class="choice"><input type="radio" name={`ds-r-${k}`} /> A business</label>
    </div>
    <div class="field full">
      <div class="range-row"><label for={`ds-range-${k}`}>Chance you collect</label><output>45%</output></div>
      <input id={`ds-range-${k}`} type="range" value="45" />
    </div>
  </div>

  <h3 class="ds-h">Table (stacks under 768px)</h3>
  <div class="table-scroll">
    <table class="table-stack">
      <thead><tr><th>State</th><th class="num">Limit</th><th>Filing fee</th><th>Checked</th></tr></thead>
      <tbody>
        <tr><td><a href="#">California</a></td><td class="num" data-label="Limit">$12,500</td><td data-label="Filing fee">$30–$75</td><td class="mono" data-label="Checked">2026-11-05</td></tr>
        <tr><td><a href="#">Oregon</a></td><td class="num" data-label="Limit">$10,000</td><td data-label="Filing fee">$55–$95 <span class="badge unverified">?</span></td><td class="mono" data-label="Checked">2026-11-05</td></tr>
      </tbody>
    </table>
  </div>

  <h3 class="ds-h">Notice card (static preview)</h3>
  <div class="ds-modal-sample">
    <div class="modal-header"></div>
    <div class="modal-body">
      <p class="modal-title h2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.01" stroke-width="2.2" /></svg>
        Before you start
      </p>
      <p>Please read this before you use the calculator.</p>
      <ul class="notice-list">
        <li>This is general legal information, not legal advice.</li>
        <li>Nothing you type is stored or sent anywhere.</li>
      </ul>
      <p><a href="#">Read more about what Fair Claim can and can't do</a></p>
    </div>
    <div class="modal-footer">
      <button class="btn tertiary" type="button">Not now</button>
      <button class="btn" type="button">I understand</button>
    </div>
  </div>
  <div class="tool-gate" style="margin-top:var(--space-3)">
    <p><strong>This tool is paused.</strong> Please read a short notice before you use it.</p>
    <button class="btn small" type="button">Read the notice</button>
  </div>
</div>
