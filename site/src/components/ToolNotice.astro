---
// "Please read" notice for an interactive tool. Shown once per tool, remembered on this device.
//
// <ToolNotice id="worth-it" target="worth-it-tool" toolName="the calculator" />
// <div id="worth-it-tool">…the tool…</div>
//
// - mode="onload" (default): the notice opens as a modal dialog when the page loads.
// - mode="ondemand": the tool shows a "Read the notice" bar; the dialog opens when the reader asks.
//   Use this when the tool is a small part of a longer page (e.g. the California deadline estimator).
// Until "I understand" is pressed, the tool is `inert` (can't be focused or used) and dimmed.
// Escape or "Not now" closes the dialog WITHOUT accepting: the tool stays paused with a bar to reopen it.
// Acceptance is stored in localStorage as "fc-notice-v1:<id>". If storage is blocked, the notice shows each visit.
// After "I understand", focus goes to the first [data-notice-focus] inside the tool, else its first control.
// The bar and the "i" mark take the page's color slot (--t), sage by default.
// Development only: ?notice=off skips the notice for one view (screenshots). Never in a production build.
interface Props {
  id: string;
  target: string;
  toolName: string;
  title?: string;
  intro?: string;
  points?: string[];
  extraPoints?: string[];
  mode?: "onload" | "ondemand";
  readMoreHref?: string;
  readMoreLabel?: string;
  /** Small mono line above the title. */
  kicker?: string;
}
const {
  id,
  target,
  toolName,
  title = "Before you start",
  intro = `Please read this before you use ${toolName}.`,
  points = [
    "This is legal information, not legal advice. It can't tell you what to do in your case.",
    "Nothing you type is stored or sent. It's gone when you close the tab.",
    "Numbers are estimates from the sources we cite. Laws and fees change.",
    "Before you act, check with the court, a free small claims advisor, or legal aid.",
  ],
  extraPoints = [],
  mode = "onload",
  readMoreHref = "/about/#not-advice",
  readMoreLabel = "Read more about what Fair Claim can and can't do",
  kicker = "Please read · 30 seconds",
} = Astro.props;
const titleId = `notice-${id}-title`;
const descId = `notice-${id}-desc`;
---
<div class="tool-gate tn-gate no-print" data-tool-gate={id} hidden>
  <p><span class="tn-dot" aria-hidden="true"></span><span class="lbl lbl-ink">Paused</span><span>Read a short notice before you use {toolName}.</span></p>
  <button class="btn sm" type="button" data-notice-open aria-haspopup="dialog">Read the notice</button>
</div>

<dialog class="modal tool-notice" data-tool-notice={id} data-target={target} data-mode={mode} aria-labelledby={titleId} aria-describedby={descId}>
  <div class="modal-body">
    <span class="n-icon" aria-hidden="true">i</span>
    <p class="lbl tn-kicker">{kicker}</p>
    <h2 class="modal-title" id={titleId} tabindex="-1">{title}</h2>
    <p class="modal-intro" id={descId}>{intro}</p>
    <ol class="n-list">
      {[...points, ...extraPoints].map((p) => <li>{p}</li>)}
    </ol>
    <p class="modal-more"><a href={readMoreHref} target="_blank" rel="noopener">{readMoreLabel}<span class="sr-only"> (opens in a new tab)</span></a></p>
  </div>
  <div class="modal-footer">
    <button class="btn ghost" type="button" data-notice-later>Not now</button>
    <button class="btn" type="button" data-notice-accept>I understand</button>
  </div>
</dialog>

<script>
  const PREFIX = "fc-notice-v1:";

  document.querySelectorAll<HTMLDialogElement>("dialog[data-tool-notice]").forEach((dialog) => {
    const id = dialog.dataset.toolNotice!;
    const target = document.getElementById(dialog.dataset.target || "");
    const gate = document.querySelector<HTMLElement>(`[data-tool-gate="${id}"]`);
    const title = dialog.querySelector<HTMLElement>(".modal-title");
    const gateBtn = gate?.querySelector<HTMLButtonElement>("[data-notice-open]");
    if (!target) return;

    let accepted = false;
    try {
      accepted = localStorage.getItem(PREFIX + id) !== null;
    } catch {
      /* storage blocked: show the notice every visit */
    }
    if (import.meta.env.DEV && new URLSearchParams(location.search).get("notice") === "off") accepted = true;
    if (accepted) return;

    // Lock the tool until the reader accepts.
    target.setAttribute("data-tool-target", "");
    target.inert = true;
    target.classList.add("tool-locked");
    if (gate) gate.hidden = false;

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      title?.focus();
    };
    const unlock = () => {
      accepted = true;
      try {
        localStorage.setItem(PREFIX + id, new Date().toISOString().slice(0, 10));
      } catch {
        /* ignore */
      }
      target.inert = false;
      target.classList.remove("tool-locked");
      if (gate) gate.hidden = true;
      dialog.close();
      const first =
        target.querySelector<HTMLElement>("[data-notice-focus]") ??
        target.querySelector<HTMLElement>("input, select, textarea, button, a[href]");
      first?.focus();
    };

    gateBtn?.addEventListener("click", open);
    dialog.querySelector("[data-notice-accept]")?.addEventListener("click", unlock);
    dialog.querySelector("[data-notice-later]")?.addEventListener("click", () => dialog.close());
    // Escape fires "cancel" then "close": it never counts as accepting.
    dialog.addEventListener("close", () => {
      if (!accepted) gateBtn?.focus();
    });

    if (dialog.dataset.mode !== "ondemand") open();
  });
</script>


<style>
  /* Option A notice card in a dialog: bar + "i" mark in the page's color, mono kicker, numbered points. */
  dialog.tool-notice {
    border-left-color: var(--t, var(--c-sage));
  }
  .tool-notice .n-icon {
    background: var(--t, var(--c-sage));
    color: var(--on, var(--on-sage));
    box-shadow: var(--edge, none);
  }
  .tool-notice .tn-kicker {
    margin: 0 0 6px;
  }
  .tool-notice .n-icon {
    grid-row: span 5;
  }
  .tool-notice .modal-more a {
    color: var(--ink);
  }
  .tool-notice .modal-footer .btn {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .tool-notice .modal-footer .btn:active {
    transform: scale(0.97);
  }
  @media (max-width: 560px) {
    .tool-notice .n-icon {
      grid-row: auto;
    }
  }
  .tn-gate p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
  }
  .tn-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--t, var(--c-sage));
    box-shadow: var(--edge, none);
  }
</style>
