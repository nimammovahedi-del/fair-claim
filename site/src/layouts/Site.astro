---
// Fair Claim · site layout (Option A design system, 2026-11-06).
// Props:
//   title        Page title ("Fair Claim" alone on the home page).
//   description  Meta description.
//   bleed        true = the page manages its own full-width sections and .wrap containers.
//                false (default) = the page body is wrapped in <div class="wrap page">.
//   color        Optional color slot for the page (e.g. "c-states"); sets --t on <body> so dots, the
//                current-nav marker and progress segments pick up the section's hue.
import "../styles/global.css";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { statesChecked } from "../lib/stats";

interface Props {
  title: string;
  description?: string;
  bleed?: boolean;
  color?: string;
}
const {
  title,
  description = "Free, neutral information about small claims court: cited, dated rules for every state, the costs, and what happens after a judgment. Legal information, not legal advice.",
  bleed = false,
  color,
} = Astro.props;
const path = Astro.url.pathname;

// Main navigation. "Tools" covers the hub and the three tools.
const nav = [
  { href: "/steps/", label: "How it works", match: ["/steps/"], c: "c-learn" },
  { href: "/states/", label: "State rules", match: ["/states/"], c: "c-states" },
  { href: "/tools/", label: "Tools", match: ["/tools/", "/worth-it/", "/demand-letter/", "/checklists/"], c: "c-tools" },
  { href: "/glossary/", label: "Glossary", match: ["/glossary/"], c: "c-glossary" },
  { href: "/about/", label: "About", match: ["/about/"], c: "c-about" },
];
// Launch switch: PUBLIC_INDEXABLE=true opens the site to search engines and drops the preview line.
const indexable = import.meta.env.PUBLIC_INDEXABLE === "true";
const canonical = new URL(path, Astro.site).href;
const fullTitle = title === "Fair Claim" ? title : `${title} · Fair Claim`;
const isCurrent = (m: string[]) => m.some((p) => path.startsWith(p));
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fair Claim: Small claims, explained. A balance-scale logo with two equal tiles." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fair Claim" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <!-- Browser chrome color = the page background. The script below (and ThemeSwitch) pins both to the chosen theme. -->
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Before first paint: pick the theme. Order: ?theme= (this view only) > saved choice > device (Auto).
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        d.classList.add("js");
        var pref = "auto";
        try {
          var saved = localStorage.getItem("fc-theme");
          if (saved === "system") saved = "auto"; // value used by the old Display settings dialog
          if (saved === "light" || saved === "dark" || saved === "auto") pref = saved;
        } catch (e) {}
        try {
          var q = new URLSearchParams(location.search).get("theme");
          if (q === "light" || q === "dark" || q === "auto") pref = q;
        } catch (e) {}
        var dark = pref === "dark" || (pref === "auto" && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
        d.setAttribute("data-theme", dark ? "dark" : "light");
        d.setAttribute("data-theme-pref", pref);
        var tc = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < tc.length; i++) tc[i].setAttribute("content", dark ? "#0b0b0c" : "#f3f2ee");
      })();
    </script>
  </head>
  <body class={color}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="proto-line no-print">
      <div class="wrap">
        <p>{indexable ? "Free and neutral" : "Early preview · rules checked November 2026"}</p>
        <p class="pl-extra">Legal information, not legal advice</p>
      </div>
    </div>

    <header class="hdr">
      <div class="wrap hdr-in">
        <a class="brand" href="/" aria-label="Fair Claim, home">
          <!-- Logo: "Balance": a scale with two equal tiles (cobalt, tomato); beam and base follow the text color. -->
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
            <rect x="30" y="8" width="4" height="44" rx="2" fill="currentColor" />
            <rect x="8" y="14" width="48" height="4" rx="2" fill="currentColor" />
            <rect x="6" y="26" width="20" height="20" rx="4" fill="var(--c-cobalt)" />
            <rect x="38" y="26" width="20" height="20" rx="4" fill="var(--c-tomato)" />
            <rect x="20" y="52" width="24" height="5" rx="2.5" fill="currentColor" />
          </svg>
          <span>Fair Claim</span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
          <span>Menu</span><span class="menu-icon" aria-hidden="true"></span>
        </button>
        <div class="hdr-menu" id="site-menu" data-menu>
          <nav class="nav" aria-label="Main">
            <ul>
              {nav.map((n) => (
                <li class={n.c}>
                  <a href={n.href} aria-current={isCurrent(n.match) ? "page" : undefined}>{n.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <ThemeSwitch />
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      {bleed ? <slot /> : <div class="wrap page"><slot /></div>}
    </main>

    <footer class="ftr">
      <div class="wrap">
        <div class="ftr-grid">
          <div class="ftr-about">
            <p class="ftr-lead">Free, neutral information about small claims court in all 50 states and DC.</p>
            <p class="ftr-small">
              <strong>Legal information, not legal advice.</strong> If the court tells you something different, the
              court is right.
            </p>
            <p class="ftr-small">No ads, no accounts, no tracking. Nothing you type is stored or sent.</p>
          </div>
          <div>
            <p class="lbl">Learn</p>
            <ul class="ftr-links">
              <li><a href="/steps/">How it works</a></li>
              <li><a href="/states/">State rules</a></li>
              <li><a href="/glossary/">Glossary</a></li>
            </ul>
          </div>
          <div>
            <p class="lbl">Tools</p>
            <ul class="ftr-links">
              <li><a href="/worth-it/">Cost calculator</a></li>
              <li><a href="/demand-letter/">Demand letter</a></li>
              <li><a href="/checklists/">Checklists</a></li>
            </ul>
          </div>
          <div>
            <p class="lbl">Project</p>
            <ul class="ftr-links">
              <li><a href="/about/">About</a></li>
              <li><a href="/sources/">How we check</a></li>
              <li><a href="/design/">Design system</a></li>
            </ul>
          </div>
        </div>
        <div class="ftr-base">
          <p class="lbl">Rules checked {statesChecked}</p>
          <p class="lbl">Independent · not a court, agency or law firm</p>
        </div>
        <p class="ftr-word" aria-hidden="true">Fair Claim</p>
      </div>
    </footer>

    <script>
      // Mobile menu (under 900px): a disclosure button that shows/hides the nav + theme switch.
      const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
      const menu = document.querySelector<HTMLElement>("[data-menu]");
      if (btn && menu) {
        const isOpen = () => btn.getAttribute("aria-expanded") === "true";
        const setOpen = (open: boolean, focusBtn = false) => {
          btn.setAttribute("aria-expanded", String(open));
          btn.querySelector("span")!.textContent = open ? "Close" : "Menu";
          menu.classList.toggle("is-open", open);
          if (focusBtn) btn.focus();
        };
        btn.addEventListener("click", () => setOpen(!isOpen()));
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) setOpen(false, true);
        });
        document.addEventListener("click", (e) => {
          if (isOpen() && !menu.contains(e.target as Node) && !btn.contains(e.target as Node)) setOpen(false);
        });
        // Back to desktop width: reset.
        window.matchMedia("(min-width: 901px)").addEventListener("change", (m) => m.matches && setOpen(false));
      }

      // Tabs: any [data-tabs] container with role="tablist" buttons (see global.css, section 12).
      document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((box) => {
        const tabs = Array.from(box.querySelectorAll<HTMLElement>('[role="tab"]'));
        const select = (tab: HTMLElement, focus = false) => {
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute("aria-selected", String(on));
            t.tabIndex = on ? 0 : -1;
            const panel = document.getElementById(t.getAttribute("aria-controls") || "");
            if (panel) panel.hidden = !on;
          });
          if (focus) tab.focus();
        };
        tabs.forEach((t, i) => {
          // A pointer tap fades the new panel in (--t-fast); arrow keys swap it instantly.
          t.addEventListener("click", (e) => {
            box.classList.toggle("tabs-fade", e.detail > 0);
            select(t);
          });
          t.addEventListener("keydown", (e) => {
            box.classList.remove("tabs-fade");
            const k = e.key;
            let n = -1;
            if (k === "ArrowRight" || k === "ArrowDown") n = (i + 1) % tabs.length;
            else if (k === "ArrowLeft" || k === "ArrowUp") n = (i - 1 + tabs.length) % tabs.length;
            else if (k === "Home") n = 0;
            else if (k === "End") n = tabs.length - 1;
            if (n >= 0) {
              e.preventDefault();
              select(tabs[n], true);
            }
          });
        });
        select(tabs.find((t) => t.getAttribute("aria-selected") === "true") ?? tabs[0]);
      });
    </script>
  </body>
</html>
