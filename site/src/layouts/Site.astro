---
import "../styles/global.css";
import DisplaySettings from "../components/DisplaySettings.astro";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Free, neutral information about small claims court: cited, dated rules for every state, the odds of getting paid, and a demand-letter tool. Legal information, not legal advice.",
} = Astro.props;
const path = Astro.url.pathname;

// Main navigation. An item is "current" when the page path starts with its href.
const nav = [
  { href: "/steps/", label: "How it works" },
  { href: "/worth-it/", label: "Cost calculator" },
  { href: "/demand-letter/", label: "Demand letter" },
  { href: "/states/", label: "States" },
  { href: "/checklists/", label: "Checklists" },
  { href: "/glossary/", label: "Glossary" },
  { href: "/about/", label: "About" },
  { href: "/sources/", label: "How we check" },
];
const isCurrent = (href: string) => path.startsWith(href);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Fair Claim" ? title : `${title} · Fair Claim`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply the saved theme before first paint (no flash). Light is the default.
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        var pref = "light";
        try {
          pref = localStorage.getItem("fc-theme") || "light";
        } catch (e) {}
        var dark =
          pref === "dark" ||
          (pref === "system" && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
        d.setAttribute("data-theme", dark ? "dark" : "light");
        d.setAttribute("data-theme-pref", pref);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="proto-banner no-print">
      <div class="wrap">
        Prototype for review, not published. Legal information, not legal advice. Facts marked
        <span class="badge unverified">Unverified</span> still need checking against the law or the court's own site.
      </div>
    </div>

    <header class="site-header">
      <div class="wrap header-top">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3.5V20M7.5 20h9M4.5 6.5h15" />
              <path d="M4.5 6.5 2 12.5M4.5 6.5 7 12.5M19.5 6.5 17 12.5M19.5 6.5 22 12.5" />
              <path d="M2 12.5a2.5 2.5 0 0 0 5 0zM17 12.5a2.5 2.5 0 0 0 5 0z" />
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">Fair Claim</span>
            <span class="brand-tagline">Small claims court, explained. Free and neutral.</span>
          </span>
        </a>
        <div class="header-tools">
          <button class="btn ghost small" type="button" data-open-display-settings aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="8" />
              <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none" />
            </svg>
            <span class="label-wide">Display</span><span class="sr-only"> settings</span>
          </button>
          <button class="btn tertiary small nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" id="nav-toggle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            Menu
          </button>
        </div>
      </div>
      <nav class="main-nav" id="main-nav" aria-label="Main">
        <div class="wrap">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-top">
        <div class="footer-about">
          <p class="footer-brand">Fair Claim</p>
          <p>
            <strong>Legal information, not legal advice.</strong> Court rules change, and every case is different.
            Each fact links to the law or the court's own website and shows when we last checked it. If something here
            doesn't match what your court tells you, the court is right.
          </p>
          <p>Free, no ads, no tracking. Nothing you type into our tools is stored or sent anywhere.</p>
        </div>
        <div>
          <p class="footer-heading">Guide</p>
          <ul class="footer-links">
            <li><a href="/steps/">How small claims works</a></li>
            <li><a href="/steps/#before-you-decide">Before you decide</a></li>
            <li><a href="/worth-it/">Cost calculator</a></li>
            <li><a href="/demand-letter/">Demand letter</a></li>
            <li><a href="/checklists/">Checklists</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-heading">Rules</p>
          <ul class="footer-links">
            <li><a href="/states/">All states</a></li>
            <li><a href="/states/ca/">California</a></li>
            <li><a href="/states/ca/counties/">California counties</a></li>
            <li><a href="/glossary/">Glossary</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-heading">About</p>
          <ul class="footer-links">
            <li><a href="/about/">About Fair Claim</a></li>
            <li><a href="/sources/">How we check</a></li>
            <li><button class="link-button" type="button" data-open-display-settings aria-haspopup="dialog">Display settings</button></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>Fair Claim is an independent project. It is not a court, a government agency or a law firm.</p>
        <p><a href="/design/">Design system</a></p>
      </div>
    </footer>

    <DisplaySettings />

    <script>
      // Mobile menu: a disclosure button that shows/hides the main nav under 62em.
      const toggle = document.getElementById("nav-toggle");
      const nav = document.getElementById("main-nav");
      if (toggle && nav) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("is-open", open);
        };
        toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
        nav.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setOpen(false);
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
